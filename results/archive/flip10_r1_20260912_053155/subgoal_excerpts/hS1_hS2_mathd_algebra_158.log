theorem hS₁_mathd_algebra_158 : (∑ k ∈ Finset.range 8, 2 * k + 1) = 64 := by
  -- rewrite the sum as the sum of two simpler sums
  have h₂sum :
      (∑ k in Finset.range 8, (2 * k : ℕ)) = 2 * (∑ k in Finset.range 8, k) := by
    simpa [mul_comm] using (Finset.mul_sum (2) (Finset.range 8) (fun k => k)).symm
  have h_one :
      (∑ _k in Finset.range 8, (1 : ℕ)) = 8 := by
    simpa using (Finset.card_range 8)
  calc
    (∑ k in Finset.range 8, 2 * k + 1)
        = (∑ k in Finset.range 8, (2 * k : ℕ)) + (∑ _k in Finset.range 8, (1 : ℕ)) := by
          simpa [Finset.sum_add_distrib] using
            (Finset.sum_add_distrib (fun k => (2 * k : ℕ)) (fun _ => (1 : ℕ)) (Finset.range 8))
    _ = 2 * (∑ k in Finset.range 8, k) + 8 := by
          simpa [h₂sum, h_one]
    _ = 2 * (8 * 7 / 2) + 8 := by
          simpa [Finset.sum_range_id]
    _ = 64 := by
          norm_num
