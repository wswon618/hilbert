    norm_num [Nat.ModEq]
    <;> rfl
  
  have h₃ : (∏ k ∈ Finset.range 6, 2 * k + 1) ≡ (1 * 3 * 5 * 7 * 9 * 1) [MOD 10] := by
    calc
      (∏ k ∈ Finset.range 6, 2 * k + 1) = 1 * 3 * 5 * 7 * 9 * 11 := by rw [h₁]
      _ ≡ (1 * 3 * 5 * 7 * 9 * 1 : ℕ) [MOD 10] := by apply h₂
      _ = (1 * 3 * 5 * 7 * 9 * 1 : ℕ) := by rfl
  
  exact h₃
