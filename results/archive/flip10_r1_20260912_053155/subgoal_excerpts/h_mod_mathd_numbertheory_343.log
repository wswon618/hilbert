  -- 11 is congruent to 1 modulo 10
  have h11 : (2 * 5 + 1) ≡ (1 : ℕ) [MOD 10] := by
    norm_num
  -- the product of the first five odd numbers
  have h5 : (∏ k ∈ Finset.range 5, 2 * k + 1) = (1 * 3 * 5 * 7 * 9) := by
    norm_num
  -- multiply the congruence by that product on the left
  have hmul :
      (∏ k ∈ Finset.range 5, 2 * k + 1) * (2 * 5 + 1) ≡
        (∏ k ∈ Finset.range 5, 2 * k + 1) * 1 [MOD 10] :=
    Nat.ModEq.mul_left _ h11
  -- rewrite the left‑hand side as the product over `range 6` and simplify
  simpa [Finset.prod_range_succ, h5] using hmul
