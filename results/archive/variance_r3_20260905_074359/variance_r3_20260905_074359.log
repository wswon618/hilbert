  have h_int :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 10000 :=
    h_cont.intervalIntegrable
  -- additivity of the integral over adjacent intervals
  simpa using
    (intervalIntegral.integral_add_adjacent (by norm_num) (by norm_num) h_int)
