            have h_sqrt_lt : Real.sqrt x < Real.sqrt (2) :=
              Real.sqrt_lt_sqrt_iff.mpr hxlt
            have hxpos : 0 < Real.sqrt x := h_pos_sqrt x hx
            have h2pos : 0 < Real.sqrt (2) := by norm_num [Real.sqrt_two_pos]
            exact (one_div_lt_one_div_of_lt hxpos h_sqrt_lt))] with x hx
