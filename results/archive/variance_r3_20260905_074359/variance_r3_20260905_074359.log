  have h_ae_le :
      (∀ᵐ x ∂(volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt (2) ≤ (1 : ℝ) / Real.sqrt x) := by
    apply Filter.eventually_of_forall
    intro x hx
    have hxle : x ≤ (2 : ℝ) := hx.2
    have h_sqrt_le : Real.sqrt x ≤ Real.sqrt (2) :=
