    (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180)) =
      Real.tan ((35 : ℝ) * Real.pi / 72) := by
  ------------------------------------------------------------
  -- 1.  Rewrite the angle `5·π/180` as `π/36`.
  ------------------------------------------------------------
  have hθ : (5 : ℝ) * Real.pi / 180 = Real.pi / 36 := by
    field_simp [Real.pi_ne_zero] ; norm_num
  ------------------------------------------------------------
  -- 2.  Replace each term `sin (5·k·π/180)` by `sin (k·π/36)`.
  ------------------------------------------------------------
  have hsum₁ :
      (∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin (5 * k * Real.pi / 180)) =
        ∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin (k * (Real.pi / 36)) := by
    refine Finset.sum_congr rfl ?_
    intro k hk
    have : (5 : ℝ) * (k : ℝ) * Real.pi / 180 = (k : ℝ) * (Real.pi / 36) := by
      calc
        5 * (k : ℝ) * Real.pi / 180 = (k : ℝ) * (5 * Real.pi / 180) := by ring
        _ = (k : ℝ) * (Real.pi / 36) := by simpa [hθ]
    simpa [this]
  ------------------------------------------------------------
  -- 3.  Use the classical formula for a finite sum of sines.
  --    For `θ ≠ 0` we have
  --      ∑_{k=1}^{n} sin (kθ) = sin (nθ/2)·sin ((n+1)θ/2) / sin (θ/2).
  ------------------------------------------------------------
  have hsum₂ :
      (∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin (k * (Real.pi / 36))) =
        Real.sin ((35 : ℝ) * Real.pi / 72) / Real.sin (Real.pi / 72) := by
    simpa [Finset.Icc_eq_range, Nat.succ_eq_add_one,
      Nat.cast_one, Nat.cast_ofNat, mul_comm, mul_left_comm, mul_assoc,
      add_comm, add_left_comm, add_assoc, sub_eq_add_neg] using
      Real.sum_Icc_mul_sin (m := 1) (n := 35) (θ := Real.pi / 36)
  ------------------------------------------------------------
  -- 4.  Relate `cos (35π/72)` to `sin (π/72)`.
  ------------------------------------------------------------
  have hcos :
      Real.cos ((35 : ℝ) * Real.pi / 72) = Real.sin (Real.pi / 72) := by
    have : Real.cos ((35 : ℝ) * Real.pi / 72) =
        Real.sin (Real.pi / 2 - (35 : ℝ) * Real.pi / 72) := by
      simpa [Real.cos_eq_sin_pi_div_two_sub] using rfl
    have : Real.pi / 2 - (35 : ℝ) * Real.pi / 72 = Real.pi / 72 := by
      field_simp [Real.pi_ne_zero] ; norm_num
    simpa [this] using this
  ------------------------------------------------------------
  -- 5.  Put everything together.
  ------------------------------------------------------------
  calc
    (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180))
        = ∑ k in Finset.Icc (1 : ℕ) 35,
            Real.sin (k * (Real.pi / 36)) := hsum₁
    _ = Real.sin ((35 : ℝ) * Real.pi / 72) / Real.sin (Real.pi / 72) := hsum₂
    _ = Real.sin ((35 : ℝ) * Real.pi / 72) / Real.cos ((35 : ℝ) * Real.pi / 72) := by
          simpa [hcos]
    _ = Real.tan ((35 : ℝ) * Real.pi / 72) := by
          simpa [Real.tan_eq_sin_div_cos]
