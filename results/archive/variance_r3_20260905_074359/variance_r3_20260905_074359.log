import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem hsum_eq_tan_aime_1999_p11 :
    (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180)) =
      Real.tan ((35 : ℝ) * Real.pi / 72) := by
  -- rewrite the angle `5·π/180` as `π/36`
  have hθ : (5 : ℝ) * Real.pi / 180 = Real.pi / 36 := by
    norm_num
  have hsum :
      (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180)) =
        (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (k * Real.pi / 36)) := by
    apply Finset.sum_congr rfl
    intro k hk
    simpa [hθ, mul_comm, mul_left_comm, mul_assoc] using rfl
  -- use the standard closed‑form for the sum of a sine progression
  have hformula :
      (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (k * Real.pi / 36)) =
        Real.tan ((35 : ℝ) * Real.pi / 72) := by
    simpa using Real.sum_Icc_mul_sin_eq_tan (n := 35) (θ := Real.pi / 36)
  simpa [hsum] using hformula
```


