    (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- a.e. inequality: the constant `1 / √2` is a lower bound of the integrand on `[1,2]`
  have h_ae :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Ioc (1 : ℝ) 2)),
          (1 : ℝ) / Real.sqrt (2) ≤ (1 : ℝ) / Real.sqrt x) := by
