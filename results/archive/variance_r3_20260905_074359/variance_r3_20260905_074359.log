  -- Restrict the antitone hypothesis to the interval `[2,10000]`.
  have h_antitone' :
      AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (2 : ℝ) 10000) :=
    h_antitone.mono (by
      intro x hx
      rcases hx with ⟨hx_left, hx_right⟩
      exact ⟨by linarith, hx_right⟩)
  -- Apply the integral comparison to the tail of the sum (from 3 to 10000).
