  have h_sqrt2_pos : 0 < Real.sqrt (2 : ℝ) := by
    have : (0 : ℝ) < (2 : ℝ) := by norm_num
    exact (Real.sqrt_pos.mpr this)
  have h_const_pos : 0 < (1 : ℝ) / Real.sqrt (2 : ℝ) := by
    exact div_pos zero_lt_one h_sqrt2_pos

  -- 2.  Pointwise inequality on [1,2] coming from antitoneness
  have h_pointwise :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt (2 : ℝ) ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hx1 : (1 : ℝ) ≤ x := hx.1
    have hx2 : x ≤ 2 := hx.2
    -- both x and 2 belong to the set on which the function is antitone
    have hx_mem : x ∈ Set.Icc (1 : ℝ) (10000 : ℝ) :=
      ⟨hx1, le_trans hx2 (by norm_num)⟩
    have h2_mem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) (10000 : ℝ) := by
      exact ⟨by norm_num, by norm_num⟩
    -- antitone gives the desired inequality
    have hle := h_antitone h2_mem hx_mem hx2
    simpa using hle

  -- 3.  From the pointwise inequality we get an inequality of integrals
  have h_int_ge_const :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    apply intervalIntegral.integral_le_integral_of_le
    intro x hx
    exact h_pointwise x hx

  -- 4.  Compute the integral of the constant function
  have h_const_int :
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ) = (2 - 1) * ((1 : ℝ) / Real.sqrt (2 : ℝ)) := by
    simpa using
      intervalIntegral.integral_const (a := (1 : ℝ)) (b := (2 : ℝ))
        ((1 : ℝ) / Real.sqrt (2 : ℝ))
  have h_const_int_simp : ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ) = (1 : ℝ) / Real.sqrt (2 : ℝ) := by
    simpa [sub_eq, sub_self] using h_const_int

  -- 5.  Lower bound for the wanted integral
  have h_lower :
      (1 : ℝ) / Real.sqrt (2 : ℝ) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    have := h_int_ge_const
    simpa [h_const_int_simp] using this

  -- 6.  Combine the lower bound with the positivity of the constant
  exact lt_of_lt_of_le h_const_pos h_lower
