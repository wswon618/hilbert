      <;> ring_nf at h12 ⊢ <;> nlinarith
    have h14 : Real.sin x = (22 : ℝ) / 7 * (308 / 533 : ℝ) - 1 := by linarith
    have h15 : Real.sin x = (435 : ℝ) / 533 := by
