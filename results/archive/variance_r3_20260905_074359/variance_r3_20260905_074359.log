    simpa using
      (AntitoneOn.sum_le_integral
        (f := fun x : ℝ => (1 : ℝ) / Real.sqrt x)
        (a := (2 : ℝ)) (b := (10000 : ℝ)) h_antitone')
  -- Add the first term of the original sum to both sides and rewrite.
  have h_final :
      (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
        (1 : ℝ) / Real.sqrt (2) + ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
    simpa [Finset.sum_Icc_succ_top] using
      (add_le_add_left h_tail ((1 : ℝ) / Real.sqrt (2)))
  exact h_final
