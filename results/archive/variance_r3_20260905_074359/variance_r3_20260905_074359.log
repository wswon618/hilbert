theorem h_int_gt_f2_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000))
    (h_integral_eq :
        (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = (198 : ℝ))
    (h_le :
        (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
          ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x)
    (h_pos :
        (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) := by
  ----------------------------------------------------------------------
  -- 1.  The sum over `k = 2,…,10000` is at least the first summand.
  ----------------------------------------------------------------------
  have h_nonneg :
      ∀ k ∈ Finset.Icc (2 : ℕ) 10000, (0 : ℝ) ≤ (1 : ℝ) / Real.sqrt k := by
    intro k hk
    exact div_nonneg (by norm_num) (Real.sqrt_nonneg _)

  have h_mem₂ : (2 : ℕ) ∈ Finset.Icc (2 : ℕ) 10000 :=
    Finset.mem_Icc.2 ⟨by norm_num, by norm_num⟩

  have h_sum_ge_f₂ :
      (1 : ℝ) / Real.sqrt (2) ≤
        ∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k :=
    (Finset.single_le_sum h_mem₂ h_nonneg)

  ----------------------------------------------------------------------
  -- 2.  The sum is *strictly* larger than the first term, because the
  --     term for `k = 3` is positive.
  ----------------------------------------------------------------------
  have h_term₃_pos : (0 : ℝ) < (1 : ℝ) / Real.sqrt (3) := by
    have h₃ : (0 : ℝ) < Real.sqrt (3) :=
      Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < (3 : ℝ))
    exact div_pos (by norm_num) h₃

  have h_sum_gt_f₂ :
      (1 : ℝ) / Real.sqrt (2) <
        ∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k := by
    -- rewrite the sum as `f 2 + ∑_{k=3}^{10000} f k`
    have h_eq :
        ∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k =
          (1 : ℝ) / Real.sqrt (2) +
            ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k := by
      simpa using
        (Finset.sum_Icc_succ_top (by decide : (2 : ℕ) ≤ 10000)
          (fun k : ℕ => (1 : ℝ) / Real.sqrt k))
    -- the remaining sum is non‑negative and actually positive
    have h_rest_nonneg :
        0 ≤ ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k := by
      apply Finset.sum_nonneg
      intro k hk
      exact div_nonneg (by norm_num) (Real.sqrt_nonneg _)

    have h_rest_pos :
        0 < ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k := by
      have h₃mem : (3 : ℕ) ∈ Finset.Icc (3 : ℕ) 10000 :=
        Finset.mem_Icc.2 ⟨by norm_num, by norm_num⟩
      have h₃le :
          (1 : ℝ) / Real.sqrt (3) ≤
            ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k :=
        (Finset.single_le_sum h₃mem
          (by
            intro k hk
            exact div_nonneg (by norm_num) (Real.sqrt_nonneg _)))
      exact lt_of_lt_of_le h_term₃_pos h₃le

    have : (1 : ℝ) / Real.sqrt (2) <
          (1 : ℝ) / Real.sqrt (2) +
            ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k :=
      add_lt_add_left h_rest_pos _
    simpa [h_eq] using this

  ----------------------------------------------------------------------
  -- 3.  From the hypothesis `h_le` we obtain a strict lower bound for the
  --     whole integral `∫_{1}^{10000}`.
  ----------------------------------------------------------------------
  have h_int_gt_f₂ :
      (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) :=
    lt_of_lt_of_le h_sum_gt_f₂ h_le

  ----------------------------------------------------------------------
  -- 4.  Split the integral `∫_{1}^{10000}` into the part over `[1,2]`
  --     and the part over `[2,10000]`.  The second part is non‑negative,
  --     hence the first part already exceeds `1/√2`.
  ----------------------------------------------------------------------
  have h_split :
      (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) =
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) +
          ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
    simpa [intervalIntegral.integral_add_adjacent] using
      (intervalIntegral.integral_add_adjacent (a:=1) (b:=2) (c:=10000)
        (by norm_num) (by norm_num)
        (by
          have h_cont :
              ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Icc (1 : ℝ) 10000) :=
            (continuous_const.div continuous_sqrt).continuousOn
          exact h_cont.integrableOn))

  have h_rest_nonneg :
      0 ≤ ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
    have h_cont :
        ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Icc (2 : ℝ) 10000) :=
      (continuous_const.div continuous_sqrt).continuousOn
    have h_ae :
        (∀ᵐ x ∂(volume.restrict (Ioc 2 10000)),
            (0 : ℝ) ≤ (1 : ℝ) / Real.sqrt x) := by
      refine eventually_of_forall ?_
      intro x hx
      exact div_nonneg (by norm_num) (Real.sqrt_nonneg _)
    exact intervalIntegral.integral_nonneg_ae_iff.2 ⟨h_cont.integrableOn, h_ae⟩

  have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) := by
    have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) =
          (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) -
            ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
      have := h_split
      linarith
    have h1 : (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) :=
      h_int_gt_f₂
    have h2 : (∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) ≥ 0 := h_rest_nonneg
    linarith

  exact this
```

The proof proceeds as follows.

1. Using `Finset.single_le_sum` and the non‑negativity of each term, we obtain  
   \(\displaystyle \frac1{\sqrt2}\le\sum_{k=2}^{10000}\frac1{\sqrt k}\).

2. The term for \(k=3\) is strictly positive; rewriting the sum as  
   \(\frac1{\sqrt2}+ \sum_{k=3}^{10000}\frac1{\sqrt k}\) shows that the whole sum is
   strictly larger than \(\frac1{\sqrt2}\).

3. By hypothesis `h_le`, this sum is bounded above by the integral
   \(\int_{1}^{10000}\frac{dx}{\sqrt x}\); consequently the integral itself is
   strictly larger than \(\frac1{\sqrt2}\).

4. Splitting the integral at the point \(2\) and using the non‑negativity of the
   tail \(\int_{2}^{10000}\frac{dx}{\sqrt x}\) yields the desired strict inequality
   for the integral over \([1,2]\).

Thus \(\displaystyle \int_{1}^{2}\frac{dx}{\sqrt x}>\frac1{\sqrt2}\). ∎
