    have h_zero : (volume.restrict (Set.Icc (1 : ℝ) 2)) {2} = 0 := by
      simpa using (measure_singleton (μ := volume.restrict (Set.Icc (1 : ℝ) 2)) (a := (2 : ℝ)))
    filter_upwards [Filter.eventually_of_forall
