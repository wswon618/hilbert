    intro x hx
    have h₂ : 1 ≤ x := by exact hx.1
    have h₃ : x ≤ 2 := by exact hx.2
    have h₄ : 0 < x := by linarith
    have h₅ : 0 < Real.sqrt x := Real.sqrt_pos.mpr h₄
    have h₆ : 0 < (1 : ℝ) / Real.sqrt x := by positivity
    exact h₆
  
  have h₂ : (1 : ℝ) < (2 : ℝ) := by norm_num
  
  have h₃ : (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    have h₄ : ∀ x ∈ Set.Icc (1 : ℝ) 2, (0 : ℝ) < (1 : ℝ) / Real.sqrt x := h₁
    have h₅ : (1 : ℝ) < (2 : ℝ) := h₂
    -- Use the fact that the function is positive on [1, 2] to show the integral is positive.
    have h₆ : (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
      apply intervalIntegral.integral_pos_of_pos
      <;> simp_all [h₅]
      <;>
      (try norm_num) <;>
      (try
        {
          intro x hx
          have h₇ : x ∈ Set.Icc (1 : ℝ) 2 := by
            constructor <;> linarith [hx.1, hx.2]
          have h₈ : (0 : ℝ) < (1 : ℝ) / Real.sqrt x := h₁ x h₇
          exact h₈
        }) <;>
      (try linarith)
    exact h₆
  
  exact h₃
