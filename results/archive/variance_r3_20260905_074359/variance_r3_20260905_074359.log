      (-1 : ℝ) < -(1 / 2) ∨ (-(1 / 2) ≠ -1 ∧ (0 : ℝ) ∉ Set.uIcc (1 : ℝ) 10000) := by
    left
    norm_num
  -- rewrite the integrand as a power
  have h_eq :
      (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) =
        ∫ x in (1 : ℝ)..10000, x ^ (-(1 / 2)) := by
    have : (fun x : ℝ => (1 : ℝ) / Real.sqrt x) = fun x => x ^ (-(1 / 2)) := by
