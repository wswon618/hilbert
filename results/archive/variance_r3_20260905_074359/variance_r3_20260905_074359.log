  have h_ae_le :
      (∀ᵐ x ∂(volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt (2 : ℝ) ≤ (1 : ℝ) / Real.sqrt x) := by
    exact (Filter.eventually_of_forall (fun x hx => h_pointwise x hx))
  -- apply monotonicity of the interval integral
  have h_le :
      (∫ x in 1..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) ≤
        ∫ x in 1..2, (1 : ℝ) / Real.sqrt x :=
    intervalIntegral.integral_le_integral_of_le_ae h_const_int h_func_int h_ae_le
  exact h_le
