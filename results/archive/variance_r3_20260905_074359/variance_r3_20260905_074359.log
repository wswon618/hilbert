theorem h_ne_h_int_12_strict_h_int_gt_f2_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_int_big_strict :
        (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≠ (1 : ℝ) / Real.sqrt (2) := by
  /- 1.  Compute the integral on `[1,2]`. -/
  have h_int_eq :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) = 2 * Real.sqrt 2 - 2 := by
    -- derivative of `λ y, 2 * sqrt y` is `1 / sqrt x`
    have hderiv :
        ∀ x ∈ Icc (1 : ℝ) 2,
          HasDerivAt (fun y => (2 : ℝ) * Real.sqrt y) (1 / Real.sqrt x) x := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        exact lt_of_lt_of_le (by norm_num) this
      have h := (Real.hasDerivAt_sqrt hxpos).const_mul 2
      simpa [one_div, mul_comm, mul_left_comm, mul_assoc] using h
    -- apply the fundamental theorem of calculus for interval integrals
    have h :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := (1 : ℝ)) (b := (2 : ℝ))
        (f := fun y => (2 : ℝ) * Real.sqrt y)
        (f' := fun x => (1 : ℝ) / Real.sqrt x) hderiv
    simpa [Real.sqrt_one, mul_comm, mul_left_comm, mul_assoc] using h

  /- 2.  Show that this value is strictly larger than `1 / sqrt 2`. -/
  have h_lt : (1 / Real.sqrt 2) < 2 * Real.sqrt 2 - 2 := by
    have hpos : (0 : ℝ) < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
    -- multiply the desired inequality by `sqrt 2` (positive) to avoid the division
    have : (1 : ℝ) < (2 * Real.sqrt 2 - 2) * Real.sqrt 2 := by
      have : (2 * Real.sqrt 2 - 2) * Real.sqrt 2 = 4 - 2 * Real.sqrt 2 := by
        ring
      -- we are left to prove `1 < 4 - 2 * sqrt 2`, i.e. `2 * sqrt 2 < 3`
      have hsqrt : Real.sqrt 2 < (3 / 2) := by
        have : (2 : ℝ) < (9 / 4) := by norm_num
        have : (Real.sqrt 2) ^ 2 < (3 / 2) ^ 2 := by
          simpa [pow_two] using this
        exact (Real.sqrt_lt (by norm_num)).mpr this
      have : 4 - 2 * Real.sqrt 2 > 4 - 2 * (3 / 2) := by
        linarith
      have : (4 - 2 * Real.sqrt 2) = (2 * Real.sqrt 2 - 2) * Real.sqrt 2 := by
        ring
      linarith
    exact (div_lt_iff hpos).mpr this

  /- 3.  Conclude the desired inequality. -/
  have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt 2 := by
    simpa [h_int_eq] using h_lt
  exact ne_of_gt this
