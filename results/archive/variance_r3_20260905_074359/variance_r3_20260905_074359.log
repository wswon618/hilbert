    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) := by
  -- Restrict the antitone hypothesis to the interval `[1,2]`.
  have h_antitone' :
      AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
    h_antitone.mono (by
      intro x hx
      exact hx)
  -- The integral of a constant over `[1,2]` equals the constant itself.
  have h_eq_const :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) = (1 : ℝ) / Real.sqrt 2 := by
    simpa [intervalIntegral.integral_const, sub_self, one_mul] using
      (intervalIntegral.integral_const (a := (1 : ℝ)) (b := 2)
        (c := (1 : ℝ) / Real.sqrt 2))
  -- Integrability of the constant and of `x ↦ 1/√x` on `[1,2]`.
  have h_int_const :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2) volume 1 2 :=
    intervalIntegrable_const
  have h_int_f :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 := by
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa [one_div] using
