theorem hsum_eq_tan_aime_1999_p11 :
    (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180)) =
      Real.tan ((35 : ℝ) * Real.pi / 72) := by
  -- simplify the angle `5 * k * π / 180` to `k * π / 36`
  have hθ : (5 : ℝ) * Real.pi / 180 = Real.pi / 36 := by
    field_simp
  -- rewrite the original sum using `hθ`
  have hsum_original :
      (∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin (5 * k * Real.pi / 180)) =
        (∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin ((k : ℝ) * Real.pi / 36)) := by
    refine Finset.sum_congr rfl ?_
    intro k hk
    have : (5 : ℝ) * (k : ℝ) * Real.pi / 180 = (k : ℝ) * Real.pi / 36 := by
      field_simp [hθ]
    simpa [this]
  -- evaluate the sum `∑ sin (k·π/36)` using the standard formula
  have hsum_eval :
      (∑ k in Finset.Icc (1 : ℕ) 35,
          Real.sin ((k : ℝ) * Real.pi / 36)) =
        Real.tan (35 * Real.pi / 72) := by
    have hformula := Real.sin_sum_Icc (n := 35) (θ := Real.pi / 36)
    -- `hformula` gives the sum in terms of sines
    have hsin_pi_half :
        Real.sin ((35 + 1 : ℝ) * Real.pi / 72) = 1 := by
      have : ((35 + 1 : ℝ) * Real.pi / 72) = Real.pi / 2 := by norm_num
      simpa [this] using Real.sin_pi_div_two
    have hcos_eq :
        Real.cos (35 * Real.pi / 72) = Real.sin (Real.pi / 72) := by
      have h := Real.cos_eq_sin_pi_div_two_sub (35 * Real.pi / 72)
      have : Real.pi / 2 - 35 * Real.pi / 72 = Real.pi / 72 := by norm_num
      simpa [this] using h
    simpa [hsin_pi_half, hcos_eq, Real.tan_eq_sin_div_cos,
          div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hformula
  -- combine the two equalities
  simpa [hsum_original] using hsum_eval
