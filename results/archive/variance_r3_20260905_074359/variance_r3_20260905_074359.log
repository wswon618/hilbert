    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) := by
  -- Define the integrand
  set f : ℝ → ℝ := fun x => (1 : ℝ) / Real.sqrt x
  -- Constant lower bound on `[1,2]`
  let c : ℝ → ℝ := fun _ => (1 : ℝ) / Real.sqrt (2)
  have h_cont_f : ContinuousOn f (Set.Icc (1 : ℝ) 2) := by
    have h_cont : Continuous fun x : ℝ => (1 : ℝ) / Real.sqrt x :=
      (continuous_const.div Real.continuous_sqrt).comp continuous_id
    exact h_cont.continuousOn
  have h_cont_c : ContinuousOn c (Set.Icc (1 : ℝ) 2) := (continuous_const).continuousOn
  -- `c ≤ f` on `Ioc 1 2`
  have h_le' : ∀ x ∈ Set.Ioc (1 : ℝ) 2, c x ≤ f x := by
    intro x hx
    rcases hx with ⟨hx1, hx2⟩
    have hxpos : 0 < x := by linarith
    have hpos_sqrt : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
    have hpos_sqrt2 : 0 < Real.sqrt (2 : ℝ) := by
      have : (0 : ℝ) < (2 : ℝ) := by norm_num
      exact Real.sqrt_pos.mpr this
    have h_sqrt_le : Real.sqrt x ≤ Real.sqrt (2 : ℝ) :=
      (Real.sqrt_le_sqrt_iff (by norm_num)).mpr hx2
    exact (one_div_le_one_div_iff hpos_sqrt2 hpos_sqrt).mpr h_sqrt_le
  -- There exists a point where `c < f`
  have h_lt' : ∃ x ∈ Set.Icc (1 : ℝ) 2, c x < f x := by
    refine ⟨1, ?_, ?_⟩
    · simp
    · have hpos2 : 0 < Real.sqrt (2 : ℝ) :=
        Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < (2 : ℝ))
      have hpos1 : 0 < Real.sqrt (1 : ℝ) :=
        Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < (1 : ℝ))
      have h_sqrt_lt : Real.sqrt (1 : ℝ) < Real.sqrt (2 : ℝ) :=
        Real.sqrt_lt_sqrt (by norm_num) (by norm_num : (1 : ℝ) < (2 : ℝ))
      have : (1 : ℝ) / Real.sqrt (2) < (1 : ℝ) / Real.sqrt (1 : ℝ) :=
        (one_div_lt_one_div_iff hpos2 hpos1).mpr h_sqrt_lt
