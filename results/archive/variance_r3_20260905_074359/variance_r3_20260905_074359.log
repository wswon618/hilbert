      have hsqrtpos : 0 < Real.sqrt (1.5) := (Real.sqrt_pos.mpr hxpos)
      exact (div_pos (by norm_num) hsqrtpos)
  -- positivity of the integral follows from the two facts above
  have h_lt : (1 : ℝ) < 2 := by norm_num
  exact
    intervalIntegral.integral_pos
      (a := (1 : ℝ)) (b := (2 : ℝ))
      (f := fun x => (1 : ℝ) / Real.sqrt x)
