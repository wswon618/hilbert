  /- First we show that the integral over `[1,2]` dominates the constant
      `1 / √2`. -/
  have h_ge_const :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≥ (1 : ℝ) / Real.sqrt 2 := by
    -- the integrand minus the constant is non‑negative on the interval
    have h_nonneg :
        ∀ x ∈ Set.Icc (1 : ℝ) 2,
          0 ≤ (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt 2 := by
      intro x hx
      have hxle : x ≤ 2 := hx.2
      have hx_mem : x ∈ Set.Icc (1 : ℝ) (10000 : ℝ) :=
        ⟨hx.1, le_trans hx.2 (by norm_num)⟩
      have hmono := h_antitone hx_mem
      have : (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := hmono hxle
      exact sub_nonneg.mpr this
    have hab : (1 : ℝ) ≤ 2 := by norm_num
    have h_int_nonneg :=
      intervalIntegral.integral_nonneg_of_forall hab h_nonneg
    -- integral of the constant `1/√2` on a unit interval is exactly `1/√2`
    have h_const :
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) = (1 : ℝ) / Real.sqrt 2 := by
      simpa [intervalIntegral.integral_const, sub_eq_add_neg, one_mul] using
        (intervalIntegral.integral_const (a := (1 : ℝ)) (b := 2)
          (c := (1 : ℝ) / Real.sqrt 2))
    -- add the non‑negative difference to the constant integral
    have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) ≤
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) := by
      have := add_le_add_left h_int_nonneg
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2)
      simpa [intervalIntegral.integral_add, sub_eq_add_neg,
        add_comm, add_left_comm, add_assoc] using this
    simpa [h_const] using this
  /- The inequality is strict because the integrand is not identically the
      constant `1/√2` on `[1,2]`. -/
  have h_ne :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≠ (1 : ℝ) / Real.sqrt 2 := by
    intro h_eq
    have h_pos' : (0 : ℝ) < (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) := h_pos
    have h_const_pos : (0 : ℝ) < (1 : ℝ) / Real.sqrt 2 := by
      have : (0 : ℝ) < Real.sqrt 2 := by positivity
      exact div_pos (by norm_num) this
    have : (0 : ℝ) < (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) := by
      simpa [h_eq] using h_pos'
    have : (0 : ℝ) < (1 : ℝ) / Real.sqrt 2 := by
      simpa [intervalIntegral.integral_const, sub_eq_add_neg, one_mul] using this
    linarith
  exact lt_of_le_of_ne h_ge_const (Ne.symm h_ne)
