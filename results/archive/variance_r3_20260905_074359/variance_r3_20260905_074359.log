import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_sum_le_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000))
    (h_integral_eq :
        (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = (198 : ℝ))
    (h_le :
        (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
          ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x)
    (h_pos :
        (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x)
    (h_int_gt_f2 :
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2)) :
    (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
      (1 : ℝ) / Real.sqrt (2) + ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
  classical
  -- Restrict the antitone hypothesis to the interval `[2,10000]`.
  have h_antitone' :
      AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (2 : ℝ) 10000) :=
    h_antitone.mono (by
      intro x hx
      rcases hx with ⟨hx2, hx10000⟩
      exact ⟨le_trans (by norm_num) hx2, hx10000⟩)
  -- Apply the sum–integral comparison on `[2,10000]`.
  have h_tail :
      (∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
        ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x :=
    by
      have hab : (2 : ℕ) ≤ 10000 := by norm_num
      have h :=
        (AntitoneOn.sum_le_integral_Ico (a := 2) (b := 10000) hab h_antitone')
      simpa [Finset.sum_Ico_eq_sum_Icc_succ, Nat.succ_eq_add_one] using h
  -- Add the first term `1/√2` to both sides.
  have h_with_first :
      (1 : ℝ) / Real.sqrt 2 + ∑ k in Finset.Icc (3 : ℕ) 10000, (1 : ℝ) / Real.sqrt k ≤
        (1 : ℝ) / Real.sqrt 2 + ∫ x in (2 : ℝ)..10000, (1 : ℝ) / Real.sqrt x :=
    add_le_add_left h_tail _
  -- Rewrite the left‑hand side as the original sum.
  have h2_not : (2 : ℕ) ∉ Finset.Icc (3 : ℕ) 10000 := by
    simp
