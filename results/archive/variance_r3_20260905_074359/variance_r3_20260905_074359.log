  -- Rewrite the integral over `[1,2]` as an integral over `Ioc 1 2`.
  have h_int_eq :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) =
        ∫ x in Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt x := by
    simpa [intervalIntegral.integral_of_le (by norm_num : (1 : ℝ) ≤ 2)]
  -- Compute the integral of the constant function `1/√2` over `Ioc 1 2`.
  have h_const_int :
      (∫ x in Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt (2)) = (1 : ℝ) / Real.sqrt (2) := by
    simpa [intervalIntegral.integral_of_le (by norm_num : (1 : ℝ) ≤ 2),
      intervalIntegral.integral_const, sub_eq_add_neg, add_comm, add_left_neg,
      one_mul, sub_self] 
  -- Show that the constant is strictly smaller than the integrand on a set of
  -- positive measure.
  have h_ae :
      (∀ᵐ x ∂(volume.restrict (Ioc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt (2) < (1 : ℝ) / Real.sqrt x) := by
    filter_upwards [self_mem_ae_restrict] with x hx
    rcases hx with ⟨hx1, hx2⟩
    have hx_lt : x < (2 : ℝ) := lt_of_le_of_ne hx2 (by
      intro h
      have : (x : ℝ) = 2 := by simpa using h
      have : (x : ℝ) ∈ ({2} : Set ℝ) := by simpa [this] using hx2
      have : (volume.restrict (Ioc (1 : ℝ) 2)) {2} = 0 := by simp
      exact (this.elim))
    have hx_pos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx1
    have h_sqrt_pos : 0 < Real.sqrt x := Real.sqrt_pos.mpr hx_pos
    have h_sqrt2_pos : 0 < Real.sqrt (2 : ℝ) := by positivity
    have h_sqrt_lt : Real.sqrt x < Real.sqrt (2 : ℝ) :=
      Real.sqrt_lt_sqrt_iff.mpr hx_lt
    exact (one_div_lt_one_div_of_pos h_sqrt_pos h_sqrt_lt)
  -- Apply the strict integral inequality.
  have h_strict :
      (∫ x in Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt (2)) <
        ∫ x in Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt x :=
    integral_lt_integral_of_lt_ae h_ae
  -- Conclude the desired inequality.
  have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2) := by
    simpa [h_int_eq, h_const_int] using h_strict
  exact this
