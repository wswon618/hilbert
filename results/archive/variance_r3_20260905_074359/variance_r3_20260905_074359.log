theorem hsum_eq_tan_aime_1999_p11 :
    (∑ k in Finset.Icc (1 : ℕ) 35, Real.sin (5 * k * Real.pi / 180)) =
      Real.tan ((35 : ℝ) * Real.pi / 72) := by
  -- simplify the angle `5·π/180`
  have hθ : (5 : ℝ) * Real.pi / 180 = Real.pi / 36 := by
    field_simp
    ring
  -- closed form for the finite sum of sines in an arithmetic progression
  have hsum :
      (∑ k in Finset.Icc (1 : ℕ) 35,
        Real.sin (5 * k * Real.pi / 180)) =
        Real.sin (35 * Real.pi / 72) / Real.sin (Real.pi / 72) := by
    simpa [hθ, mul_comm, mul_left_comm, mul_assoc] using
      (Real.sum_Icc_mul_sin (a := (1 : ℕ)) (b := 35) (θ := Real.pi / 36))
  -- rewrite the denominator `cos (35π/72)` as `sin (π/72)`
  have hcos : Real.cos (35 * Real.pi / 72) = Real.sin (Real.pi / 72) := by
    have h := Real.cos_pi_div_two_sub (Real.pi / 72)
    have : Real.pi / 2 - Real.pi / 72 = 35 * Real.pi / 72 := by
      field_simp
      ring
    simpa [this] using h
  -- turn the right‑hand side into a tangent and finish
  simpa [Real.tan_eq_sin_div_cos, hcos] using hsum
