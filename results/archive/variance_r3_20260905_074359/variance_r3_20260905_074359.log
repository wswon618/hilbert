theorem h_int_eq_h_ne_h_int_12_strict_h_int_gt_f2_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
    (hF_cont : ContinuousOn (fun x : ℝ => (2 : ℝ) * Real.sqrt x) (Set.Icc (1 : ℝ) 2))
    (hF_deriv :
        ∀ x ∈ Set.Ioo (1 : ℝ) 2,
          HasDerivAt (fun x => (2 : ℝ) * Real.sqrt x) (1 / Real.sqrt x) x) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) =
      (2 : ℝ) * Real.sqrt 2 - (2 : ℝ) * Real.sqrt 1 := by
  -- integrability of the derivative
  have h_int : IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 2 := by
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        exact lt_of_lt_of_le (by norm_num) this
      have hpos : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt hpos
    have h_cont_sqrt : ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
      exact (Real.continuous_sqrt).continuousOn
    simpa [one_div] using
      (intervalIntegral.intervalIntegrable_one_div (f := fun x : ℝ => Real.sqrt x) h_ne h_cont_sqrt)
  -- apply the Fundamental Theorem of Calculus
  have h_eq :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) =
        (fun x : ℝ => (2 : ℝ) * Real.sqrt x) 2 -
        (fun x : ℝ => (2 : ℝ) * Real.sqrt x) 1 := by
    have hab : (1 : ℝ) ≤ 2 := by norm_num
    simpa using
      (intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le
        (a := 1) (b := 2)
        (f := fun x : ℝ => (2 : ℝ) * Real.sqrt x)
        (f' := fun x : ℝ => (1 : ℝ) / Real.sqrt x)
        hab hF_cont hF_deriv h_int)
  simpa [Real.sqrt_one] using h_eq
