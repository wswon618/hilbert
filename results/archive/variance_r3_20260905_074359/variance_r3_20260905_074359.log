    IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume (1 : ℝ) 2 := by
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
    -- numerator is constant, hence continuous
    have h_num :
        ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Set.Icc (1 : ℝ) 2) :=
      (continuous_const : Continuous fun _ : ℝ => (1 : ℝ)).continuousOn
    -- square‑root is continuous everywhere
    have h_den :
        ContinuousOn Real.sqrt (Set.Icc (1 : ℝ) 2) :=
      (continuous_sqrt : Continuous Real.sqrt).continuousOn
    -- on the interval the denominator never vanishes
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) hx.1
      have hpos : (0 : ℝ) < Real.sqrt x := (Real.sqrt_pos).2 hxpos
      exact ne_of_gt hpos
    simpa using h_num.div h_den h_ne
  exact (ContinuousOn.intervalIntegrable hcont)
