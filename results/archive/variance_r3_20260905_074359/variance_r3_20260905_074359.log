      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt (2 : ℝ) ≤ (1 : ℝ) / Real.sqrt x) := by sorry
  -- apply monotonicity of the interval integral
  have h_le :
      (∫ x in 1..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) ≤
        ∫ x in 1..2, (1 : ℝ) / Real.sqrt x := by sorry
  exact h_le
