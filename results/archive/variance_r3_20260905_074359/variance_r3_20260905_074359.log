        (μ := MeasureTheory.volume) (a := (1 : ℝ)) (b := 2) h_cont h_ne)
  -- apply monotonicity of the integral
  exact
    intervalIntegral.integral_le_integral_of_le h_int_const h_int_fun h_pointwise
