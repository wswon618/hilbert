          ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) :
    (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- positivity of the constant `1 / sqrt 2`
  have hpos_const : (0 : ℝ) < (1 : ℝ) / Real.sqrt (2 : ℝ) := by
    have h2pos : (0 : ℝ) < (2 : ℝ) := by norm_num
    have hsqrt2pos : (0 : ℝ) < Real.sqrt (2 : ℝ) := (Real.sqrt_pos.mpr h2pos)
    exact div_pos (by norm_num) hsqrt2pos
  -- lower bound for the integrand on `[1,2]`
  have hle_fun :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt (2 : ℝ) ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hxpos : 0 < Real.sqrt x := by
      have hxpos' : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        have : (0 : ℝ) < (1 : ℝ) := by norm_num
        exact lt_of_lt_of_le this hx.1
      exact (Real.sqrt_pos.mpr hxpos')
    have hle : Real.sqrt x ≤ Real.sqrt (2 : ℝ) := by
      have : x ≤ (2 : ℝ) := hx.2
      exact Real.sqrt_le_sqrt this
    have := (one_div_le_one_div_of_le hxpos hle)
    simpa using this
  -- integral inequality using the pointwise bound
  have h_int_le :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    apply intervalIntegral.integral_le_integral
    intro x hx
    exact hle_fun x hx
  -- positivity of the integral of the constant function
  have hpos_int_const :
      (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ) := by
    simpa [intervalIntegral.integral_const] using hpos_const
  -- combine the two inequalities
  exact lt_of_lt_of_le hpos_int_const h_int_le
