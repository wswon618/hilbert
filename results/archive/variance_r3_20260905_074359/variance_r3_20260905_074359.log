    have hcases : (2 : ℝ) ≤ x ∨ x ≤ 2 := le_total (2 : ℝ) x
    cases hcases with
    | inl hle' =>
        -- when `2 ≤ x` we have `1/√x ≤ 1/√2`, i.e. the desired inequality reversed.
        have := hmono hle'
        exact le_of_eq (by
          simpa [eq_comm] using this.symm)
    | inr hle' =>
