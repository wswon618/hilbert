  -- `sqrt x` is never zero on the interval
  have h_ne : ∀ x ∈ Set.Icc (2 : ℝ) 10000, Real.sqrt x ≠ 0 := by
    intro x hx
    have hxpos : (0 : ℝ) < x :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < (2 : ℝ)) hx.1
    have hpos : 0 < Real.sqrt x := (Real.sqrt_pos.mpr hxpos)
    exact ne_of_gt hpos
  -- continuity of the reciprocal of `sqrt`
  have hcont_inv :
      ContinuousOn (fun x : ℝ => (Real.sqrt x)⁻¹) (Set.Icc (2 : ℝ) 10000) :=
    hcont_sqrt.inv₀ h_ne
  -- rewrite as division
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (2 : ℝ) 10000) := by
    simpa [div_eq_mul_inv] using hcont_inv
  -- conclude interval integrability
  exact hcont.intervalIntegrable (by norm_num : (2 : ℝ) ≤ 10000)
