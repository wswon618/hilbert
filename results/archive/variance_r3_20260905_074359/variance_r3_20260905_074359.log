theorem h_pos_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000))
    (h_integral_eq :
        (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = (198 : ℝ))
    (h_le :
        (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≤
          ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) :
    (0 : ℝ) < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- a.e. inequality: the constant `1 / √2` is a lower bound of the integrand on `[1,2]`
  have h_ae :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Ioc (1 : ℝ) 2)),
          (1 : ℝ) / Real.sqrt (2) ≤ (1 : ℝ) / Real.sqrt x) := by
    apply Filter.eventually_of_forall
    intro x hx
    rcases hx with ⟨hx₁, hx₂⟩
    -- `x` belongs to `Icc 1 2`
    have hx_mem : x ∈ Set.Icc (1 : ℝ) 2 := ⟨le_of_lt hx₁, hx₂⟩
    -- hence also to `Icc 1 10000`
    have hx_mem' : x ∈ Set.Icc (1 : ℝ) (10000 : ℝ) :=
      ⟨hx_mem.1, le_trans hx_mem.2 (by norm_num)⟩
    have h2_mem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) (10000 : ℝ) := by
      exact ⟨by norm_num, by norm_num⟩
    -- use antitone property: for `x ≤ 2` we have `f 2 ≤ f x`
    have := h_antitone hx_mem' h2_mem hx_mem.2
    exact this
  -- compare the integral of the constant with the integral of the function
  have h_int_le :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2)) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x :=
    intervalIntegral.integral_le_integral_of_le_ae h_ae
  -- evaluate the integral of the constant
  have h_const :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2)) = (1 : ℝ) / Real.sqrt (2) := by
    simpa [intervalIntegral.integral_const] 
  have h_lower :
      (1 : ℝ) / Real.sqrt (2) ≤ ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    simpa [h_const] using h_int_le
  -- the constant is positive
  have h_pos_const : (0 : ℝ) < (1 : ℝ) / Real.sqrt (2) := by
    have h_sqrt : (0 : ℝ) < Real.sqrt (2) := Real.sqrt_pos.mpr (by norm_num)
    exact (div_pos (by norm_num) h_sqrt)
  exact lt_of_lt_of_le h_pos_const h_lower
```
