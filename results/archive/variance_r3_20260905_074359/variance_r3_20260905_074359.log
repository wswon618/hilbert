    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = (198 : ℝ) := by
  /- 1.  Derivative of `F x = 2 * sqrt x` is `1 / sqrt x` on the interval. -/
  have hderiv :
      ∀ x ∈ uIcc (1 : ℝ) 10000,
        HasDerivAt (fun y => (2 : ℝ) * Real.sqrt y) (1 / Real.sqrt x) x := by
    intro x hx
    rcases hx with ⟨hx1, hx2⟩
    have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx1
    have hsqrt : HasDerivAt Real.sqrt (1 / (2 * Real.sqrt x)) x :=
      (Real.hasDerivAt_sqrt hxpos)
    have hmul := hsqrt.const_mul (2 : ℝ)
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hmul

  /- 2.  The integrand is continuous (hence integrable) on `[1,10000]`. -/
  have hint :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 10000 := by
    have hcont : ContinuousOn (fun x : ℝ => Real.sqrt x) (Icc (1 : ℝ) 10000) :=
      (continuous_sqrt).continuousOn
    have hne : ∀ x ∈ Icc (1 : ℝ) 10000, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa [one_div] using
      (intervalIntegrable_one_div (f := fun x : ℝ => Real.sqrt x)
        (a := 1) (b := 10000) hcont hne)

  /- 3.  Apply the Fundamental Theorem of Calculus. -/
  have hcalc :
      (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) =
        (2 * Real.sqrt 10000 - 2 * Real.sqrt 1) := by
    simpa using
      (intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := 1) (b := 10000)
        (f := fun y => (2 : ℝ) * Real.sqrt y)
        (f' := fun y => (1 : ℝ) / Real.sqrt y)
        hderiv hint)

  /- 4.  Simplify the right‑hand side to `198`. -/
  have hval : (2 * Real.sqrt 10000 - 2 * Real.sqrt 1) = (198 : ℝ) := by
    have h100 : Real.sqrt 10000 = (100 : ℝ) := by
      have hpos : (0 : ℝ) ≤ (100 : ℝ) := by norm_num
      have : (100 : ℝ) * 100 = (10000 : ℝ) := by norm_num
      simpa [this] using (Real.sqrt_mul_self hpos)
    have h1 : Real.sqrt (1 : ℝ) = (1 : ℝ) := by
      have hpos : (0 : ℝ) ≤ (1 : ℝ) := by norm_num
      simpa using (Real.sqrt_mul_self hpos)
    simpa [h100, h1] using (by norm_num :
      (2 * (100 : ℝ) - 2 * (1 : ℝ)) = (198 : ℝ))

  /- 5.  Combine the two equalities. -/
  calc
    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x)
        = 2 * Real.sqrt 10000 - 2 * Real.sqrt 1 := hcalc
    _ = (198 : ℝ) := hval
