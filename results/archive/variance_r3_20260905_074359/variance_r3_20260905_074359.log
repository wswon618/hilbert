```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_int1_h_eq_h_int_eq'_h_strict_h_sum_lt_integral_algebra_sum1onsqrt2to1onsqrt10000lt198 :
    IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume (1 : ℝ) 2 := by
  -- continuity of the integrand on the closed interval [1,2]
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Icc (1 : ℝ) 2) := by
    -- the numerator is constant, hence continuous
    have hnum : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Icc (1 : ℝ) 2) :=
      (continuous_const : Continuous fun _ : ℝ => (1 : ℝ)).continuousOn
    -- the denominator `sqrt` is continuous
    have hden : ContinuousOn Real.sqrt (Icc (1 : ℝ) 2) :=
      (Real.continuous_sqrt : Continuous Real.sqrt).continuousOn
    -- on the interval the denominator never vanishes
    have hne : ∀ x ∈ Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        exact lt_of_lt_of_le (by norm_num) this
      have hsqrtpos : 0 < Real.sqrt x := (Real.sqrt_pos).2 hxpos
      exact ne_of_gt hsqrtpos
    -- combine the facts using `ContinuousOn.div`
    simpa [one_div] using hnum.div hden hne
  -- apply the interval‑integrability criterion for continuous functions
  exact (ContinuousOn.intervalIntegrable_of_Icc (by norm_num) hcont)
