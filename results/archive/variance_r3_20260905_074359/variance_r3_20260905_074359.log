    IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 2 10000 := by
  -- `2 ≤ 10000`
  have hle : (2 : ℝ) ≤ 10000 := by norm_num
  -- the denominator never vanishes on the interval
  have hpos : ∀ x ∈ Icc (2 : ℝ) 10000, Real.sqrt x ≠ 0 := by
    intro x hx
    have hxpos : (0 : ℝ) < x := by
      have : (0 : ℝ) < (2 : ℝ) := by norm_num
      exact lt_of_lt_of_le this hx.1
    have hsqrtpos : 0 < Real.sqrt x := (Real.sqrt_pos).2 hxpos
    exact ne_of_gt hsqrtpos
  -- continuity of the function on the interval
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Icc (2 : ℝ) 10000) := by
    have h1 : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Icc (2 : ℝ) 10000) :=
      (continuous_const).continuousOn
    have h2 : ContinuousOn Real.sqrt (Icc (2 : ℝ) 10000) :=
      (continuous_sqrt).continuousOn
    exact h1.div h2 hpos
  -- conclude interval integrability
  exact (ContinuousOn.intervalIntegrable_of_Icc hle hcont)
