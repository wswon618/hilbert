            omega
          })
    -- Now we know f(z) = k * z + f(0)
    obtain ⟨k, hk⟩ := h₂
    have h₃ : k = 0 ∨ k = 2 := by
      -- Use the condition f(f(b)) = 2 * f(b) + f(0)
      have h₄ := h_f_zero_add 0
      have h₅ := h_f_zero_add 1
      have h₆ := h_f_zero_add (-1)
      have h₇ := h_f_zero_add 2
      have h₈ := h_f_zero_add (-2)
      have h₉ := h_f_two_a 0
