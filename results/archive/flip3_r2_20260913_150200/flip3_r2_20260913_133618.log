          <;> simp [hz]
          <;> omega
        obtain ⟨n, hn⟩ := h₅
        have h₆ := h₃ n
        simp [hn] at h₆ ⊢
        <;> ring_nf at h₆ ⊢ <;>
          (try omega) <;>
          (try linarith) <;>
