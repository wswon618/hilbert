      have h₁₁ := h_f_two_a (-1)
      have h₁₂ := h_f_two_a 2
      have h₁₃ := h_f_two_a (-2)
      simp [hk] at h₄ h₅ h₆ h₇ h₈ h₉ h₁₀ h₁₁ h₁₂ h₁₃
      -- Solve for k using the simplified equations
      have h₁₄ : k = 0 ∨ k = 2 := by
        have h₁₅ : k * k = 2 * k := by
          nlinarith
        have h₁₆ : k = 0 ∨ k = 2 := by
          have h₁₇ : k * (k - 2) = 0 := by linarith
          have h₁₈ : k = 0 ∨ k - 2 = 0 := by
            apply eq_zero_or_eq_zero_of_mul_eq_zero h₁₇
          cases h₁₈ with
          | inl h₁₉ =>
            exact Or.inl h₁₉
          | inr h₁₉ =>
            have h₂₀ : k = 2 := by linarith
            exact Or.inr h₂₀
        exact h₁₆
      exact h₁₄
    -- Case analysis on k
    cases h₃ with
    | inl h₃ =>
      -- Case k = 0
      have h₄ : ∀ z, f z = 0 := by
        intro z
        have h₅ := hk z
        rw [h₃] at h₅
        ring_nf at h₅ ⊢
        linarith
      exact Or.inl h₄
    | inr h₃ =>
      -- Case k = 2
      have h₄ : ∃ c, ∀ z, f z = 2 * z + c := by
        use f 0
        intro z
        have h₅ := hk z
        rw [h₃] at h₅
        ring_nf at h₅ ⊢
        <;> linarith
      exact Or.inr h₄
  
  have h_final : ∀ z, f z = 0 ∨ ∃ c, ∀ z, f z = 2 * z + c := by
    intro z
    cases h_main with
    | inl h =>
      -- Case: f is identically zero
