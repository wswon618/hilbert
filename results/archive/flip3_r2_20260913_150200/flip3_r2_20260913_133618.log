          {
            omega
          })
      · -- z is negative
        have h₅ : ∃ (n : ℕ), (-(n : ℤ)) = z := by
          use (-z).toNat
          <;> simp [hz]
          <;> omega
        obtain ⟨n, hn⟩ := h₅
        have h₆ := h₄ n
        simp [hn] at h₆ ⊢
        <;> ring_nf at h₆ ⊢ <;>
          (try omega) <;>
          (try linarith) <;>
