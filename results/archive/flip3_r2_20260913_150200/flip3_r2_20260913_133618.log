  · -- k = 0, hence f is identically zero
    intro z
    left
    have : g z = 0 := by
      simpa [hker] using hk z
    dsimp [g] at this
    linarith
  · -- k = 2, obtain the required affine form
    intro z
    right
    refine ⟨f 0, ?_⟩
    intro n
    have : g n = n * 2 := by
      simpa [hk2] using hk n
    dsimp [g] at this
    linarith
