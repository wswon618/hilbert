    simpa [zero_mul, zero_add] using h 0 b
  have h₂ (a : ℤ) : f (2 * a) = 2 * f a - f 0 := by
    have := h a 0
    -- rewrite the right‑hand side using `h₁`
    have hfa : f (f a) = f 0 + 2 * f a := h₁ a
    have : f (2 * a) + 2 * f 0 = f 0 + 2 * f a := by
      simpa [hfa] using this
    linarith
  ----------------------------------------------------------------------
  -- 2. From the two equalities we obtain an additive law for `f`
  ----------------------------------------------------------------------
  have h₃ (a b : ℤ) : f (a + b) = f a + f b - f 0 := by
    have := h a b
    rw [h₂ a, h₁ (a + b)] at this
    linarith
  ----------------------------------------------------------------------
  -- 3. Define the shifted function `g` and prove it is additive
  ----------------------------------------------------------------------
  let g : ℤ → ℤ := fun x => f x - f 0
  have hg_add (a b : ℤ) : g (a + b) = g a + g b := by
    dsimp [g]
    have := h₃ a b
    linarith
  ----------------------------------------------------------------------
  -- 4. `g` is a ℤ‑linear map, hence of the form `n ↦ n * k`
  ----------------------------------------------------------------------
  obtain ⟨k, hk⟩ : ∃ k : ℤ, ∀ n : ℤ, g n = n * k := by
    refine ⟨g 1, ?_⟩
    intro n
    induction n using Int.induction_on with
    | hz =>
        dsimp [g] at *
        simp
    | hp n ih =>
        have : g (n + 1) = g n + g 1 := by
          simpa using hg_add n 1
        dsimp [g] at *
        simpa [ih, mul_add, add_comm, add_left_comm, add_assoc] using this
    | hn n ih =>
        have : g (n - 1) = g n - g 1 := by
          have h' := hg_add (n - 1) 1
          have : g n = g (n - 1) + g 1 := by
            simpa [add_comm, add_left_comm, add_assoc] using h'
