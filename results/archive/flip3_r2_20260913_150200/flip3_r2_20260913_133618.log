\[
\text{extend}\,f\,g\,e'\,b = 
\begin{cases} 
g(a) & \text{if there exists } a \in \alpha \text{ with } f(a) = b \text{ (where } a \text{ is chosen arbitrarily)} \\
e'(b) & \text{otherwise.}
\end{cases}
\]
