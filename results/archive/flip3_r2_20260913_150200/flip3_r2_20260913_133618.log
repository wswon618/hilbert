set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem forward_imo_2019_p1 (f : ℤ → ℤ)
    (h : ∀ a b, f (2 * a) + 2 * f b = f (f (a + b))) :
    ∀ z, f z = 0 ∨ ∃ c, ∀ z, f z = 2 * z + c := by
  classical
  -- First we prove the auxiliary identity
  have h_add : ∀ a b : ℤ, f (a + b) = f a + f b - f 0 := by
    intro a b
    have h1 := h a b
    have h2 : f (f (a + b)) = f 0 + 2 * f (a + b) := by
      simpa [zero_mul, zero_add] using h 0 (a + b)
    have h3 : f (2 * a) = 2 * f a - f 0 := by
      have h_a0 := h a 0
      have h_0a := h 0 a
      have : f (2 * a) + 2 * f 0 = f 0 + 2 * f a := by
        have := h_a0
        have := (h 0 a).trans (by rfl)
        simpa [zero_mul, zero_add] using
          (by
            have := h_a0
            have := h_0a
            exact this.trans this)
      linarith
    have : f (2 * a) + 2 * f b = f 0 + 2 * f (a + b) := by
      simpa [h2] using h1
    have : (2 * f a - f 0) + 2 * f b = f 0 + 2 * f (a + b) := by
      simpa [h3] using this
    linarith
  -- Define the shifted function g
  let g : ℤ → ℤ := fun x => f x - f 0
  have hg_add : ∀ a b : ℤ, g (a + b) = g a + g b := by
    intro a b
    have := h_add a b
    dsimp [g] at *
    linarith
  -- g is a ℤ‑linear map, hence of the form n ↦ n * k
  have hg_linear : ∃ k : ℤ, ∀ n : ℤ, g n = n * k := by
    refine ⟨g 1, ?_⟩
    intro n
    have : g n = n • g 1 := by
      simpa using (zsmul_one_eq_iff_eq_nsmul).mpr (by
        refine Int.induction_on n ?hpos ?hneg)
    simpa [zsmul_eq_mul] using this
  rcases hg_linear with ⟨k, hk⟩
  -- Now we analyse the possible values of k
  have hk_eq : k = 0 ∨ k = 2 := by
    have : ∀ a b : ℤ, (2 * a) * k + 3 * f 0 = (a + b) * k ^ 2 + f 0 * k + f 0 := by
      intro a b
      have := h a b
      have hfa : f (f (a + b)) = f 0 + 2 * f (a + b) := by
        simpa [zero_mul, zero_add] using h 0 (a + b)
      have h2a : f (2 * a) = 2 * f a - f 0 := by
        have h_a0 := h a 0
        have h_0a := h 0 a
        have : f (2 * a) + 2 * f 0 = f 0 + 2 * f a := by
          simpa [zero_mul, zero_add] using h_a0.trans (by
            have := h_0a
            simpa [zero_mul, zero_add] using this)
        linarith
      have : (2 * a) * k + f 0 + 2 * (b * k + f 0) = f 0 + 2 * ((a + b) * k + f 0) := by
        simpa [hk, mul_add, add_comm, add_left_comm, add_assoc, two_mul,
               mul_comm, mul_left_comm, mul_assoc, add_comm] using
          (by
            simpa [h2a, hk, hfa, mul_add, add_comm, add_left_comm, add_assoc,
                   two_mul, mul_comm, mul_left_comm, mul_assoc] using h a b)
      linarith
    have : (2 * (1 : ℤ)) * k + 3 * f 0 = (1 + 0) * k ^ 2 + f 0 * k + f 0 := by
      simpa using this 1 0
    have : 2 * k + 3 * f 0 = k ^ 2 + f 0 * k + f 0 := by simpa using this
    have : 2 * k = k ^ 2 := by
      have : 2 * k + 3 * f 0 = k ^ 2 + f 0 * k + f 0 := this
      linarith
    have hk2 : k * (k - 2) = 0 := by
      have : k ^ 2 - 2 * k = 0 := by linarith
      simpa [pow_two, mul_sub, sub_eq, sub_eq_zero] using this
    have : k = 0 ∨ k = 2 := by
      have h' := mul_eq_zero.mp hk2
      rcases h' with h' | h'
      · left; exact h'
      · right; have : k - 2 = 0 := h'
        linarith
