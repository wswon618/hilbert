  (hdg : DiffContOnCl ℂ g (Iio 0 ×ℂ Ioi 0))
  (hBg : ∃ c < (2 : ℝ), ∃ B, g =O[cobounded ℂ ⊓ 𝓟 (Iio 0 ×ℂ Ioi 0)] fun z => expR (B * abs z ^ c))
  (hre : ∀ x : ℝ, x ≤ 0 → f x = g x) (him : ∀ x : ℝ, 0 ≤ x → f (x * I) = g (x * I)) : EqOn f g {z | z.re ≤ 0 ∧ 0 ≤ z.im}

