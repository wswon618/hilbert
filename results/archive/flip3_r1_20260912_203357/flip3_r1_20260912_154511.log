theorem amc12b_2002_p4 (n : ℕ) (h₀ : 0 < n)
    (h₁ : (1 /. 2 + 1 /. 3 + 1 /. 7 + 1 /. (n : ℚ)).den = 1) : n = 42 := by
  -- the basic sum of three reciprocals
  have h_sum_three :
