    have hpos : 0 < 42 * n := by
      have : (0 : ℕ) < n := h₀
      exact Nat.mul_pos (by decide) this
    exact Nat.eq_of_mul_eq_mul_left hpos (by
      simpa [Nat.mul_comm] using (Nat.mul_div_cancel' (Nat.gcd_pos_of_pos_left _ (by decide)) h_eq_one))
  -- 9. translate the gcd equality into a divisibility statement
  have h_dvd : (42 * n) ∣ (41 * n + 42) := by
    -- gcd = 42*n implies 42*n divides the other argument
    have : (42 * n) ∣ (41 * n + 42) := by
      exact Nat.dvd_of_gcd_eq_left h_gcd
    simpa [Int.ofNat_mul, Int.ofNat_add, Int.ofNat_mul, Int.ofNat_mul] using this
  -- 10. obtain a natural k witnessing the divisibility
  obtain ⟨k, hk⟩ := h_dvd
  -- 11. rewrite the equality in a convenient form
  have h_eq :
      42 = n * (42 * k - 41) := by
    have hk' : (41 * n + 42) = k * (42 * n) := by
      simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hk
    calc
