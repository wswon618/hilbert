            by_contra h₄
            push_neg at h₄
            exact h₂ (fun z => by simpa using h₄ z)
          -- Obtain a z such that f(z) ≠ 0
          obtain ⟨z, hz⟩ := h₄
          -- Use the given condition to find the form of f
          have h₅ : f z = 0 ∨ ∃ c, ∀ z, f z = 2 * z + c := h z
          cases h₅ with
          | inl h₅ =>
            exfalso
            apply hz
            linarith
          | inr h₅ =>
            obtain ⟨c, hc⟩ := h₅
            exact ⟨c, hc⟩
        -- Obtain the constant c such that f(z) = 2z + c
        obtain ⟨c, hc⟩ := h₃
        intro a b
        have h₄ : f (2 * a) = 2 * (2 * a) + c := by
          have h₅ := hc (2 * a)
          linarith
        have h₅ : f b = 2 * b + c := by
          have h₆ := hc b
          linarith
        have h₆ : f (a + b) = 2 * (a + b) + c := by
          have h₇ := hc (a + b)
          linarith
        have h₇ : f (f (a + b)) = f (2 * (a + b) + c) := by
          rw [h₆]
        have h₈ : f (2 * (a + b) + c) = 2 * (2 * (a + b) + c) + c := by
          have h₉ := hc (2 * (a + b) + c)
          linarith
        have h₉ : f (f (a + b)) = 2 * (2 * (a + b) + c) + c := by
          rw [h₇, h₈]
        have h₁₀ : f (2 * a) + 2 * f b = (2 * (2 * a) + c) + 2 * (2 * b + c) := by
          rw [h₄, h₅]
          <;> ring_nf
        have h₁₁ : (2 * (2 * a) + c) + 2 * (2 * b + c) = 2 * (2 * (a + b) + c) + c := by
          ring_nf
          <;> linarith
        linarith
    exact h₁
  exact ⟨h_imp, h_converse⟩
```


