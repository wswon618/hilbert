        (42 * n) / Nat.gcd (41 * (n : ℤ) + 42) (42 * (n : ℤ)) := sorry
  -- 6. rewrite the hypothesis using h_sum_total
  have h_den_one :
      ((41 * (n : ℤ) + 42) /. (42 * (n : ℤ))).den = 1 := by
    simpa [h_sum_total] using h₁
  -- 7. obtain the equality of the fraction with 1
  have h_eq_one :
      (42 * n) / Nat.gcd (41 * (n : ℤ) + 42) (42 * (n : ℤ)) = 1 := by
    simpa [h_den_simp] using h_den_one
  -- 8. deduce the gcd equals the denominator
  have h_gcd :
