```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem amc12b_2002_p4 (n : ℕ) (h₀ : 0 < n)
    (h₁ : (1 /. 2 + 1 /. 3 + 1 /. 7 + 1 /. ↑n).den = 1) : n = 42 := by
  -- keep the original denominator hypothesis in a convenient name
  have h_den_sum : (1 /. 2 + 1 /. 3 + 1 /. 7 + 1 /. (n : ℚ)).den = 1 := by sorry
  -- compute the sum of the first three fractions
  have h_first_three :
      (1 /. (2 : ℚ) + 1 /. (3 : ℚ) + 1 /. (7 : ℚ)) = (41 : ℚ) / 42 := by sorry
  -- rewrite the whole sum as a single rational fraction
  have h_sum_eq :
      (1 /. (2 : ℚ) + 1 /. (3 : ℚ) + 1 /. (7 : ℚ) + 1 /. (n : ℚ)) =
        ((41 * n + 42 : ℚ) / (42 * n)) := by sorry
  -- deduce that the denominator of this single fraction is 1
  have h_den_one :
      ((41 * n + 42 : ℚ) / (42 * n)).den = 1 := by sorry
  -- the denominator 42·n is non‑zero
  have h_42n_ne_zero : (42 * n) ≠ 0 := by sorry
  -- use the characterisation of denominator = 1 for a quotient of naturals
  have h_div :
      (42 * n) ∣ (41 * n + 42) := by sorry
  -- express the divisibility as an existence of a natural k
  have h_exists_k :
      ∃ k : ℕ, 41 * n + 42 = k * (42 * n) := by sorry
  -- obtain the equation 42 = n * (42 * k - 41)
  have h_eq :
      42 = n * (42 * (Classical.choose h_exists_k) - 41) := by sorry
  -- from the previous equation we see that n divides 42
  have h_n_dvd_42 : n ∣ 42 := by sorry
  -- the only divisor of 42 larger than 0 that satisfies the earlier divisibility
  -- condition is 42 itself
  have h_n_eq_42 : n = 42 := by sorry
  exact h_n_eq_42
```


