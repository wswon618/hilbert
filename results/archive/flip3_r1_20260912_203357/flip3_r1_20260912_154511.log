```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem hmul_numbertheory_fxeq4powxp6powxp9powx_f2powmdvdf2pown (m n : ℕ) (f : ℕ → ℕ)
  (hfxm : f (2 ^ m) = 4 ^ (2 ^ m) + 6 ^ (2 ^ m) + 9 ^ (2 ^ m))
  (hfxn : f (2 ^ n) = 4 ^ (2 ^ n) + 6 ^ (2 ^ n) + 9 ^ (2 ^ n))
  (h4 : 4 ^ (2 ^ n) = (4 ^ (2 ^ m)) ^ (2 ^ (n - m)))
  (h6 : 6 ^ (2 ^ n) = (6 ^ (2 ^ m)) ^ (2 ^ (n - m)))
  (h9 : 9 ^ (2 ^ n) = (9 ^ (2 ^ m)) ^ (2 ^ (n - m))) :
  ∃ k, f (2 ^ n) = f (2 ^ m) * k := by
  classical
  -- rewrite the definitions of `f` at the two powers
  have hfxm' : f (2 ^ m) = 4 ^ (2 ^ m) + 6 ^ (2 ^ m) + 9 ^ (2 ^ m) := by
    simpa using hfxm
  have hfxn' : f (2 ^ n) = 4 ^ (2 ^ n) + 6 ^ (2 ^ n) + 9 ^ (2 ^ n) := by
    simpa using hfxn
  -- each summand at exponent `n` is a power of the corresponding summand at exponent `m`
  have h4div : (4 ^ (2 ^ m)) ∣ (4 ^ (2 ^ n)) := by
    have := Nat.dvd_pow_self (4 ^ (2 ^ m)) (2 ^ (n - m))
    simpa [h4] using this
  have h6div : (6 ^ (2 ^ m)) ∣ (6 ^ (2 ^ n)) := by
    have := Nat.dvd_pow_self (6 ^ (2 ^ m)) (2 ^ (n - m))
    simpa [h6] using this
  have h9div : (9 ^ (2 ^ m)) ∣ (9 ^ (2 ^ n)) := by
    have := Nat.dvd_pow_self (9 ^ (2 ^ m)) (2 ^ (n - m))
    simpa [h9] using this
  -- therefore the whole sum at `m` divides the whole sum at `n`
  have hdiv :
      (4 ^ (2 ^ m) + 6 ^ (2 ^ m) + 9 ^ (2 ^ m)) ∣
        (4 ^ (2 ^ n) + 6 ^ (2 ^ n) + 9 ^ (2 ^ n)) := by
    have h₁ : (4 ^ (2 ^ m) + 6 ^ (2 ^ m)) ∣ (4 ^ (2 ^ n) + 6 ^ (2 ^ n)) :=
      Nat.dvd_add h4div h6div
    have h₂ : (4 ^ (2 ^ m) + 6 ^ (2 ^ m) + 9 ^ (2 ^ m)) ∣
        (4 ^ (2 ^ n) + 6 ^ (2 ^ n) + 9 ^ (2 ^ n)) :=
      Nat.dvd_add h₁ h9div
    exact h₂
  -- turn the divisibility into the required existential statement
  rcases (Nat.exists_eq_mul_left_iff_dvd).mpr hdiv with ⟨k, hk⟩
  refine ⟨k, ?_⟩
  simpa [hfxm', hfxn'] using hk
