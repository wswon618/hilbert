theorem imo_2019_p1 (f : ℤ → ℤ) :
    (∀ a b, f (2 * a) + 2 * f b = f (f (a + b))) ↔
      (∀ z, f z = 0) ∨ ∃ c, ∀ z, f z = 2 * z + c := by
  constructor
  · intro h
    -- 1.  Put `a = 0` in the hypothesis
    have h1 : ∀ b, f (f b) = f 0 + 2 * f b := by
      sorry
    -- 2.  Put `b = 0` and use `h1`
    have h2 : ∀ a, f (2 * a) = f 0 + 2 * f a - 2 * f 0 := by
      sorry
    -- 3.  Derive the additive relation
    have h3 : ∀ a b, f (a + b) = f a + f b - f 0 := by
      sorry
    -- 4.  Rewrite the additive relation in terms of `g z := f z - f 0`
    have h4 : ∀ a b, (f a - f 0) + (f b - f 0) = f (a + b) - f 0 := by
      sorry
    -- 5.  Show that `g` is ℤ‑linear, i.e. `∃ k, ∀ z, f z = k * z + f 0`
    have h5 : ∃ k : ℤ, ∀ z, f z = k * z + f 0 := by
      sorry
    -- 6.  Analyse the possible values of `k`
    have h6 : (∀ z, f z = 0) ∨ ∃ c, ∀ z, f z = 2 * z + c := by
      sorry
    exact h6
  · intro h
    -- 7.  Zero function satisfies the equation
    have h0 : (∀ z, f z = 0) → (∀ a b, f (2 * a) + 2 * f b = f (f (a + b))) := by
      intro hz a b
      have : f (2 * a) = 0 := by
        simpa [hz (2 * a)] using rfl
      have : f b = 0 := by
        simpa [hz b] using rfl
      simpa [hz (2 * a), hz b, hz (a + b)] using rfl
    -- 8.  Linear function `z ↦ 2*z + c` satisfies the equation
    have hlin :
        (∃ c, ∀ z, f z = 2 * z + c) →
          (∀ a b, f (2 * a) + 2 * f b = f (f (a + b))) := by
      rintro ⟨c, hc⟩ a b
      have hfa : f (2 * a) = 2 * (2 * a) + c := by
        simpa [hc (2 * a)]
      have hfb : f b = 2 * b + c := by
        simpa [hc b]
      have hfab : f (a + b) = 2 * (a + b) + c := by
        simpa [hc (a + b)]
      calc
        f (2 * a) + 2 * f b
            = (2 * (2 * a) + c) + 2 * (2 * b + c) := by
              simpa [hfa, hfb]
        _ = 2 * (2 * (a + b) + c) + c := by
              sorry
        _ = f (f (a + b)) := by
              simpa [hc, hfab]
    -- 9.  Finish by case analysis on the assumption `h`
    cases h with
    | inl hzero => exact h0 hzero
    | inr hlin' => exact hlin hlin'
