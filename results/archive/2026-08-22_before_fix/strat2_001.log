import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem mathd_numbertheory_451 (S : Finset ℕ)
    (h₀ :
      ∀ n : ℕ,
        n ∈ S ↔
          2010 ≤ n ∧ n ≤ 2019 ∧ ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n) :
    (∑ k in S, k) = 2016 := by
  -- 1️⃣  Characterise numbers whose divisor set has exactly four elements
  have h_four_divisors :
      ∀ m : ℕ,
        (Nat.divisors m).card = 4 →
          (∃ p, Nat.Prime p ∧ m = p ^ 3) ∨
          (∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p ≠ q ∧ m = p * q) := by sorry
  -- 2️⃣  A prime‑cube cannot give a sum in the interval [2010,2019]
  have h_no_cube :
      ∀ p : ℕ,
        Nat.Prime p →
        ¬ (2010 ≤ 1 + p + p ^ 2 + p ^ 3 ∧ 1 + p + p ^ 2 + p ^ 3 ≤ 2019) := by sorry
  -- 3️⃣  Sum of divisors of a product of two distinct primes
  have h_sum_two_primes :
      ∀ p q : ℕ,
        Nat.Prime p → Nat.Prime q → p ≠ q →
          (∑ d in Nat.divisors (p * q), d) = (p + 1) * (q + 1) := by sorry
  -- 4️⃣  The only n ∈ [2010,2019] of the form (p+1)(q+1) with p,q prime, p≠q, is 2016
  have h_unique_n :
      ∀ n : ℕ,
        2010 ≤ n ∧ n ≤ 2019 →
          (∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p ≠ q ∧ (p + 1) * (q + 1) = n) →
          n = 2016 := by sorry
  -- 5️⃣  Using the defining condition h₀, show that S = {2016}
  have h_mem_S :
      ∀ n : ℕ,
        n ∈ S ↔ n = 2016 := by sorry
  -- 6️⃣  Compute the sum over S, which now is a singleton {2016}
  have h_sum_S : (∑ k in S, k) = 2016 := by sorry
  exact h_sum_S
```


