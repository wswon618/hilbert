    (h₀ :
      ∀ n : ℕ,
        n ∈ S ↔
          2010 ≤ n ∧ n ≤ 2019 ∧ ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n) :
    (∑ k in S, k) = 2016 := by
  -- elements of `S` lie in the interval `[2010,2019]`
  have h_range :
      ∀ n ∈ S, 2010 ≤ n ∧ n ≤ 2019 := by
    intro n hn
    have h := (h₀ n).mp hn
    exact h.1
  -- each element of `S` is a divisor‑sum of a number with exactly four divisors
  have h_exists :
