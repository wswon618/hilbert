import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem mathd_numberory_451 (S : Finset ℕ)
    (h₀ :
      ∀ n : ℕ,
        n ∈ S ↔
          2010 ≤ n ∧ n ≤ 2019 ∧ ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n) :
    (∑ k in S, k) = 2016 := by
  -- every element of `S` satisfies the range condition
  have h_range : ∀ n, n ∈ S → 2010 ≤ n ∧ n ≤ 2019 := by sorry
  -- every element of `S` can be written as a sum of four divisors of some `m`
  have h_exists_m : ∀ n, n ∈ S → ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n := by sorry
  -- classification of numbers with exactly four divisors
  have h_four_divisors :
      ∀ m, (Nat.divisors m).card = 4 →
        (∃ p, p.Prime ∧ m = p ^ 3) ∨ (∃ p q, p.Prime ∧ q.Prime ∧ p ≠ q ∧ m = p * q) := by sorry
  -- sum of divisors for a prime cube
  have h_sum_prime_cube :
      ∀ p, p.Prime → (∑ d in Nat.divisors (p ^ 3), d) = 1 + p + p ^ 2 + p ^ 3 := by sorry
  -- sum of divisors for a product of two distinct primes
  have h_sum_two_primes :
      ∀ p q, p.Prime → q.Prime → p ≠ q →
        (∑ d in Nat.divisors (p * q), d) = (p + 1) * (q + 1) := by sorry
  -- no prime cube yields a sum in the interval [2010,2019]
  have h_no_cube_in_range :
      ∀ p, p.Prime → ¬ (2010 ≤ 1 + p + p ^ 2 + p ^ 3 ∧ 1 + p + p ^ 2 + p ^ 3 ≤ 2019) := by sorry
  -- the only product of (p+1)(q+1) in the interval is 2016 with p=41, q=47
  have h_unique_product :
      ∃ p q, p.Prime ∧ q.Prime ∧ p ≠ q ∧ (p + 1) * (q + 1) = 2016 ∧
        (∑ d in Nat.divisors (p * q), d) = 2016 := by sorry
  -- 2016 belongs to `S`
  have h_mem_2016 : 2016 ∈ S := by sorry
  -- every element of `S` equals 2016
  have h_all_eq_2016 : ∀ n ∈ S, n = 2016 := by sorry
  -- deduce that `S` is the singleton `{2016}`
  have hS_eq : S = {2016} := by sorry
  -- compute the sum over the singleton finset
  simpa [hS_eq] using rfl
