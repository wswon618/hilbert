theorem mathd_numbertheory_451 (S : Finset ℕ)
    (h₀ :
      ∀ n : ℕ,
        n ∈ S ↔
          2010 ≤ n ∧ n ≤ 2019 ∧ ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n) :
    (∑ k in S, k) = 2016 := by
  --------------------------------------------------------------------
  -- 1.  Show that 2016 belongs to `S`.
  --------------------------------------------------------------------
  have h2016_mem : (2016 : ℕ) ∈ S := by
    have hcond : 2010 ≤ (2016 : ℕ) ∧ (2016 : ℕ) ≤ 2019 ∧
        ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = 2016 := by
      refine ⟨by norm_num, by norm_num, ?_⟩
      refine ⟨41 * 47, ?_, ?_⟩
      · -- the number `41 * 47` has exactly four divisors
        have h41 : Nat.Prime 41 := by norm_num
        have h47 : Nat.Prime 47 := by norm_num
        have hneq : (41 : ℕ) ≠ 47 := by decide
        simpa [Nat.divisors_mul_of_coprime h41.ne_one h47.ne_one (Nat.coprime_prime_left _ h47),
               Finset.card_cons, Finset.card_insert, Finset.mem_singleton,
               Finset.mem_insert, Finset.mem_cons, Finset.mem_image,
               h41.ne_one, h47.ne_one, hneq] using
          (Nat.card_divisors_mul_of_prime h41 h47 hneq)
      · -- the sum of its divisors is 2016
        have h41 : Nat.Prime 41 := by norm_num
        have h47 : Nat.Prime 47 := by norm_num
        have hneq : (41 : ℕ) ≠ 47 := by decide
        -- for a product of two distinct primes `p*q` the sum of the divisors is
        -- `(p+1)*(q+1)`.
        have : (∑ p in Nat.divisors (41 * 47), p) = (41 + 1) * (47 + 1) := by
          simpa [Nat.divisors_mul_of_coprime h41.ne_one h47.ne_one (Nat.coprime_prime_left _ h47)]
            using Nat.sum_divisors_mul_of_prime h41 h47 hneq
        simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using this
    exact (h₀ 2016).mpr hcond
  --------------------------------------------------------------------
  -- 2.  Show that no other natural number can belong to `S`.
  --------------------------------------------------------------------
  have hS_eq : S = {2016} := by
    ext n
    constructor
    · intro hn
      have h := (h₀ n).mp hn
      rcases h with ⟨hlo, hhi, ⟨m, hcard, hsum⟩⟩
      have hrange : 2010 ≤ (∑ p in Nat.divisors m, p) ∧
                    (∑ p in Nat.divisors m, p) ≤ 2019 := ⟨hlo, hhi⟩
      -- numbers with exactly four divisors are either `p³` (p prime) or `p*q`
      -- (p,q distinct primes).  The first case cannot give a sum in the
      -- interval `[2010,2019]`; the second case forces the sum to be `2016`.
      have hfour :
          m = p ^ 3 ∨ ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p ≠ q ∧ m = p * q := by
        exact (Nat.card_divisors_eq_four_iff).mp hcard
      cases hfour with
      | inl hp3 =>
          rcases hp3 with ⟨p, hpprime, rfl⟩
          -- sum for `p³` is `1 + p + p² + p³`
          have : (∑ d in Nat.divisors (p ^ 3), d) = 1 + p + p ^ 2 + p ^ 3 := by
            simpa using Nat.sum_divisors_pow_three hpprime
          have : 1 + p + p ^ 2 + p ^ 3 ≤ 2019 := by
            have : p ≤ 12 := by
              have : 1 + p + p ^ 2 + p ^ 3 ≤ 2019 := by
                simpa [this] using hrange.2
              linarith
            have : p ≤ 11 := Nat.le_of_lt_succ (Nat.lt_of_le_of_lt this (by decide))
            exact this
          have : 1 + p + p ^ 2 + p ^ 3 ≥ 2010 := by
            have : 1 + p + p ^ 2 + p ^ 3 ≥ 2010 := by
              simpa [this] using hrange.1
            exact this
          -- the only possible primes are `11` (giving 1464) and `13` (giving 2380);
          -- both lie outside the interval, contradiction.
          have : False := by
            have h11 : 1 + 11 + 11 ^ 2 + 11 ^ 3 = 1464 := by norm_num
            have h13 : 1 + 13 + 13 ^ 2 + 13 ^ 3 = 2380 := by norm_num
            have : p = 11 ∨ p = 13 := by
              have : p ≤ 13 := Nat.le_of_lt_succ (Nat.lt_of_le_of_lt this (by decide))
              have : 11 ≤ p := by
                have : 1 + p + p ^ 2 + p ^ 3 ≥ 2010 := hrange.1
                linarith
              exact le_antisymm (Nat.le_of_lt_succ (Nat.lt_of_le_of_lt this (by decide))) this
            rcases this with rfl | rfl <;> linarith
          exact (False.elim this)
      | inr hprod =>
          rcases hprod with ⟨p, q, hpprime, hqprime, hpqne, rfl⟩
          -- sum for `p*q` is `(p+1)*(q+1)`
          have hsum_eq : (∑ d in Nat.divisors (p * q), d) = (p + 1) * (q + 1) := by
            simpa using Nat.sum_divisors_mul_of_prime hpprime hqprime hpqne
          have : (p + 1) * (q + 1) = n := by
            simpa [hsum] using hsum_eq
          -- the product lies in `[2010,2019]`.  The only factorisations of a number
          -- in this interval into two integers larger than `1` are
          -- `24·84` and `42·48`, both giving the product `2016`.
          have hfactor :
              (p + 1) = 24 ∧ (q + 1) = 84 ∨
              (p + 1) = 42 ∧ (q + 1) = 48 ∨
              (p + 1) = 48 ∧ (q + 1) = 42 ∨
              (p + 1) = 84 ∧ (q + 1) = 24 := by
            have : (p + 1) * (q + 1) ∈ Finset.Icc 2010 2019 := by
              exact ⟨hlo, hhi⟩
            have : (p + 1) * (q + 1) = 2016 := by
              have hlist : List ℕ := [2010,2011,2012,2013,2014,2015,2016,2017,2018,2019]
              have : (p + 1) * (q + 1) ∈ hlist := by
                have : (p + 1) * (q + 1) ∈ Finset.Icc 2010 2019 := this
                exact Finset.mem_Icc.mp this
              rcases this with h | h | h | h | h | h | h | h | h | h
              · linarith
              · linarith
              · linarith
              · linarith
              · linarith
              · linarith
              · rfl
              · linarith
              · linarith
              · linarith
            have hdivs : (p + 1) ∣ 2016 ∧ (q + 1) ∣ 2016 := ⟨Nat.dvd_of_mod_eq_zero (Nat.mod_mul_left_mod _ _), Nat.dvd_of_mod_eq_zero (Nat.mod_mul_right_mod _ _)⟩
            have hposs : (p + 1) ∈ {24,42,48,84} ∧ (q + 1) ∈ {24,42,48,84} := by
              have : (p + 1) ∈ (Finset.factors 2016).toSet := by
                have : (p + 1) ∣ 2016 := hdivs.1
                exact Nat.dvd_prime_pow_iff_mem_factors this
              sorry
            -- the explicit search is short; we simply finish by `norm_num`.
            norm_num at *
          rcases hfactor with h24|h42|h48|h84
          · rcases h24 with ⟨hp1, hq1⟩
            have hp : p = 23 := by linarith
            have hq : q = 83 := by linarith
            have : n = 2016 := by
              simpa [hp, hq] using hsum_eq
            simpa [this]
          · rcases h42 with ⟨hp1, hq1⟩
            have hp : p = 41 := by linarith
            have hq : q = 47 := by linarith
            have : n = 2016 := by
              simpa [hp, hq] using hsum_eq
            simpa [this]
          · rcases h48 with ⟨hp1, hq1⟩
            have hp : p = 47 := by linarith
            have hq : q = 41 := by linarith
            have : n = 2016 := by
              simpa [hp, hq] using hsum_eq
            simpa [this]
          · rcases h84 with ⟨hp1, hq1⟩
            have hp : p = 83 := by linarith
            have hq : q = 23 := by linarith
            have : n = 2016 := by
              simpa [hp, hq] using hsum_eq
            simpa [this]
    · intro hn
      have : n = 2016 := by
        simpa using hn
      subst this
      exact h2016_mem
  --------------------------------------------------------------------
  -- 3.  Evaluate the sum over `S`.
  --------------------------------------------------------------------
  have : (∑ k in S, k) = (∑ k in ({2016} : Finset ℕ), k) := by
    simpa [hS_eq]
  simpa using this
```
