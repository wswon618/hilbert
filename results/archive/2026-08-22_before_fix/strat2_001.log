import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem mathd_numbertheory_451 (S : Finset ℕ)
    (h₀ :
      ∀ n : ℕ,
        n ∈ S ↔
          2010 ≤ n ∧ n ≤ 2019 ∧ ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n) :
    (∑ k in S, k) = 2016 := by
  -- elements of `S` lie in the interval `[2010,2019]`
  have h_range :
      ∀ n ∈ S, 2010 ≤ n ∧ n ≤ 2019 := by sorry
  -- each element of `S` is a divisor‑sum of a number with exactly four divisors
  have h_exists :
      ∀ n ∈ S, ∃ m, (Nat.divisors m).card = 4 ∧ (∑ p in Nat.divisors m, p) = n := by sorry
  -- classification of numbers having exactly four divisors
  have h_four_divisors :
      ∀ m, (Nat.divisors m).card = 4 →
        (∃ p, Nat.Prime p ∧ m = p ^ 3) ∨
        (∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p ≠ q ∧ m = p * q) := by sorry
  -- sum of divisors for a product of two distinct primes
  have h_sum_two_primes :
      ∀ p q, Nat.Prime p → Nat.Prime q → p ≠ q →
        (∑ d in Nat.divisors (p * q), d) = (p + 1) * (q + 1) := by sorry
  -- sum of divisors for a prime cube
  have h_sum_prime_cube :
      ∀ p, Nat.Prime p →
        (∑ d in Nat.divisors (p ^ 3), d) = 1 + p + p ^ 2 + p ^ 3 := by sorry
  -- no prime cube yields a sum inside the required interval
  have h_no_cube_in_interval :
      ∀ p, Nat.Prime p →
        ¬ (2010 ≤ (1 + p + p ^ 2 + p ^ 3) ∧ (1 + p + p ^ 2 + p ^ 3) ≤ 2019) := by sorry
  -- the only pair of distinct primes giving a sum in the interval is `{3,503}`
  have h_only_3_503 :
      ∀ p q, Nat.Prime p → Nat.Prime q → p ≠ q →
        (2010 ≤ (p + 1) * (q + 1) ∧ (p + 1) * (q + 1) ≤ 2019) →
        (p = 3 ∧ q = 503) ∨ (p = 503 ∧ q = 3) := by sorry
  -- every element of `S` equals `2016`
  have h_elem_eq_2016 :
      ∀ n ∈ S, n = 2016 := by sorry
  -- the finset `S` is exactly `{2016}`
  have h_S_eq : S = {2016} := by sorry
  -- compute the required sum
  simpa [h_S_eq] using (by
    simp )
