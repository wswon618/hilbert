      -- Chain the equivalences
      have h₅ : Even (d (5 + 7 * m.succ)) ↔ Even (d 5) := by
        calc
          Even (d (5 + 7 * m.succ)) ↔ Even (d (5 + 7 * m)) := h₁
          _ ↔ Even (d 5) := h₄
      exact h₅
  
