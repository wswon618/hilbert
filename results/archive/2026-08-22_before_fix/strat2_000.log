theorem amc12a_2021_p8 (d : ℕ → ℕ) (h₀ : d 0 = 0) (h₁ : d 1 = 0) (h₂ : d 2 = 1)
    (h₃ : ∀ n ≥ 3, d n = d (n - 1) + d (n - 3)) :
    Even (d 2021) ∧ Odd (d 2022) ∧ Even (d 2023) := by
  -- parity recurrence obtained from the defining recurrence
  have h_even_rec (n : ℕ) (hn : n ≥ 3) :
      Even (d n) ↔ (Even (d (n - 1)) ↔ Even (d (n - 3))) := sorry
  -- base parities
  have h_even0 : Even (d 0) := by
    simpa [h₀] using (Nat.even_zero)
  have h_even1 : Even (d 1) := by
    simpa [h₁] using (Nat.even_zero)
  have h_odd2 : Odd (d 2) := by
    have : d 2 = 1 := h₂
    simpa [this] using (Nat.odd_one)
  -- parity for n = 3
  have h_even3 : Even (d 3) ↔ False := sorry
  have h_odd3 : Odd (d 3) := by
    have : Even (d 3) ↔ False := h_even3
    sorry
  -- parity for n = 4
  have h_even4 : Even (d 4) ↔ False := sorry
  have h_odd4 : Odd (d 4) := by
    sorry
  -- parity for n = 5
  have h_even5 : Even (d 5) := sorry
  have h_odd5 : Odd (d 5) ↔ False := sorry
  -- parity for n = 6
  have h_even6 : Even (d 6) ↔ False := sorry
  have h_odd6 : Odd (d 6) := by
    sorry
  -- period‑7 for evenness
  have h_period_even (n : ℕ) : Even (d (n + 7)) ↔ Even (d n) := sorry
  -- arithmetic facts about the indices
  have h_mod2021 : 2021 = 7 * 288 + 5 := by norm_num
  have h_mod2022 : 2022 = 7 * 288 + 6 := by norm_num
  have h_mod2023 : 2023 = 7 * 288 + 7 := by norm_num
  -- reduce large indices using the period
  have h_even2021 : Even (d 2021) ↔ Even (d 5) := by
    have := h_period_even 5
    simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc, h_mod2021] using this
  have h_even2022 : Even (d 2022) ↔ Even (d 6) := by
    have := h_period_even 6
    simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc, h_mod2022] using this
  have h_even2023 : Even (d 2023) ↔ Even (d 0) := by
    have := h_period_even 0
    simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc, h_mod2023] using this
  -- obtain the required parities from the reduced ones
  have h_res2021 : Even (d 2021) := by
    have : Even (d 5) := h_even5
    exact (h_even2021).mpr this
  have h_not_even2022 : ¬Even (d 2022) := by
    intro hE
    have hE6 : Even (d 6) := (h_even2022).mp hE
    have h_notE6 : ¬Even (d 6) := by
      have := (Nat.odd_iff_not_even (d 6)).mp h_odd6
      exact this
    exact h_notE6 hE6
  have h_res2022 : Odd (d 2022) := by
    exact (Nat.odd_iff_not_even (d 2022)).mpr h_not_even2022
  have h_res2023 : Even (d 2023) := by
    have : Even (d 0) := h_even0
    exact (h_even2023).mpr this
  exact ⟨h_res2021, h_res2022, h_res2023⟩
```
