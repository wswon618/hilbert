```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem hdisj_imo_2019_p1 (f : ℤ → ℤ)
    (h : ∀ a b : ℤ, f (2 * a) + 2 * f b = f (f (a + b))) :
    ∀ z : ℤ, f z = 0 ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
  classical
  --------------------------------------------------------------------
  -- 1.  Extract the constant `c = f 0` and rewrite the equation.
  --------------------------------------------------------------------
  let c : ℤ := f 0
  have hfa (a : ℤ) : f (f a) = c + 2 * f a := by
    have := h 0 a
    simpa [c, zero_mul, add_comm, add_left_comm, add_assoc,
      mul_comm, mul_left_comm, mul_assoc] using this
  have hfb (a : ℤ) : f (2 * a) = 2 * f a - c := by
    have h1 := h a 0
    have h1' : f (2 * a) + 2 * c = f (f a) := by
      simpa [c] using h1
    have : f (2 * a) + 2 * c = c + 2 * f a := by
      simpa [hfa a] using h1'
    linarith
  --------------------------------------------------------------------
  -- 2.  Define `g x = f x - c`.  Show that `g` is additive.
  --------------------------------------------------------------------
  let g : ℤ → ℤ := fun x => f x - c
  have hg0 : g 0 = 0 := by
    dsimp [g, c]; simp
  have hg2 (a : ℤ) : g (2 * a) = 2 * g a := by
    dsimp [g] at *
    have := hfb a
    dsimp [c] at this
    have : f (2 * a) - c = 2 * f a - 2 * c := by linarith
    simpa [g, sub_eq, sub_eq_add_neg] using this
  have hadd (a b : ℤ) : g (a + b) = g a + g b := by
    have h1 := h a b
    have h1' : g (2 * a) + 2 * g b = 2 * g (a + b) := by
      dsimp [g] at *
      simpa [c, mul_add, add_comm, add_left_comm, add_assoc,
        two_mul, add_mul, sub_eq, sub_eq_add_neg] using h1
    have : 2 * g a + 2 * g b = 2 * g (a + b) := by
      simpa [hg2 a] using h1'
    linarith
  --------------------------------------------------------------------
  -- 3.  Turn `g` into an additive homomorphism and obtain a linear
  --     description `f n = m * n + c`.
  --------------------------------------------------------------------
  let φ : ℤ →+ ℤ :=
    { toFun := g,
      map_zero' := hg0,
      map_add' := hadd }
  have hlin (n : ℤ) : g n = n * g 1 := by
    have := φ.map_zsmul n 1
    simpa [zsmul_eq_mul] using this
  have hform (n : ℤ) : f n = (g 1) * n + c := by
    dsimp [g] at *
    have := hlin n
    simpa [c, mul_comm, add_comm, add_left_comm, add_assoc] using this
  set m : ℤ := g 1 with hmdef
  --------------------------------------------------------------------
  -- 4.  A relation between `m` and `c` coming from `a = b = 0`.
  --------------------------------------------------------------------
  have h00 : (m - 2) * c = 0 := by
    have := h 0 0
    simpa [hform, hmdef, two_mul, mul_add, add_comm, add_left_comm,
      add_assoc, mul_comm, mul_left_comm, mul_assoc] using this
  --------------------------------------------------------------------
  -- 5.  Split according to whether `c = 0`.
  --------------------------------------------------------------------
  by_cases hc : c = 0
  · -- 5a.  `c = 0`.  Then `f n = m * n`.  From the functional equation we get
    --      `m = 0` or `m = 2`.
    have hfc : ∀ n : ℤ, f n = m * n := by
      intro n
      have := hform n
      simpa [hc, zero_mul, add_zero] using this
    have hm : m = 0 ∨ m = 2 := by
      have : (2 : ℤ) * m = m * m := by
        have := h 1 0
        simpa [hfc, hmdef, two_mul, mul_add, add_comm, add_left_comm,
          add_assoc, mul_comm, mul_left_comm, mul_assoc] using this
      have : m * (m - 2) = 0 := by
        have : m * m - 2 * m = 0 := by linarith
        simpa [mul_sub, sub_eq, sub_eq_add_neg] using this
      rcases mul_eq_zero.mp this with h0 | h2
      · left; exact h0
      · right; have : m = 2 := by linarith; exact this
    intro z
    cases hm with
    | inl h0m =>
        left
        have : f z = 0 := by simpa [hfc, h0m] using rfl
        exact this
    | inr h2m =>
        right
        refine ⟨0, ?_⟩
        intro z
        have : f z = 2 * z := by simpa [hfc, h2m, two_mul, mul_comm] using rfl
        simpa [two_mul, mul_comm] using this
  · -- 5b.  `c ≠ 0`.  From `(m-2)*c = 0` we obtain `m = 2`, and the required
    --      affine form follows.
    have hm2 : m = 2 := by
      rcases mul_eq_zero.mp h00 with h' | h'
      · exfalso; exact hc h'
      · simpa using h'
    intro z
    right
    refine ⟨c, ?_⟩
    intro z
    have := hform z
    simpa [hmdef, hm2, two_mul, mul_comm] using this
