import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_step_induction_nfactltnexpnm1ngt3 :
    ∀ n, 3 ≤ n → n ! < n ^ (n - 1) → (n + 1) ! < (n + 1) ^ n := by
  intro n hn hlt
  -- rewrite the factorial of `n+1`
  rw [Nat.factorial_succ]
  -- multiply the hypothesis by `n+1`
  have hmul : (n + 1) * n ! < (n + 1) * n ^ (n - 1) :=
    Nat.mul_lt_mul_left (Nat.succ_pos _) hlt
  -- show that the right‑hand side is bounded by `(n+1)^n`
  have hle : (n + 1) * n ^ (n - 1) ≤ (n + 1) ^ n := by
    have hpow_le : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) :=
      Nat.pow_le_pow_of_le_left (Nat.le_succ n) _
    have := Nat.mul_le_mul_left (n + 1) hpow_le
    simpa [Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using this
  exact Nat.lt_of_lt_of_le hmul hle
