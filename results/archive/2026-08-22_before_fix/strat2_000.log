open BigOperators Real Nat Topology Rat

theorem h_final_h_step_induction_nfactltnexpnm1ngt3 (n : Nat) (hnle : 3 ≤ n)
    (hlt : n ! < n ^ (n - 1)) : (n + 1)! < (n + 1) ^ n := by
