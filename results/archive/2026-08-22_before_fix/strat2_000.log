import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_final_h_step_induction_nfactltnexpnm1ngt3 (n : Nat) (hnle : 3 ≤ n) (hlt : n ! < n ^ (n - 1)) :
    (n + 1)! < (n + 1) ^ n := by
  -- we will need the fact that `1 ≤ n`
  have h_one_le : (1 : Nat) ≤ n := le_trans (Nat.succ_le_of_lt (Nat.zero_lt_one)) hnle
  calc
    (n + 1)! = (n + 1) * n ! := by
      simpa using Nat.factorial_succ n
    _ < (n + 1) * n ^ (n - 1) := by
      exact Nat.mul_lt_mul_left (Nat.succ_pos n) hlt
    _ ≤ (n + 1) * (n + 1) ^ (n - 1) := by
      have hpowle : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) :=
        Nat.pow_le_pow_of_le_left (Nat.le_succ n) _
      exact Nat.mul_le_mul_left (Nat.succ_pos n) hpowle
    _ = (n + 1) ^ n := by
      have h := (Nat.pow_succ (n + 1) (n - 1)).symm
      simpa [Nat.sub_add_cancel h_one_le, Nat.mul_comm] using h
