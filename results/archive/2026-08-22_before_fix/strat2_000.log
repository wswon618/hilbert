theorem hlin_imo_2019_p1 {f : ℤ → ℤ} {k : ℤ}
    (hk : ∀ a : ℤ, f (2 * a) = 2 * f a + k)
    (hk0 : k ≠ 0) :
    ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
  have h_f_zero : f 0 = -k := by
    have h1 := hk 0
    have h2 : f (2 * 0) = 2 * f 0 + k := h1
    have h3 : f 0 = 2 * f 0 + k := by simpa using h2
    have h4 : f 0 = -k := by linarith
    exact h4
  
  have h_main : ∃ (c : ℤ), ∀ (z : ℤ), f z = 2 * z + c := by
    use -k
    intro z
    have h₁ : ∀ n : ℕ, ∀ (a : ℤ), f (2 ^ n * a) = 2 ^ n * f a + (2 ^ n - 1) * k := by
      intro n
      induction n with
      | zero =>
        intro a
