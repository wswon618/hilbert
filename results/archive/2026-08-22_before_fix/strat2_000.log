        have h₃ : ∃ z : ℤ, f z ≠ 0 := by
          by_contra h₄
          push_neg at h₄
          have h₅ : ∀ z : ℤ, f z = 0 := by simpa using h₄
          exact h₂ h₅
        obtain ⟨z₀, hz₀⟩ := h₃
        use f 1 - 2 * 1
        intro z
        have h₄ := h_f_two_z z
        have h₅ := h_f_two_z 0
        have h₆ := h_f_two_z 1
        have h₇ := h_f_two_z (-1)
        have h₈ := h_f_symm z
        have h₉ := h_f_symm 0
        have h₁₀ := h_f_symm 1
        have h₁₁ := h_f_symm (-1)
        have h₁₂ := h 0 0
        have h₁₃ := h 1 0
        have h₁₄ := h 0 1
        have h₁₅ := h 1 1
        have h₁₆ := h (-1) 0
        have h₁₇ := h 0 (-1)
        have h₁₈ := h 1 (-1)
        have h₁₉ := h (-1) 1
        ring_nf at h₄ h₅ h₆ h₇ h₈ h₉ h₁₀ h₁₁ h₁₂ h₁₃ h₁₄ h₁₅ h₁₆ h₁₇ h₁₈ h₁₉ ⊢
        have h₂₀ : f z = 2 * z := by
          have h₂₁ := h_f_two_z z
          have h₂₂ := h_f_two_z 0
          have h₂₃ := h_f_two_z 1
          have h₂₄ := h_f_two_z (-1)
          have h₂₅ := h_f_symm z
          have h₂₆ := h_f_symm 0
          have h₂₇ := h_f_symm 1
          have h₂₈ := h_f_symm (-1)
          ring_nf at h₂₁ h₂₂ h₂₃ h₂₄ h₂₅ h₂₆ h₂₇ h₂₈ ⊢
          have h₂₉ := h 0 z
          have h₃₀ := h z 0
          have h₃₁ := h z z
          have h₃₂ := h (-z) 0
          have h₃₃ := h 0 (-z)
          have h₃₄ := h z (-z)
          have h₃₅ := h (-z) z
          ring_nf at h₂₉ h₃₀ h₃₁ h₃₂ h₃₃ h₃₄ h₃₅ ⊢
          nlinarith [h_f_zero, h_f_two_z z, h_f_two_z 0, h_f_two_z 1, h_f_two_z (-1),
            h_f_symm z, h_f_symm 0, h_f_symm 1, h_f_symm (-1)]
        linarith
    | inr h₁ =>
      -- Case: There exists c such that f(z) = 2z + c for all z
      obtain ⟨c, hc⟩ := h₁
      right
      exact ⟨c, hc⟩
  
  exact h_main
