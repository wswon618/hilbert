theorem induction_nfactltnexpnm1ngt3 (n : ℕ) (h₀ : 3 ≤ n) : n ! < n ^ (n - 1) := by
  -- base case: the inequality holds for n = 3
  have h_base : (3 : ℕ) ! < (3 : ℕ) ^ (3 - 1) := by
    sorry

  -- induction step: from n to n+1
  have h_step :
      ∀ n, 3 ≤ n → n ! < n ^ (n - 1) → (n + 1) ! < (n + 1) ^ n := by
    intro n hn hih
    -- multiply the induction hypothesis by the positive factor (n+1)
    have h_mul_lt : (n + 1) * n ! < (n + 1) * n ^ (n - 1) := by
      sorry
    -- compare the right‑hand side with (n+1)^n
    have h_pow_le : (n + 1) * n ^ (n - 1) ≤ (n + 1) ^ n := by
      sorry
    -- combine the two inequalities to obtain the desired result for n+1
    have h_succ : (n + 1)! < (n + 1) ^ n := by
      sorry
    exact h_succ

  -- prove the statement for all n ≥ 3 by iterating the step starting from the base
  have h_all : ∀ n, 3 ≤ n → n ! < n ^ (n - 1) := by
    intro n hn
    have h_cases : n = 3 ∨ ∃ k, n = k + 1 ∧ 3 ≤ k := by
      sorry
    cases h_cases with
    | inl h_eq =>
        simpa [h_eq] using h_base
    | inr h_ex =>
        rcases h_ex with ⟨k, hk_eq, hk_le⟩
        have hk_prop : k ! < k ^ (k - 1) := h_all k hk_le
        have hk_succ : (k + 1)! < (k + 1) ^ k := h_step k hk_le hk_prop
        simpa [hk_eq] using hk_succ

  exact h_all n h₀
