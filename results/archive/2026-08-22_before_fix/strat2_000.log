import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem hdisj_imo_2019_p1 (f : ℤ → ℤ)
    (h : ∀ a b : ℤ, f (2 * a) + 2 * f b = f (f (a + b))) :
    ∀ z : ℤ, f z = 0 ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
  have h_f_zero : 3 * f 0 = f (f 0) := by
    have h₁ := h 0 0
    ring_nf at h₁ ⊢
    linarith
  
  have h_f_two_z : ∀ (z : ℤ), f (2 * z) = 2 * f z - f 0 := by
    intro z
    have h₁ := h z 0
    have h₂ := h 0 z
    have h₃ : f (2 * z) + 2 * f 0 = f (f z) := by
      ring_nf at h₁ ⊢
      linarith
    have h₄ : f 0 + 2 * f z = f (f z) := by
      ring_nf at h₂ ⊢
      linarith
    have h₅ : f (2 * z) + 2 * f 0 = f 0 + 2 * f z := by linarith
    linarith
  
  have h_f_symm : ∀ (z : ℤ), f z + f (-z) = 2 * f 0 := by
    intro z
    have h₁ := h z (-z)
    have h₂ := h_f_two_z z
    have h₃ := h_f_two_z (-z)
    have h₄ : f (2 * z) + 2 * f (-z) = f (f 0) := by
      have h₅ := h₁
      ring_nf at h₅ ⊢
      <;> linarith
    have h₅ : f (f 0) = 3 * f 0 := by linarith [h_f_zero]
    have h₆ : f (2 * z) + 2 * f (-z) = 3 * f 0 := by linarith
    have h₇ : (2 * f z - f 0) + 2 * f (-z) = 3 * f 0 := by
      linarith [h_f_two_z z]
    linarith
  
  have h_main : ∀ z : ℤ, f z = 0 ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
    have h₁ : f 0 = 0 ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
      by_cases h₂ : f 0 = 0
      · -- Case: f(0) = 0
        exact Or.inl h₂
      · -- Case: f(0) ≠ 0
        right
        use f 0
        intro z
        have h₃ := h_f_two_z z
        have h₄ := h_f_two_z 0
        have h₅ := h_f_two_z 1
        have h₆ := h_f_two_z (-1)
        have h₇ := h_f_two_z (z / 2)
        have h₈ := h_f_two_z (z / 2 + 1)
        have h₉ := h_f_two_z (z / 2 - 1)
        have h₁₀ := h_f_symm z
        have h₁₁ := h_f_symm 0
        have h₁₂ := h_f_symm 1
        have h₁₃ := h_f_symm (-1)
        have h₁₄ := h 0 0
        have h₁₅ := h 1 0
        have h₁₆ := h 0 1
        have h₁₇ := h 1 1
        have h₁₈ := h (-1) 0
        have h₁₉ := h 0 (-1)
        have h₂₀ := h 1 (-1)
        have h₂₁ := h (-1) 1
        -- Normalize the expressions to simplify the equations
        ring_nf at h₃ h₄ h₅ h₆ h₇ h₈ h₉ h₁₀ h₁₁ h₁₂ h₁₃ h₁₄ h₁₅ h₁₆ h₁₇ h₁₈ h₁₉ h₂₀ h₂₁ ⊢
        -- Use the simplified equations to solve for f(z)
        have h₂₂ : f z = 2 * z + f 0 := by
          -- Use the fact that f(2z) = 2f(z) - f(0) and other derived equations to solve for f(z)
          have h₂₃ := h_f_two_z z
          have h₂₄ := h_f_two_z (z / 2)
          have h₂₅ := h_f_two_z (z / 2 + 1)
          have h₂₆ := h_f_two_z (z / 2 - 1)
          have h₂₇ := h_f_symm z
          have h₂₈ := h_f_symm 0
          have h₂₉ := h_f_symm 1
          have h₃₀ := h_f_symm (-1)
          -- Normalize the expressions again to simplify further
          ring_nf at h₂₃ h₂₄ h₂₅ h₂₆ h₂₇ h₂₈ h₂₉ h₃₀ ⊢
          -- Use the fact that f(0) ≠ 0 to solve for f(z)
          have h₃₁ : f 0 ≠ 0 := h₂
          -- Use the derived equations to solve for f(z)
          have h₃₂ : f z = 2 * z + f 0 := by
            -- Use the fact that f(2z) = 2f(z) - f(0) and other derived equations to solve for f(z)
            have h₃₃ := h 0 z
            have h₃₄ := h z 0
            have h₃₅ := h z z
            have h₃₆ := h (-z) 0
            have h₃₇ := h 0 (-z)
            have h₃₈ := h z (-z)
            have h₃₉ := h (-z) z
            ring_nf at h₃₃ h₃₄ h₃₅ h₃₆ h₃₇ h₃₈ h₃₉ ⊢
            -- Use the simplified equations to solve for f(z)
            nlinarith [h_f_zero, h_f_two_z z, h_f_two_z 0, h_f_two_z 1, h_f_two_z (-1),
              h_f_symm z, h_f_symm 0, h_f_symm 1, h_f_symm (-1)]
          exact h₃₂
        linarith
    intro z
    cases h₁ with
    | inl h₁ =>
      -- Case: f(0) = 0
      by_cases h₂ : ∀ z : ℤ, f z = 0
      · -- Subcase: f(z) = 0 for all z
        exact Or.inl (h₂ z)
      · -- Subcase: There exists z such that f(z) ≠ 0
