    have h₂₀₂₁₁ : d 2021 % 2 = d 5 % 2 := by
      have h₂₀₂₁₂ : ∀ k : ℕ, d (7 * k + 5) % 2 = d 5 % 2 := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          have h₂₀₂₁₃ := h_periodic (7 * k + 5)
          have h₂₀₂₁₄ := h_periodic (7 * k + 5 + 7)
          simp [Nat.mul_add, Nat.add_mul, Nat.add_assoc] at h₂₀₂₁₃ h₂₀₂₁₄ ih ⊢
          <;> ring_nf at h₂₀₂₁₃ h₂₀₂₁₄ ih ⊢ <;> omega
      have h₂₀₂₁₅ : 2021 = 7 * 288 + 5 := by norm_num
      rw [h₂₀₂₁₅]
      exact h₂₀₂₁₂ 288
    rw [h₂₀₂₁₁]
    <;> norm_num [h₆]
    <;> rfl
  
  have h₂₀₂₂ : d 2022 % 2 = 1 := by
    have h₂₀₂₂₁ : d 2022 % 2 = d 6 % 2 := by
      have h₂₀₂₂₂ : ∀ k : ℕ, d (7 * k + 6) % 2 = d 6 % 2 := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          have h₂₀₂₂₃ := h_periodic (7 * k + 6)
          have h₂₀₂₂₄ := h_periodic (7 * k + 6 + 7)
          simp [Nat.mul_add, Nat.add_mul, Nat.add_assoc] at h₂₀₂₂₃ h₂₀₂₂₄ ih ⊢
          <;> ring_nf at h₂₀₂₂₃ h₂₀₂₂₄ ih ⊢ <;> omega
      have h₂₀₂₂₅ : 2022 = 7 * 288 + 6 := by norm_num
      rw [h₂₀₂₂₅]
      exact h₂₀₂₂₂ 288
    rw [h₂₀₂₂₁]
    <;> norm_num [h₇]
    <;> rfl
  
  have h₂₀₂₃ : d 2023 % 2 = 0 := by
    have h₂₀₂₃₁ : d 2023 % 2 = d 0 % 2 := by
      have h₂₀₂₃₂ : ∀ k : ℕ, d (7 * k + 0) % 2 = d 0 % 2 := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          have h₂₀₂₃₃ := h_periodic (7 * k + 0)
          have h₂₀₂₃₄ := h_periodic (7 * k + 0 + 7)
          simp [Nat.mul_add, Nat.add_mul, Nat.add_assoc] at h₂₀₂₃₃ h₂₀₂₃₄ ih ⊢
          <;> ring_nf at h₂₀₂₃₃ h₂₀₂₃₄ ih ⊢ <;> omega
      have h₂₀₂₃₅ : 2023 = 7 * 289 + 0 := by norm_num
      rw [h₂₀₂₃₅]
      exact h₂₀₂₃₂ 289
    rw [h₂₀₂₃₁]
    <;> norm_num [h₀]
    <;> rfl
  
  have h_even_2021 : Even (d 2021) := by
    rw [even_iff_two_dvd]
    have h₂₀₂₁' : d 2021 % 2 = 0 := h₂₀₂₁
    omega
  
  have h_odd_2022 : Odd (d 2022) := by
    rw [Nat.odd_iff_not_even]
    rw [even_iff_two_dvd]
    have h₂₀₂₂' : d 2022 % 2 = 1 := h₂₀₂₂
    omega
  
  have h_even_2023 : Even (d 2023) := by
    rw [even_iff_two_dvd]
    have h₂₀₂₃' : d 2023 % 2 = 0 := h₂₀₂₃
    omega
  
  exact ⟨h_even_2021, h_odd_2022, h_even_2023⟩
