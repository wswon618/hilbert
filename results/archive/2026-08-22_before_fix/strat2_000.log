                have h₅₁ : d (n + 1) = d n + d (n - 2) := by
                  have h₅₂ : n + 1 ≥ 3 ∨ n + 1 < 3 := by omega
                  cases h₅₂ with
                  | inl h₅₂ =>
                    have h₅₃ := h₃ (n + 1) h₅₂
                    norm_num at h₅₃ ⊢
                    <;> ring_nf at h₅₃ ⊢ <;> omega
                  | inr h₅₂ =>
                    have h₅₃ : n = 0 ∨ n = 1 := by omega
                    cases h₅₃ with
                    | inl h₅₃ =>
                      subst_vars
                      <;> simp_all [h₀, h₁, h₂, h₃]
                      <;> norm_num
                      <;> omega
                    | inr h₅₃ =>
                      subst_vars
                      <;> simp_all [h₀, h₁, h₂, h₃]
                      <;> norm_num
                      <;> omega
                simp [h₄₆, h₄₇, h₄₉, h₅₁] at *
                <;>
                  (try omega) <;>
                  (try ring_nf at *) <;>
                  (try simp_all [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]) <;>
                  (try omega) <;>
                  (try norm_num) <;>
                  (try
                    {
                      cases n with
                      | zero => omega
                      | succ n =>
                        cases n with
                        | zero => omega
                        | succ n =>
                          cases n with
                          | zero => omega
                          | succ n =>
                            simp_all [h₀, h₁, h₂, h₃, Nat.add_assoc]
                            <;> norm_num
                            <;> omega
                    })
                <;>
                  omega
