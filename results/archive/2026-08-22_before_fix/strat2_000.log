  -- From the parity recurrence we obtain the needed 7‑step periodicity.
  have h7 (k) : Even (d (k + 7)) ↔ Even (d k) := by
    -- apply the parity recurrence seven times
    have h0 : Even (d (k + 7)) ↔ (Even (d (k + 6)) ↔ Even (d (k + 4))) :=
