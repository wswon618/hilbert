import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_step_induction_nfactltnexpnm1ngt3 :
    ∀ n, 3 ≤ n → n ! < n ^ (n - 1) → (n + 1) ! < (n + 1) ^ n := by
  intro n hn hlt
  -- positivity of `n`
  have hnpos : 0 < n := Nat.lt_of_lt_of_le (Nat.succ_pos 2) hn
  -- monotonicity of the power with respect to the base
  have hpow : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) := by
    have := Nat.pow_le_pow_of_le_left (Nat.le_succ n) (n - 1)
    simpa using this
  -- combine the given strict inequality with the monotone bound
  have hlt₂ : n ! < (n + 1) ^ (n - 1) := lt_of_lt_of_le hlt hpow
  -- multiply by `(n+1)` on the left
  have hmul : (n + 1) * n ! < (n + 1) * ((n + 1) ^ (n - 1)) :=
    Nat.mul_lt_mul_left (n + 1) hlt₂
  -- rewrite factorial and power, finish
  simpa [Nat.factorial_succ, Nat.pow_succ,
        Nat.succ_pred_eq_of_pos hnpos,
        Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hmul
