import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_step_induction_nfactltnexpnm1ngt3 :
    ∀ n, 3 ≤ n → n ! < n ^ (n - 1) → (n + 1) ! < (n + 1) ^ n := by
  intro n hn3 hlt
  have hpos : 0 < n + 1 := Nat.succ_pos _
  have hmul_lt : (n + 1) * n ! < (n + 1) * n ^ (n - 1) :=
    Nat.mul_lt_mul_of_pos_left hlt hpos
  -- positivity of the exponent `n - 1`
  have hpos_exp : 0 < n - 1 := by
    have h2lt : 2 < n := (Nat.succ_le_iff).mp hn3
    have h1lt : 1 < n := Nat.lt_trans (by decide) h2lt
    exact Nat.sub_pos_of_lt h1lt
  -- strict monotonicity of the power with respect to the base
  have hpow_lt : n ^ (n - 1) < (n + 1) ^ (n - 1) :=
    Nat.pow_lt_pow_of_lt_left (Nat.lt_succ_self n) hpos_exp
  have hlt' : (n + 1) * n ! < (n + 1) * (n + 1) ^ (n - 1) := by
    calc
      (n + 1) * n ! < (n + 1) * n ^ (n - 1) := hmul_lt
      _ < (n + 1) * (n + 1) ^ (n - 1) := Nat.mul_lt_mul_of_pos_left hpow_lt hpos
  simpa [Nat.factorial_succ, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm,
    Nat.mul_assoc] using hlt'
