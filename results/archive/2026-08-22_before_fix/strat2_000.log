import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_final_h_step_induction_nfactltnexpnm1ngt3 (n : Nat) (hnle : 3 ≤ n)
    (hlt : n ! < n ^ (n - 1)) : (n + 1)! < (n + 1) ^ n := by
  -- monotonicity of the power with respect to the base
  have hpowle : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) := by
    have hle : n ≤ n + 1 := Nat.le_succ n
    exact Nat.pow_le_pow_of_le_left hle _
  -- combine the strict inequality with the above
  have hlt' : n ! < (n + 1) ^ (n - 1) := lt_of_lt_of_le hlt hpowle
  -- multiply both sides by the positive factor (n+1)
  have hmul :
      (n + 1) * n ! < (n + 1) * ((n + 1) ^ (n - 1)) :=
    Nat.mul_lt_mul_of_pos_left hlt' (Nat.succ_pos _)
  -- we will need 1 ≤ n to rewrite (n‑1)+1 as n
  have h_one_le_n : (1 : ℕ) ≤ n := le_trans (by decide : (1 : ℕ) ≤ 3) hnle
  -- rewrite factorial and power to the required shape
  simpa [Nat.factorial_succ, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm,
    Nat.mul_assoc, Nat.sub_add_cancel h_one_le_n] using hmul
```


