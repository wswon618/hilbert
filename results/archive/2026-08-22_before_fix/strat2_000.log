import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem hdisj_imo_2019_p1 (f : ℤ → ℤ)
    (h : ∀ a b : ℤ, f (2 * a) + 2 * f b = f (f (a + b))) :
    ∀ z : ℤ, f z = 0 ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
  classical
  -- The proof follows the classical solution of IMO 2019‑1.
  -- First we show that either `f` is identically zero or it is affine.
  have h0 : (∀ z : ℤ, f z = 0) ∨ ∃ c : ℤ, ∀ z : ℤ, f z = 2 * z + c := by
    by_contra hneg
    push_neg at hneg
    rcases hneg with ⟨z0, hz0⟩
    -- From the functional equation we obtain linearity.
    have h1 : ∀ a b : ℤ, f (a + b) = f a + f b - f 0 := by
      intro a b
      have := h a b
      have hfa : f (2 * a) = 2 * f a - f 0 := by
        have h' := h a 0
        have : f (2 * a) + 2 * f 0 = f (f a) := by
          simpa [zero_add, mul_zero, add_comm, add_left_comm, add_assoc] using h a 0
        have hfa' : f (f a) = f (2 * a) + 2 * f 0 := this.symm
        have hfa'' : f (f a) = 2 * f a + (f 0) := by
          have := h a (-a)
          simpa [add_left_neg, mul_neg, mul_one, two_mul, add_comm, add_left_comm,
                add_assoc, sub_eq_add_neg] using this
        have : f (2 * a) = 2 * f a - f 0 := by
          linarith
        exact this
      have hfb : f (2 * b) = 2 * f b - f 0 := hfa b
      have : f (f (a + b)) = 3 * f (a + b) - 2 * f 0 := by
        have := h (a + b) 0
        simpa [zero_mul, zero_add, mul_zero, add_comm, add_left_comm, add_assoc] using this
      have : f (2 * (a + b)) + 2 * f 0 = f (f (a + b)) := by
        simpa [zero_add, mul_zero, add_comm, add_left_comm, add_assoc] using h (a + b) 0
      have : (2 * f (a + b) - f 0) + 2 * f 0 = 3 * f (a + b) - 2 * f 0 := by
        linarith
      have : f (a + b) = f a + f b - f 0 := by
        linarith
      exact this
    have hlin : ∀ x y : ℤ, f (x + y) = f x + f y - f 0 := h1
    have hadd : ∀ x y : ℤ, f (x + y) + f 0 = f x + f y := by
      intro x y
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hlin x y
    have hzero : f 0 = 0 := by
      have := h 0 0
      simpa [zero_mul, mul_zero, zero_add, add_comm, add_left_comm, add_assoc] using this
    have : ∀ z : ℤ, f z = 2 * z + f 0 := by
      intro z
      have hz : f (z + 0) + f 0 = f z + f 0 := by
        simpa using hadd z 0
      have : f z = 2 * z + f 0 := by
        have hrec : f (z + 1) = f z + 2 := by
          have := h (z) 0
          simpa [zero_mul, mul_zero, zero_add, add_comm, add_left_comm, add_assoc,
                two_mul, mul_one, add_comm] using this
        have : f z = 2 * z + f 0 := by
          induction z using Int.induction_on with
          | hz => simpa [zero_mul, zero_add, hzero] using rfl
          | hpos n ih =>
              have := hrec
              simpa [Int.ofNat_succ, Nat.succ_eq_add_one, add_comm, add_left_comm,
                    add_assoc, mul_add, mul_one, two_mul, ih] using this
          | hneg n ih =>
              have := hrec
              simpa [Int.negSucc_ofNat, add_comm, add_left_comm, add_assoc,
                    mul_add, mul_one, two_mul, ih] using this
        exact this
      exact this
    exact Or.inr ⟨f 0, this⟩
  intro z
  cases h0 with
  | inl hzero =>
      left
      exact hzero z
  | inr hlin =>
      right
      exact hlin
