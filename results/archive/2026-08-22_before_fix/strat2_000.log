import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_period_even_amc12a_2021_p8 (d : ℕ → ℕ) (h₃ : ∀ n ≥ 3, d n = d (n - 1) + d (n - 3)) (n : ℕ) :
    Even (d (n + 7)) ↔ Even (d n) := by
  classical
  -- Work modulo 2.  The recurrence relation is linear, so it holds modulo 2 as well.
  have hmod : ∀ m ≥ 3, (d m) % 2 = ((d (m - 1)) % 2 + (d (m - 3)) % 2) % 2 := by
    intro m hm
    have := h₃ m hm
    simpa [Nat.add_mod, Nat.mod_mod] using congrArg (fun x => x % 2) this
  -- Prove by strong induction on `n` that the residues repeat with period 7.
  have hperiod : ∀ n, (d (n + 7)) % 2 = (d n) % 2 := by
    intro n
    induction' n with n ih
    · -- base case `n = 0`
      have h0 : (d 7) % 2 = (d 0) % 2 := by
        -- unfold the recurrence seven times
        have h7 : (d 7) % 2 =
            ((d 6) % 2 + (d 4) % 2) % 2 := by
          have : 3 ≤ 7 := by decide
          simpa using hmod 7 this
        have h6 : (d 6) % 2 =
            ((d 5) % 2 + (d 3) % 2) % 2 := by
          have : 3 ≤ 6 := by decide
          simpa using hmod 6 this
        have h5 : (d 5) % 2 =
            ((d 4) % 2 + (d 2) % 2) % 2 := by
          have : 3 ≤ 5 := by decide
          simpa using hmod 5 this
        have h4 : (d 4) % 2 =
            ((d 3) % 2 + (d 1) % 2) % 2 := by
          have : 3 ≤ 4 := by decide
          simpa using hmod 4 this
        have h3 : (d 3) % 2 =
            ((d 2) % 2 + (d 0) % 2) % 2 := by
          have : 3 ≤ 3 := by decide
          simpa using hmod 3 this
        -- combine the equalities; all intermediate terms cancel pairwise
        calc
          (d 7) % 2
              = ((d 6) % 2 + (d 4) % 2) % 2 := h7
          _ = ((((d 5) % 2 + (d 3) % 2) % 2) + (d 4) % 2) % 2 := by
                simpa [h6] using rfl
          _ = ((((d 4) % 2 + (d 2) % 2) % 2 + (d 3) % 2) + (d 4) % 2) % 2 := by
                simpa [h5] using rfl
          _ = ((((d 3) % 2 + (d 1) % 2) % 2 + (d 2) % 2) + (d 3) % 2) % 2 := by
                simpa [h4] using rfl
          _ = ((((d 2) % 2 + (d 0) % 2) % 2 + (d 1) % 2) + (d 2) % 2) % 2 := by
                simpa [h3] using rfl
          _ = ((d 0) % 2) := by
                -- a short `simp` finishes the cancellations
                simp [Nat.add_mod, Nat.mod_mod, Nat.mod_eq_of_lt] 
        done
      simpa [Nat.add_comm] using h0
    · -- inductive step
      have hstep : (d (n.succ + 7)) % 2 = (d (n.succ)) % 2 := by
        -- rewrite using the recurrence for `n+8`
        have h8 : (d (n + 8)) % 2 =
            ((d (n + 7)) % 2 + (d (n + 5)) % 2) % 2 := by
          have : 3 ≤ n + 8 := by
            have : 0 ≤ n := Nat.zero_le _
            linarith
          simpa [Nat.succ_eq_add_one, add_comm, add_left_comm, add_assoc] using hmod (n + 8) this
        -- similarly for the other terms that appear
        have h7 : (d (n + 7)) % 2 =
            ((d (n + 6)) % 2 + (d (n + 4)) % 2) % 2 := by
          have : 3 ≤ n + 7 := by linarith
          simpa using hmod (n + 7) this
        have h6 : (d (n + 6)) % 2 =
            ((d (n + 5)) % 2 + (d (n + 3)) % 2) % 2 := by
          have : 3 ≤ n + 6 := by linarith
          simpa using hmod (n + 6) this
        have h5 : (d (n + 5)) % 2 =
            ((d (n + 4)) % 2 + (d (n + 2)) % 2) % 2 := by
          have : 3 ≤ n + 5 := by linarith
          simpa using hmod (n + 5) this
        have h4 : (d (n + 4)) % 2 =
            ((d (n + 3)) % 2 + (d (n + 1)) % 2) % 2 := by
          have : 3 ≤ n + 4 := by linarith
          simpa using hmod (n + 4) this
        have h3 : (d (n + 3)) % 2 =
            ((d (n + 2)) % 2 + (d n) % 2) % 2 := by
          have : 3 ≤ n + 3 := by linarith
          simpa using hmod (n + 3) this
        -- now substitute all these equalities and cancel
        calc
          (d (n + 8)) % 2
              = ((d (n + 7)) % 2 + (d (n + 5)) % 2) % 2 := h8
          _ = ((((d (n + 6)) % 2 + (d (n + 4)) % 2) % 2) + (d (n + 5)) % 2) % 2 := by
                simpa [h7] using rfl
          _ = (((( (d (n + 5)) % 2 + (d (n + 3)) % 2) % 2) + (d (n + 4)) % 2) + (d (n + 5)) % 2) % 2 := by
                simpa [h6] using rfl
          _ = (((( (d (n + 4)) % 2 + (d (n + 2)) % 2) % 2) + (d (n + 3)) % 2) + (d (n + 4)) % 2) % 2 := by
                simpa [h5] using rfl
          _ = (((( (d (n + 3)) % 2 + (d (n + 1)) % 2) % 2) + (d (n + 2)) % 2) + (d (n + 3)) % 2) % 2 := by
                simpa [h4] using rfl
          _ = (((( (d (n + 2)) % 2 + (d n) % 2) % 2) + (d (n + 1)) % 2) + (d (n + 2)) % 2) % 2 := by
                simpa [h3] using rfl
          _ = (d n) % 2 := by
                simp [Nat.add_mod, Nat.mod_mod, Nat.mod_eq_of_lt] 
        done
      simpa [Nat.succ_eq_add_one, add_comm, add_left_comm, add_assoc] using hstep
  -- translate the modular equality into an `Even` equivalence
  have : ((d (n + 7)) % 2 = 0) ↔ ((d n) % 2 = 0) := by
    simpa [Nat.mod_eq_of_lt] using congrArg (fun h => h) (hperiod n)
  simpa [Nat.even_iff] using this
