```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_final_h_step_induction_nfactltnexpnm1ngt3 (n : Nat) (hnle : 3 ≤ n)
    (hlt : n ! < n ^ (n - 1)) : (n + 1)! < (n + 1) ^ n := by
  -- monotonicity of the power with respect to the base
  have hpow_le : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) :=
    Nat.pow_le_pow_of_le_left (Nat.le_succ n) (n - 1)
  -- combine the given strict inequality with the monotonicity
  have h1 : n ! < (n + 1) ^ (n - 1) :=
    Nat.lt_of_lt_of_le hlt hpow_le
  -- multiply both sides by the positive factor (n+1)
  have h2 : (n + 1) * n ! < (n + 1) * ((n + 1) ^ (n - 1)) :=
    Nat.mul_lt_mul_of_pos_left h1 (Nat.succ_pos _)
  -- we need `1 ≤ n` to rewrite `n - 1 + 1 = n`
  have h_one_le : (1 : Nat) ≤ n := le_trans (Nat.succ_le_of_lt (Nat.succ_pos 0)) hnle
  -- rewrite factorial and power definitions and finish
  simpa [Nat.factorial_succ, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm,
    Nat.mul_assoc, Nat.sub_add_cancel h_one_le] using h2
```


