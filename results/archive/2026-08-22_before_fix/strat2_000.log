      <;> omega
    have h₂ : Even (d 2021) ↔ Even (d (5 + 7 * 288)) := by
      rw [h₁]
    have h₃ : Even (d (5 + 7 * 288)) ↔ Even (d 5) := h_inductive_lemma 288
    calc
      Even (d 2021) ↔ Even (d (5 + 7 * 288)) := h₂
      _ ↔ Even (d 5) := h₃
  
