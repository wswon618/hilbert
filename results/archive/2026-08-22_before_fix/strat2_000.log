import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_step_induction_nfactltnexpnm1ngt3 :
    ∀ n, 3 ≤ n → n ! < n ^ (n - 1) → (n + 1) ! < (n + 1) ^ n := by
  intro n hn3 hlt
  have hpos : 0 < n + 1 := Nat.succ_pos _
  -- multiply the given strict inequality by (n+1)
  have h_mul : (n + 1) * n ! < (n + 1) * n ^ (n - 1) :=
    Nat.mul_lt_mul_of_pos_left hlt hpos
  -- monotonicity of powers w.r.t. the base
  have hpow : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) := by
    have : n ≤ n + 1 := Nat.le_succ n
    exact Nat.pow_le_pow_of_le_left this (Nat.zero_le _)
  -- multiply this inequality by (n+1)
  have h_mul2 : (n + 1) * n ^ (n - 1) ≤ (n + 1) * (n + 1) ^ (n - 1) :=
    Nat.mul_le_mul_left (n + 1) hpow
  -- combine the two inequalities
  have h_comb : (n + 1) * n ! < (n + 1) * (n + 1) ^ (n - 1) :=
    lt_of_lt_of_le h_mul h_mul2
  -- rewrite factorial and power to obtain the desired statement
  simpa [Nat.factorial_succ, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm,
        Nat.mul_assoc] using h_comb
```


