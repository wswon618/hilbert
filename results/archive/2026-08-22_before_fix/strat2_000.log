import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_final_h_step_induction_nfactltnexpnm1ngt3 (n : Nat) (hnle : 3 ≤ n)
    (hlt : n ! < n ^ (n - 1)) : (n + 1)! < (n + 1) ^ n := by
  -- `n` is larger than `1`
  have h1lt : (1 : ℕ) < n := lt_of_lt_of_le (by decide) hnle
  -- positivity of `n - 1`
  have hpos : 0 < n - 1 := Nat.sub_pos_of_lt h1lt
  -- monotonicity of `pow` in the base
  have hpow : n ^ (n - 1) ≤ (n + 1) ^ (n - 1) :=
    Nat.pow_le_pow_of_le_left (Nat.le_succ n) (n - 1)
  -- combine with the given strict inequality
  have hlt' : n ! < (n + 1) ^ (n - 1) := Nat.lt_of_lt_of_le hlt hpow
  -- multiply both sides by the positive factor `n+1`
  have hmul : (n + 1) * n ! < (n + 1) * (n + 1) ^ (n - 1) :=
    Nat.mul_lt_mul_of_pos_left hlt' (Nat.succ_pos _)
  -- rewrite to the desired form
  have hle1 : 1 ≤ n := Nat.succ_le_of_lt h1lt
  simpa [Nat.factorial_succ, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm,
    Nat.mul_assoc, Nat.sub_add_cancel hle1] using hmul
```


