theorem imo_2019_p1 (f : ℤ → ℤ) :
    (∀ a b, f (2 * a) + 2 * f b = f (f (a + b))) ↔
      ∀ z, f z = 0 ∨ ∃ c, ∀ z, f z = 2 * z + c := by
  constructor
  · intro h
    -- basic consequences of the hypothesis
    have h00 : 3 * f 0 = f (f 0) := by
      have := h 0 0
      simpa [two_mul, mul_comm, mul_left_comm, mul_assoc] using this
    have h_even : ∀ a : ℤ, f (2 * a) = 2 * f a - f 0 := by
      intro a
      have h1 := h a 0
      have h2 := h 0 a
      -- algebraic manipulation of h1 and h2
      sorry
    have h_neg : ∀ a : ℤ, f (-a) = 2 * f 0 - f a := by
      intro a
      have h1 := h a (-a)
      -- use h00 and h_even
      sorry
    have h_add : ∀ a b : ℤ, f (a + b) = f a + f b - f 0 := by
      intro a b
      have h1 := h a b
      have h2 := h 0 (a + b)
      -- combine with h_even
      sorry
    -- introduce the constant c = f 0
    set c := f 0 with hcdef
    -- additive property for g x = f x - c
    have hg_add : ∀ a b : ℤ, (f (a + b) - c) = (f a - c) + (f b - c) := by
      intro a b
      have := h_add a b
      simpa [c, sub_eq, add_comm, add_left_comm, add_assoc, sub_eq_add_neg] using this
    -- existence of a linear coefficient k
    have hk_exists : ∃ k : ℤ, ∀ x : ℤ, f x = k * x + c := by
      -- from the additive property on ℤ
      sorry
    rcases hk_exists with ⟨k, hk⟩
    -- determine the possible values of k and c
    have hk_cases : (k = 0 ∧ c = 0) ∨ k = 2 := by
      -- substitute hk into the original equation h
      sorry
    -- build the required universal statement
    intro z
    cases hk_cases with
    | inl hkc =>
        left
        rcases hkc with ⟨hk0, hc0⟩
        have : f z = 0 := by
          simpa [hk hk0, hc0, mul_zero] using rfl
        exact this
    | inr hk2 =>
        right
        refine ⟨c, ?_⟩
        intro z
        have : f z = k * z + c := hk z
        simpa [hk2, mul_comm] using this
  · intro h
    -- extract a global disjunction from the pointwise one
    have h0_or : (∀ z, f z = 0) ∨ ∃ c, ∀ z, f z = 2 * z + c := by
      classical
      by_cases h0 : ∀ z, f z = 0
      · exact Or.inl h0
      · push_neg at h0
        rcases h0 with ⟨z0, hz0⟩
        have : ∃ c, ∀ z, f z = 2 * z + c := by
          rcases h z0 with hz0 | ⟨c, hc⟩
          · exact (hz0.elim hz0)  -- contradiction
          · exact ⟨c, hc⟩
        exact Or.inr this
    cases h0_or with
    | inl hzero =>
        intro a b
        have hfa : f (2 * a) = 0 := hzero (2 * a)
        have hfb : f b = 0 := hzero b
        have hfab : f (a + b) = 0 := hzero (a + b)
        simp [hfa, hfb, hfab]
    | inr hlin =>
        rcases hlin with ⟨c, hc⟩
        intro a b
        have hfa : f (2 * a) = 2 * (2 * a) + c := by
          simpa using hc (2 * a)
        have hfb : f b = 2 * b + c := by
          simpa using hc b
        have hfab : f (a + b) = 2 * (a + b) + c := by
          simpa using hc (a + b)
        have : f (f (a + b)) = f (2 * (a + b) + c) := by
          simpa [hfab]
        simp [hfa, hfb, this, two_mul, mul_add, add_comm, add_left_comm, add_assoc]
