        have h₁₅ : m * Real.pi / 180 = ((175 / 2 : ℚ) : ℝ) * Real.pi / 180 := by
          apply (injOn_tan.eq_iff ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩).1
          exact h₁₀
        exact h₁₅
      exact h₉
    exact h₄
  
  have h_final : m * Real.pi / 180 = ((175 / 2 : ℚ) * Real.pi / 180) := by
    simpa [div_eq_mul_inv] using h_main
  
  exact h_final
