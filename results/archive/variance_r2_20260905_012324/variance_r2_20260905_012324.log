by
  -- First we obtain the non‑strict inequality from the antitone hypothesis.
  have hle :
      ∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    refine (ae_restrict_iff.2 ?_)
    intro x hx
    rcases hx with ⟨hx₁, hx₂⟩
    have h2mem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) 10000 := by
      constructor <;> norm_num
    have := h_antitone hx h2mem hx₂
    simpa using this
  -- The only point where equality can hold is `x = 2`; this point has measure zero.
  have hnull :
      (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
        {x | (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x} = 0 := by
    have hsubset :
        {x | (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x} ⊆ ({2} : Set ℝ) := by
      intro x hx
      have hx' : (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x := hx
      have h_eq : Real.sqrt x = Real.sqrt (2 : ℝ) := by
        have hpos₂ : (0 : ℝ) ≤ Real.sqrt (2 : ℝ) := Real.sqrt_nonneg _
        have hposₓ : (0 : ℝ) ≤ Real.sqrt x := Real.sqrt_nonneg _
        field_simp [hx'] at *
      have : x = (2 : ℝ) := by
        have hxnonneg : 0 ≤ x := le_trans (by norm_num) hx₁
        have : x = (Real.sqrt x) ^ 2 := (Real.sq_sqrt hxnonneg).symm
        have : (2 : ℝ) = (Real.sqrt (2 : ℝ)) ^ 2 := (Real.sq_sqrt (by norm_num)).symm
        simpa [this, h_eq] using congrArg (fun y => y ^ 2) h_eq
      simpa [Set.mem_singleton_iff] using this
    have hsingleton :
        (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)) ({2} : Set ℝ) = 0 := by
      simpa using (Real.volume_singleton (a := (2 : ℝ)))
    exact measure_mono_null hsubset hsingleton
  -- From the non‑strict inequality and the nullity of the equality set we get the strict one.
  have : ∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
      (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x := by
    refine (ae_iff.2 ?_)
    have : (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
        {x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} = 0 := by
      simpa [not_lt, Set.setOf_eq_eq] using hnull
    simpa using this
  exact this
