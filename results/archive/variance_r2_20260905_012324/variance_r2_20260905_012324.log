  -- From the hypothesis that the function is not constant we get a strict inequality.
  rcases h_not_const with ⟨x, hx, hfx⟩
  have hlt_const :
      (1 : ℝ) / Real.sqrt (2 : ℝ) < (1 : ℝ) / Real.sqrt x := by
    have hxle : x ≤ (2 : ℝ) := hx.2
