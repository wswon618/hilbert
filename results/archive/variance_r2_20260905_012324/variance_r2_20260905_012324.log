theorem h_integral_ge_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_le_ae :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≥
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) := by
  -- continuity of the variable integrand on the closed interval
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
    have h_const : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Set.Icc (1 : ℝ) 2) :=
      continuousOn_const
    have h_sqrt : ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
      (Real.continuous_sqrt).continuousOn
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        exact lt_of_lt_of_le (by norm_num) this
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa [one_div] using h_const.div h_sqrt h_ne
  -- interval‑integrability of the variable integrand (convert Icc to uIcc)
  have hf :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 2 := by
    have hcont' :
        ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.uIcc (1 : ℝ) 2) := by
      simpa [Set.uIcc, min_eq_left (by norm_num), max_eq_right (by norm_num)] using hcont
    exact hcont'.intervalIntegrable
  -- interval‑integrability of the constant integrand
  have hg :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt (2 : ℝ))
        MeasureTheory.volume 1 2 :=
    intervalIntegral.intervalIntegrable_const _
  -- apply the a.e. inequality to obtain the integral inequality
  have hle :=
    intervalIntegral.integral_le_integral_of_le_ae
      (μ := MeasureTheory.volume) (a := (1 : ℝ)) (b := 2)
      (f := fun _ : ℝ => (1 : ℝ) / Real.sqrt (2 : ℝ))
      (g := fun x : ℝ => (1 : ℝ) / Real.sqrt x)
      h_le_ae hg hf
  simpa [ge_iff_le] using hle
