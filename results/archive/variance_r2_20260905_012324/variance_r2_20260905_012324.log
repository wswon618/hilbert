set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_sum_le_int_h_le_h_sum_le_integral_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000))
  (h_pointwise :
        ∀ i ∈ Finset.Ico (1 : ℕ) 10000,
          ∀ x ∈ Set.Ico (i : ℝ) (i + 1 : ℝ),
            (1 : ℝ) / Real.sqrt (i + 1) ≤ (1 : ℝ) / Real.sqrt x)
  (h_int_Ico :
        MeasureTheory.IntegrableOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Ico (1 : ℝ) 10000)) :
    (∑ i in Finset.Ico (1 : ℕ) 10000, (1 : ℝ) / Real.sqrt (i + 1)) ≤
      ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
  -- Apply the standard comparison lemma for decreasing functions.
  have hle :
      (∑ k in Finset.range 9999,
          (1 : ℝ) / Real.sqrt ((1 : ℝ) + (k + 1))) ≤
        ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
    simpa [add_comm, add_left_comm, add_assoc] using
      (AntitoneOn.sum_le_integral
        (x₀ := (1 : ℝ)) (a := 9999)
        (f := fun x : ℝ => (1 : ℝ) / Real.sqrt x) h_antitone)
  -- Rewrite the sum that appears in `hle` to the required `Ico` form.
  have hsum :
      (∑ i in Finset.Ico (1 : ℕ) 10000, (1 : ℝ) / Real.sqrt (i + 1)) =
        ∑ k in Finset.range 9999,
          (1 : ℝ) / Real.sqrt ((1 : ℝ) + (k + 1)) := by
    simpa [Nat.cast_one, Nat.cast_add, add_comm, add_left_comm, add_assoc] using
      (Finset.sum_Ico_eq_sum_range
        (fun i : ℕ => (1 : ℝ) / Real.sqrt (i + 1)) 1 10000)
  -- Conclude the desired inequality.
  simpa [hsum] using hle
