    simpa [Real.sqrt_one, mul_one, sub_eq_add_neg] using this
  -- Reduce the goal to a simple arithmetic inequality.
  have h_ineq : (1 / Real.sqrt 2) < 2 * Real.sqrt 2 - 2 := by
