      have h₇₁ : Real.sqrt k - Real.sqrt (k - 1) = 1 / (Real.sqrt k + Real.sqrt (k - 1)) := by
        have h₇₂ : (Real.sqrt k - Real.sqrt (k - 1)) * (Real.sqrt k + Real.sqrt (k - 1)) = 1 := by
          have h₇₃ : (Real.sqrt k - Real.sqrt (k - 1)) * (Real.sqrt k + Real.sqrt (k - 1)) = (Real.sqrt k) ^ 2 - (Real.sqrt (k - 1)) ^ 2 := by
            ring_nf
            <;> field_simp [h₃.ne', h₄.ne']
            <;> ring_nf
          rw [h₇₃]
          have h₇₄ : (Real.sqrt k) ^ 2 = (k : ℝ) := by rw [Real.sq_sqrt (by positivity)]
          have h₇₅ : (Real.sqrt (k - 1)) ^ 2 = (k - 1 : ℝ) := by
            rw [Real.sq_sqrt] <;>
            (try norm_num) <;>
            (try linarith) <;>
            (try positivity)
          rw [h₇₄, h₇₅]
          <;> ring_nf
          <;> field_simp [h₃.ne', h₄.ne']
          <;> linarith
        have h₇₆ : Real.sqrt k + Real.sqrt (k - 1) ≠ 0 := by positivity
        field_simp [h₇₆] at h₇₂ ⊢
        nlinarith [Real.sqrt_nonneg k, Real.sqrt_nonneg (k - 1)]
      calc
        2 * (Real.sqrt k - Real.sqrt (k - 1)) = 2 * (1 / (Real.sqrt k + Real.sqrt (k - 1))) := by rw [h₇₁]
        _ = 2 / (Real.sqrt k + Real.sqrt (k - 1)) := by ring
    have h₈ : (1 : ℝ) / Real.sqrt k < 2 / (Real.sqrt k + Real.sqrt (k - 1)) := by
      have h₈₁ : 0 < Real.sqrt k := Real.sqrt_pos.mpr (by positivity)
      have h₈₂ : 0 < Real.sqrt k + Real.sqrt (k - 1) := by positivity
      have h₈₃ : Real.sqrt k + Real.sqrt (k - 1) < 2 * Real.sqrt k := by
        nlinarith [Real.sqrt_nonneg (k - 1), Real.sqrt_nonneg k, h₅]
      have h₈₄ : 0 < 2 * Real.sqrt k := by positivity
      have h₈₅ : 0 < Real.sqrt k + Real.sqrt (k - 1) := by positivity
      -- Use the fact that the denominator on the RHS is smaller to show the inequality
      have h₈₆ : 0 < Real.sqrt k * (Real.sqrt k + Real.sqrt (k - 1)) := by positivity
      rw [div_lt_div_iff (by positivity) (by positivity)]
      nlinarith [Real.sq_sqrt (show 0 ≤ (k : ℝ) by positivity),
        Real.sq_sqrt (show 0 ≤ (k - 1 : ℝ) by
