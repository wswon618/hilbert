    (h_le :
        ∀ x ∈ Set.Icc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x)
    (h_strict_at_one :
        (1 : ℝ) / Real.sqrt 1 > (1 : ℝ) / Real.sqrt 2) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) >
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2 := by
  -- rewrite the constant integral
  have h_const :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) = (1 / Real.sqrt 2) * (2 - 1) := by
    simpa using intervalIntegral.integral_const (a := (1 : ℝ)) (b := 2)
      (c := (1 / Real.sqrt 2))
  -- the pointwise inequality gives an a.e. inequality on the interval
  have h_ae :
      (fun x : ℝ => (1 : ℝ) / Real.sqrt 2) ≤ᵐ[volume.restrict (Set.Icc (1 : ℝ) 2)]
        fun x => (1 : ℝ) / Real.sqrt x := by
    refine (Filter.eventually_of_forall ?_) 
    intro x hx
    exact h_le x hx
  -- therefore the integral of the constant is ≤ the integral of the variable function
  have h_int_le :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x :=
    intervalIntegral.integral_le_integral_of_le_ae h_ae
  -- the constant integral is strictly smaller than the value of the integrand at the left
  -- endpoint, and hence strictly smaller than the whole integral
  have h_lt :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) < (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) := by
    have : (1 / Real.sqrt 2) < (1 / Real.sqrt 1) := by
      simpa using h_strict_at_one.symm
    have : (1 / Real.sqrt 2) * (2 - 1) < (1 / Real.sqrt 1) * (2 - 1) := by
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
        mul_lt_mul_of_pos_right this (by norm_num : (0 : ℝ) < (2 - 1))
    simpa [h_const] using this.trans_le h_int_le
  simpa [h_const] using h_lt
