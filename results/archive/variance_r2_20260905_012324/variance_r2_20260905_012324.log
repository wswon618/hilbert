    (1 : ℝ) / Real.sqrt 2 <
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- Restrict the antitone hypothesis to the interval [1, 2].
  have h_antitone' :
      AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
    intro x hx y hy hxy
    have hx' : x ∈ Set.Icc (1 : ℝ) (10000 : ℝ) :=
      ⟨hx.1, le_trans hx.2 (by norm_num)⟩
    have hy' : y ∈ Set.Icc (1 : ℝ) (10000 : ℝ) :=
      ⟨hy.1, le_trans hy.2 (by norm_num)⟩
    exact h_antitone hx' hy' hxy
  -- Apply the strict sum‑integral comparison for antitone functions.
  have hlt :
      (∑ i in Finset.Ico (1 : ℕ) 2,
          (1 : ℝ) / Real.sqrt ((i + 1 : ℕ) : ℝ)) <
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x :=
    AntitoneOn.sum_lt_integral_Ico (by norm_num : (1 : ℝ) ≤ 2) h_antitone'
  -- The sum on the left is exactly `1 / √2`.
  simpa using hlt
