                Real.sq_sqrt (show 0 ≤ (n : ℝ) by positivity),
                Real.sq_sqrt (show 0 ≤ (n + 1 : ℝ) by positivity)]
          have h₇ : ∑ k in Finset.Icc (2 : ℕ) 10000, (Real.sqrt k - Real.sqrt (k - 1)) = Real.sqrt 10000 - Real.sqrt 1 := by
            apply h₆
            <;> norm_num
          exact h₇
        exact h₅
      rw [h₄]
      <;> ring_nf
    linarith
  
  have h_sqrt : 2 * (Real.sqrt 10000 - Real.sqrt 1 : ℝ) = 198 := by
