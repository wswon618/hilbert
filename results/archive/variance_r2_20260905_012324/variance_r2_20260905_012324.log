  have h_int :
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x = 2 * (Real.sqrt 2 - 1) := by
    -- rewrite the integrand as a power
    have hpow : (fun x : ℝ => (1 : ℝ) / Real.sqrt x) = fun x => x ^ (-(1 / 2)) := by
      funext x
      have hx : Real.sqrt x = x ^ (1 / 2) := by
        simpa [Real.rpow_one_half] using (Real.sqrt_eq_rpow x)
      simp [one_div, hx, rpow_neg] 
    -- use the formula for the integral of a power
    rw [hpow]
    have hne : (-(1 / 2) : ℝ) ≠ -1 := by norm_num
    simpa [one_div, Real.rpow_one_half, sub_eq, sub_eq_add_neg,
      mul_comm, mul_left_comm, mul_assoc, div_eq_mul_inv] using
      (intervalIntegral.integral_pow (a := (1 : ℝ)) (b := 2) (r := -(1 / 2)) hne)
  -- Show the obtained value is larger than `1 / √2`.
  have h_lt : (1 / Real.sqrt 2) < 2 * (Real.sqrt 2 - 1) := by
    have hsqrt_pos : 0 < Real.sqrt 2 := by positivity
    have hsub_pos : 0 < Real.sqrt 2 - 1 := by
      have : (1 : ℝ) < Real.sqrt 2 := by
        have : (1 : ℝ) ^ 2 < 2 := by norm_num
        simpa [Real.sqrt_sq_eq_abs] using Real.sqrt_lt_sqrt_iff.mpr (by norm_num)
      linarith
    have : (1 / Real.sqrt 2) = Real.sqrt 2 / 2 := by
      field_simp [hsqrt_pos.ne']
    have : Real.sqrt 2 / 2 < 2 * (Real.sqrt 2 - 1) := by
      have h : (1 / 2 : ℝ) < Real.sqrt 2 - 1 := by linarith
      have := mul_lt_mul_of_pos_left h hsqrt_pos
      simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc, two_mul] using this
    simpa [this] using this
  simpa [h_int] using h_lt
