  -- turn the pointwise inequality into an `ae` inequality on the interval
  have h_le_ae :
      (∀ᵐ x in volume.restrict (Ioc (1 : ℝ) 2),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x) :=
    Filter.eventually_of_forall (by
      intro x hx
      exact h_le x ⟨le_of_lt hx.1, hx.2⟩)

  -- the strict inequality holds on a neighbourhood of `1`, hence `ae`
  have h_strict_ae :
      (∀ᵐ x in volume.restrict (Ioc (1 : ℝ) 2),
        (1 : ℝ) / Real.sqrt x > (1 : ℝ) / Real.sqrt 2) := by
    have h_cont :
        ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
      have h := (continuous_const.div (continuous_sqrt)).continuousOn
      refine h.mono ?_
      intro x hx
      have hxpos : (0 : ℝ) < x := hx.1.trans_lt (by norm_num)
      have : Real.sqrt x ≠ 0 := by
        have hpos : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
        exact ne_of_gt hpos
      exact this
    -- obtain a small interval on which the inequality is strict everywhere
    obtain ⟨ε, εpos, hε⟩ :=
      (h_cont.tendsto_nhdsWithin_Icc (by simp)).exists_forall_lt h_strict_at_one
    have h_meas :
        (0 : ℝ) < (volume.restrict (Ioc (1 : ℝ) 2)) (Ioc (1 : ℝ) (1 + ε)) := by
      have : (0 : ℝ) < ε := εpos
      have hlen : (0 : ℝ) < (1 + ε) - (1 : ℝ) := by linarith
      have : (volume (Ioc (1 : ℝ) (1 + ε))) ≠ 0 := by
        simpa [measure_Ioc, hlen] using (ne_of_gt (by positivity))
      simpa [Measure.restrict_apply, Set.inter_eq_self_of_subset,
        Ioc_subset_Ioc_self (by linarith) (by linarith)] using this
    refine (Filter.eventually_ae_iff.2 ?_)
    refine ⟨Ioc (1 : ℝ) (1 + ε), ?_, ?_⟩
    · exact h_meas
    · intro x hx
      exact (hε x hx).le

  -- integrability of the two functions on `[1,2]`
  have h_int_f :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 :=
    (ContinuousOn.intervalIntegrable_of_Icc (by norm_num) (by
      have h := (continuous_const.div (continuous_sqrt)).continuousOn
      exact h))
  have h_int_c :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2) volume 1 2 :=
    intervalIntegral.intervalIntegrable_const

  -- conclude with the strict integral inequality
  exact
    intervalIntegral.integral_lt_integral_of_lt_ae
      (by norm_num) h_int_f h_int_c h_le_ae h_strict_ae
