import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_eq_algebra_sum1onsqrt2to1onsqrt10000lt198 :
    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = 198 := by
  -- Derivative of the antiderivative `2 * √x`.
  have hderiv :
      ∀ x ∈ Set.Icc (1 : ℝ) 10000,
        HasDerivAt (fun y => (2 : ℝ) * Real.sqrt y) (1 / Real.sqrt x) x := by
    intro x hx
    have hxpos : (0 : ℝ) < x := by
      have hle : (1 : ℝ) ≤ x := hx.1
      have h0 : (0 : ℝ) < (1 : ℝ) := by norm_num
      exact lt_of_lt_of_le h0 hle
    have h := (Real.hasDerivAt_sqrt hxpos).const_mul (2 : ℝ)
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using h
  -- Apply the fundamental theorem of calculus.
  have h_int :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt
      (a := (1 : ℝ)) (b := 10000)
      (f := fun y => (2 : ℝ) * Real.sqrt y)
      (f' := fun x => (1 : ℝ) / Real.sqrt x) hderiv
  -- Compute the antiderivative at the endpoints.
  have h_val : (2 * Real.sqrt (10000 : ℝ) - 2 * Real.sqrt (1 : ℝ)) = (198 : ℝ) := by
    norm_num
  simpa [h_val] using h_int
