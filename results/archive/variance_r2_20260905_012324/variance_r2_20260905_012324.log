```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_strict_ae_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_antitone :
    AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x) := by
  -- The set where the inequality fails is contained in `{2}`.
  have h_subset :
      ({x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} ∩ Set.Icc (1 : ℝ) 2)
        ⊆ ({2} : Set ℝ) := by
    intro x hx
    rcases hx with ⟨hx_not, hx_mem⟩
    have hle : (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
      have hxI : x ∈ Set.Icc (1 : ℝ) 10000 :=
        ⟨hx_mem.1, le_trans hx_mem.2 (by norm_num)⟩
      have h2I : (2 : ℝ) ∈ Set.Icc (1 : ℝ) 10000 := by norm_num
      have : x ≤ (2 : ℝ) := hx_mem.2
      exact h_antitone hxI h2I this
    have h_eq : (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x := by
      rcases lt_or_eq_of_le hle with hlt | heq
      · exact (False.elim (hx_not hlt))
      · exact heq
    have hx_eq : x = 2 := by
      -- positivity of the square‑roots
      have hposx : 0 < Real.sqrt x := by
        have : 0 < x := lt_of_lt_of_le (by norm_num) hx_mem.1
        exact (Real.sqrt_pos.mpr this)
      have hpos2 : 0 < Real.sqrt (2 : ℝ) := by
        have : (0 : ℝ) < (2 : ℝ) := by norm_num
        exact (Real.sqrt_pos.mpr this)
      -- equality of the square‑roots
      have h_sqrt : Real.sqrt x = Real.sqrt (2 : ℝ) := by
        have : (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x := h_eq
        field_simp [hpos2.ne', hposx.ne'] at this
        simpa [eq_comm] using this
      -- turn it into an equality of the arguments
      have hx_nonneg : (0 : ℝ) ≤ x :=
        le_of_lt (lt_of_lt_of_le (by norm_num) hx_mem.1)
      have hy_nonneg : (0 : ℝ) ≤ Real.sqrt (2 : ℝ) := Real.sqrt_nonneg _
      have h_sq : x = (Real.sqrt (2 : ℝ)) ^ 2 :=
        (Real.sqrt_eq_iff_eq_sq hx_nonneg hy_nonneg).1 h_sqrt
      have : x = 2 := by
        simpa [Real.sqrt_sq (Real.sqrt_nonneg _)] using h_sq
      simpa [eq_comm] using this
    simpa [Set.mem_singleton_iff, hx_eq]
  -- The singleton `{2}` has zero volume when the measure is restricted to `Icc 1 2`.
  have h_zero :
      (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)) ({2} : Set ℝ) = 0 := by
    simpa using
      (MeasureTheory.Measure.restrict_singleton (μ := MeasureTheory.volume) (a := (2 : ℝ)))
  -- Hence the set where the inequality fails has measure zero.
  have h_null :
      (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
        {x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} = 0 := by
    have : (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
        ({x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} ∩ Set.Icc (1 : ℝ) 2) = 0 :=
      MeasureTheory.measure_mono_null h_subset h_zero
    simpa [MeasureTheory.Measure.restrict_apply,
           Set.inter_eq_self_of_subset_left (by
             intro x hx; exact hx.2)] using this
  -- Conclude using the characterisation of `ae`.
  exact (MeasureTheory.ae_iff).2 h_null
