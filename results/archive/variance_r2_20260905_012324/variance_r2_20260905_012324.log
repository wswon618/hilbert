    exact htan_eq_aime_1999_p11
  have htan_m_eq :
      Real.tan (m * Real.pi / 180) =
        Real.tan ((175 / 2 : ℝ) * Real.pi / 180) := by
    exact htan_m_eq_aime_1999_p11 m h₁ hsum_eq_cot hcot_eq_tan htan_eq
