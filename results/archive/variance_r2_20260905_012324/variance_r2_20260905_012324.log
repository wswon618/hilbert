```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_int1_h_integral_add_hlt_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198 :
    IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 2 := by
  -- continuity of the integrand on the closed interval [1,2]
  have h_cont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
    have h_num : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Set.Icc (1 : ℝ) 2) :=
      (continuous_const).continuousOn
    have h_den : ContinuousOn Real.sqrt (Set.Icc (1 : ℝ) 2) :=
      Real.continuous_sqrt.continuousOn
    have h_den_ne :
        ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (0 : ℝ) < (1 : ℝ) := by norm_num
        exact lt_of_lt_of_le this hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa [one_div] using h_num.div h_den h_den_ne
  -- integrability follows from continuity on a compact interval
  have h_int :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 2 :=
    MeasureTheory.intervalIntegrable_of_continuousOn (a := 1) (b := 2)
      (μ := MeasureTheory.volume) h_cont (by norm_num)
  simpa using h_int
