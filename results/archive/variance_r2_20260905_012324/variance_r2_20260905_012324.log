theorem h_int_gt_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone_sub :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2))
    (h_not_const :
        ∃ x ∈ Set.Icc (1 : ℝ) 2,
          (1 : ℝ) / Real.sqrt x ≠ (1 : ℝ) / Real.sqrt (2 : ℝ)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt (2 : ℝ) := by
  -- Pointwise lower bound: the constant `1/√2` is ≤ the integrand on the whole interval.
  have h_le :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt (2 : ℝ) ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hxle : x ≤ (2 : ℝ) := hx.2
    have hxpos : 0 < x := by
      have : (1 : ℝ) ≤ x := hx.1
      linarith
    have hposx : 0 < Real.sqrt x := (Real.sqrt_pos.mpr hxpos)
    have hpos2 : 0 < Real.sqrt (2 : ℝ) := (Real.sqrt_pos.mpr (by norm_num))
    have hle_sqrt : Real.sqrt x ≤ Real.sqrt (2 : ℝ) := by
      have hxnonneg : (0 : ℝ) ≤ x := le_of_lt hxpos
      have h2nonneg : (0 : ℝ) ≤ (2 : ℝ) := by norm_num
      exact ((Real.sqrt_le_sqrt_iff hxnonneg h2nonneg).mpr hxle)
    have := inv_le_inv_of_le hposx hle_sqrt
    simpa [div_eq_mul_inv, mul_comm] using this
  -- Existence of a point where the integrand is strictly larger than the constant.
  have h_lt :
      ∃ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt (2 : ℝ) < (1 : ℝ) / Real.sqrt x := by
    rcases h_not_const with ⟨x, hx, hfx⟩
    have hxne : x ≠ (2 : ℝ) := by
      intro h
      have : (1 : ℝ) / Real.sqrt x = (1 : ℝ) / Real.sqrt (2 : ℝ) := by simpa [h]
      exact hfx this
    have hxpos : 0 < x := by
      have : (1 : ℝ) ≤ x := hx.1
      linarith
    have hposx : 0 < Real.sqrt x := (Real.sqrt_pos.mpr hxpos)
    have hpos2 : 0 < Real.sqrt (2 : ℝ) := (Real.sqrt_pos.mpr (by norm_num))
    have hxle : x ≤ (2 : ℝ) := hx.2
    have hlt_sqrt : Real.sqrt x < Real.sqrt (2 : ℝ) := by
      have hxnonneg : (0 : ℝ) ≤ x := le_of_lt hxpos
      have h2nonneg : (0 : ℝ) ≤ (2 : ℝ) := by norm_num
      have : x < (2 : ℝ) := lt_of_le_of_ne hxle hxne
      exact ((Real.sqrt_lt_sqrt_iff hxnonneg h2nonneg).mpr this)
    have hlt : (1 : ℝ) / Real.sqrt (2 : ℝ) < (1 : ℝ) / Real.sqrt x := by
      have := one_div_lt_one_div_of_lt hposx hlt_sqrt
      simpa [one_div] using this
    exact ⟨x, hx, hlt⟩
  -- Strict inequality between the integrals follows from the pointwise facts.
  have h_int_lt :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) <
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x :=
