import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_strict_ae_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_antitone :
    AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x) := by
  -- rewrite the a.e. statement in terms of a measure of a set
  refine (MeasureTheory.ae_iff.2 ?_)
  -- Identify the set where the strict inequality fails
  have h_set :
      {x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} ∩
        Set.Icc (1 : ℝ) 2 = ({(2 : ℝ)} : Set ℝ) := by
    ext x
    constructor
    · intro hx
      rcases hx with ⟨hx_not, hx_mem⟩
      have hx_le : x ≤ (2 : ℝ) := hx_mem.2
      have hx_ge : (2 : ℝ) ≤ x := by
        have hpos2 : 0 < Real.sqrt (2 : ℝ) := by
          have : (0 : ℝ) < (2 : ℝ) := by norm_num
          simpa using (Real.sqrt_pos.mpr this)
        have hposx : 0 < Real.sqrt x := by
          have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx_mem.1
          simpa using (Real.sqrt_pos.mpr hxpos)
        have hle : (1 : ℝ) / Real.sqrt x ≤ (1 : ℝ) / Real.sqrt (2 : ℝ) :=
          le_of_not_gt hx_not
        have h_sqrt : Real.sqrt (2 : ℝ) ≤ Real.sqrt x :=
          (one_div_le_one_div_iff hposx hpos2).mp hle
        have h_nonneg2 : (0 : ℝ) ≤ (2 : ℝ) := by norm_num
        have h_nonnegx : (0 : ℝ) ≤ x := le_trans (by norm_num) hx_mem.1
        exact Real.le_of_sqrt_le_sqrt h_nonneg2 h_nonnegx h_sqrt
      have : x = (2 : ℝ) := le_antisymm hx_le hx_ge
      simpa [this]
    · intro hx
      rcases Set.mem_singleton_iff.mp hx with rfl
      have : ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt (2 : ℝ)) := by
        simpa using not_lt.mpr (le_rfl)
      exact ⟨this, by
        exact ⟨by norm_num, by norm_num⟩⟩
  -- The bad set has measure zero because it is a singleton
  have h_meas :
      (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
        ({x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)}) = 0 := by
    have : (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))
            ({(2 : ℝ)} : Set ℝ) = 0 := by
      have hsub : ({(2 : ℝ)} : Set ℝ) ⊆ Set.Icc (1 : ℝ) 2 := by
        intro y hy
        have : y = (2 : ℝ) := by simpa using hy
        subst this
        exact ⟨by norm_num, by norm_num⟩
      simpa [Measure.restrict_apply, Set.inter_eq_self_of_subset_left hsub,
            MeasureTheory.volume_singleton]
    simpa [h_set] using this
  simpa using h_meas
