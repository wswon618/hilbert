import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_eq_algebra_sum1onsqrt2to1onsqrt10000lt198 :
    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = 198 := by
  -- rewrite the integrand as a power
  have h_fun :
      (fun x : ℝ => (1 : ℝ) / Real.sqrt x) = fun x => x ^ (-(1 / 2 : ℝ)) := by
    funext x
    simp [Real.sqrt_eq_rpow, one_div, Real.rpow_neg]
  -- evaluate the integral of the power using `integral_rpow`
  have h_int :
      (∫ x in (1 : ℝ)..10000, x ^ (-(1 / 2 : ℝ))) =
        (10000 ^ (1 / 2) - (1 : ℝ) ^ (1 / 2)) / (1 / 2) := by
    have h :=
      integral_rpow (a := (1 : ℝ)) (b := 10000) (r := (-(1 / 2 : ℝ)))
        (by norm_num) (by norm_num)
    simpa using h
  -- combine the rewrites and simplify
  calc
    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x)
        = ∫ x in (1 : ℝ)..10000, x ^ (-(1 / 2 : ℝ)) := by
          simpa [h_fun]
    _ = (10000 ^ (1 / 2) - (1 : ℝ) ^ (1 / 2)) / (1 / 2) := by
          simpa using h_int
    _ = (Real.sqrt 10000 - Real.sqrt (1 : ℝ)) / (1 / 2) := by
          simpa [← Real.sqrt_eq_rpow]
    _ = (100 - 1) / (1 / 2) := by
          have h100 : Real.sqrt (10000 : ℝ) = (100 : ℝ) := by
            have : (0 : ℝ) ≤ (100 : ℝ) := by norm_num
            simpa [pow_two] using (Real.sqrt_mul_self this)
          have h1 : Real.sqrt (1 : ℝ) = (1 : ℝ) := by
            simpa using Real.sqrt_one
          simp [h100, h1]
    _ = 198 := by norm_num
