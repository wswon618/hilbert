      have hcont_sqrt :
          ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
        (Real.continuous_sqrt).continuousOn
      have hne :
          ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
        intro x hx
        have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
        have hpos : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
        exact ne_of_gt hpos
