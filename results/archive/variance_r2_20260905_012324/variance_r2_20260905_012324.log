        ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa using (intervalIntegrable_one_div (fun x : ℝ => Real.sqrt x) h_ne)
  -- monotonicity of the interval integral
  have h_le :=
    intervalIntegral.integral_mono_on h_point h_int_const h_int_var
  simpa [ge_iff_le] using h_le
