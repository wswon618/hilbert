theorem hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (1 : ℝ) / Real.sqrt 2 <
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- Compute the integral explicitly.
  have h_int :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) = 2 * (Real.sqrt 2 - 1) := by
    simpa using
      integral_one_div_sqrt (by norm_num : (0 : ℝ) ≤ (1 : ℝ))
        (by norm_num : (1 : ℝ) ≤ (2 : ℝ))
  -- Show that `1 / √2` is smaller than this value.
  have h_sqrt : Real.sqrt 2 < (3 / 2 : ℝ) := by
    have hb : (0 : ℝ) ≤ (3 / 2) := by norm_num
    have hlt : (2 : ℝ) < (3 / 2) ^ 2 := by norm_num
    have := (Real.sqrt_lt (by norm_num : (0 : ℝ) ≤ 2) hb).2 hlt
    simpa using this
  have h2 : (2 : ℝ) * Real.sqrt 2 < 3 := by
    have := mul_lt_mul_of_pos_left h_sqrt (by norm_num : (0 : ℝ) < (2 : ℝ))
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using this
  have h3 : (1 : ℝ) < 4 - 2 * Real.sqrt 2 := by
    have : (2 : ℝ) * Real.sqrt 2 < 3 := h2
    have : -(2 * Real.sqrt 2) > -3 := (neg_lt_neg_iff).mpr this
    have : 4 + -(2 * Real.sqrt 2) > 4 + -3 := add_lt_add_left this 4
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc,
      mul_comm, mul_left_comm, mul_assoc] using this
  have h4 : (1 : ℝ) < 2 * (Real.sqrt 2 - 1) * Real.sqrt 2 := by
    have h_eq : 2 * (Real.sqrt 2 - 1) * Real.sqrt 2 = 4 - 2 * Real.sqrt 2 := by
      ring
    simpa [h_eq] using h3
  have h_lt : (1 : ℝ) / Real.sqrt 2 < 2 * (Real.sqrt 2 - 1) := by
    have hsqrt_pos : 0 < Real.sqrt 2 := by
      have : (0 : ℝ) < (2 : ℝ) := by norm_num
      exact Real.sqrt_pos.mpr this
    have := (div_lt_iff hsqrt_pos).mpr h4
    simpa [mul_comm, mul_left_comm, mul_assoc] using this
  simpa [h_int] using h_lt
