  -- evaluate the integral
  have h_int :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) = 2 * (Real.sqrt 2 - 1) := by
    simpa [Real.sqrt_one] using
      intervalIntegral.integral_one_div_sqrt (by norm_num) (by norm_num)
  -- show the integral is strictly larger than `1 / √2`
  have h_gt :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) > (1 : ℝ) / Real.sqrt 2 := by
    have hpos_sqrt : 0 < Real.sqrt (2 : ℝ) := by
      have : (0 : ℝ) < (2 : ℝ) := by norm_num
      exact Real.sqrt_pos.mpr this
    have hcalc :
        2 * (Real.sqrt 2 - 1) - (1 : ℝ) / Real.sqrt 2 =
          (Real.sqrt 2 - 1) ^ 2 / Real.sqrt 2 := by
      field_simp [Real.sqrt_mul_self (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
      ring
    have hpos_sq : 0 < (Real.sqrt 2 - 1) ^ 2 := by
      have hlt : (1 : ℝ) < Real.sqrt 2 := by norm_num
      have hpos : 0 < Real.sqrt 2 - 1 := sub_pos.mpr hlt
      have : 0 < (Real.sqrt 2 - 1) * (Real.sqrt 2 - 1) := mul_pos hpos hpos
      simpa [pow_two] using this
    have hpos : 0 < 2 * (Real.sqrt 2 - 1) - (1 : ℝ) / Real.sqrt 2 := by
      have : 0 < (Real.sqrt 2 - 1) ^ 2 / Real.sqrt 2 :=
        div_pos hpos_sq hpos_sqrt
      simpa [hcalc] using this
    have : 2 * (Real.sqrt 2 - 1) > (1 : ℝ) / Real.sqrt 2 := by
      linarith
    simpa [h_int] using this
  exact ne_of_gt h_gt
