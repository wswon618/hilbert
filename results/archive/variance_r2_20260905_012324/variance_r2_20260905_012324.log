  -- restrict the a.e. hypothesis from `Icc` to `Ioc`
  have h_strict_ae_Ioc :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Ioc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x) :=
    MeasureTheory.ae_restrict_of_ae_restrict_of_subset
      (by
        intro x hx
        exact ⟨le_of_lt hx.1, hx.2⟩) h_strict_ae
  -- strict inequality of the two integrals follows from the a.e. hypothesis
  have h_lt :
      (∫ x in Set.Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt 2) <
        ∫ x in Set.Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt x :=
    integral_lt_of_ae_lt h_strict_ae_Ioc
  -- evaluate the integral of the constant function
  have h_const :
      (∫ x in Set.Ioc (1 : ℝ) 2, (1 : ℝ) / Real.sqrt 2) = (1 : ℝ) / Real.sqrt 2 := by
    simpa [MeasureTheory.integral_const, volume_Ioc, smul_eq_mul]
  -- combine the equalities
  simpa [h_int_eq, h_const] using h_lt
