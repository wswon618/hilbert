theorem hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (1 : ℝ) / Real.sqrt 2 <
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  ------------------------------------------------------------
  -- 1.  Introduce the constant function  `c x = 1 / √2`.
  ------------------------------------------------------------
  let c : ℝ → ℝ := fun _ => (1 : ℝ) / Real.sqrt 2

  ------------------------------------------------------------
  -- 2.  Compute the integral of the constant function.
  ------------------------------------------------------------
  have h_int_const :
      ∫ x in (1 : ℝ)..2, c x = (1 : ℝ) / Real.sqrt 2 := by
    -- `intervalIntegral.integral_const` gives `∫ a..b, c = c * (b-a)`.
    simpa [c, intervalIntegral.integral_const, sub_self, sub_eq,
           one_div, mul_comm, mul_left_comm, mul_assoc] using
      (intervalIntegral.integral_const (a := (1 : ℝ)) (b := (2 : ℝ))
        (c := (1 : ℝ) / Real.sqrt 2))

  ------------------------------------------------------------
  -- 3.  Show that the constant function is ≤ the given function
  --    almost everywhere on the interval `[1,2]`.
  ------------------------------------------------------------
  have h_le_ae :
      (c ≤ᵐ[volume.restrict (Ioc (1 : ℝ) 2)]
          fun x => (1 : ℝ) / Real.sqrt x) := by
    refine Filter.eventually_of_forall ?_
    intro x hx
    rcases hx with ⟨hx1, hx2⟩
    have hxpos : (0 : ℝ) < x := by
      have : (1 : ℝ) ≤ x := le_of_lt hx1
      exact lt_of_lt_of_le zero_lt_one this
    have h_sqrt_le : Real.sqrt x ≤ Real.sqrt 2 := by
      exact Real.sqrt_le_sqrt (by exact le_of_lt hx1)
    have h_pos_sqrt2 : 0 < Real.sqrt 2 := by positivity
    have h_pos_sqrtx : 0 < Real.sqrt x := by
      exact Real.sqrt_pos.mpr hxpos
    -- because `sqrt` is increasing, `1/√2 ≤ 1/√x`.
    have : (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x :=
      (one_div_le_one_div_of_le h_pos_sqrt2 h_pos_sqrtx h_sqrt_le).symm
    simpa [c] using this

  ------------------------------------------------------------
  -- 4.  Show that the inequality is *strict* on a set of positive
  --    measure (the open interval `(1,2)`).
  ------------------------------------------------------------
  have h_lt_ae :
      (c <ᵐ[volume.restrict (Ioc (1 : ℝ) 2)]
          fun x => (1 : ℝ) / Real.sqrt x) := by
    refine Filter.eventually_of_forall ?_
    intro x hx
    rcases hx with ⟨hx1, hx2⟩
    have hxlt : x < 2 := lt_of_le_of_ne hx2 (by
      intro h; have : (2 : ℝ) ≤ 1 := by simpa [h] using hx1; linarith)
    have hxpos : (0 : ℝ) < x := by
      have : (1 : ℝ) ≤ x := le_of_lt hx1
      exact lt_of_lt_of_le zero_lt_one this
    have h_sqrt_lt : Real.sqrt x < Real.sqrt 2 :=
      Real.sqrt_lt_sqrt (by linarith)
    have h_pos_sqrt2 : 0 < Real.sqrt 2 := by positivity
    have h_pos_sqrtx : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
    -- strict inequality after taking reciprocals
    have : (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x :=
      (one_div_lt_one_div_of_lt h_pos_sqrt2 h_pos_sqrtx h_sqrt_lt)
    simpa [c] using this

  ------------------------------------------------------------
  -- 5.  Apply the strict integral comparison lemma.
  ------------------------------------------------------------
  have h_int_strict :
      ∫ x in (1 : ℝ)..2, c x <
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x :=
    intervalIntegral.integral_lt_integral_of_lt_ae
      (μ := volume) (a := (1 : ℝ)) (b := 2) (f := c)
      (g := fun x => (1 : ℝ) / Real.sqrt x) h_le_ae h_lt_ae

  ------------------------------------------------------------
  -- 6.  Combine the computation of the constant integral with the
  --    strict inequality to obtain the desired result.
  ------------------------------------------------------------
  have : (1 : ℝ) / Real.sqrt 2 < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    simpa [h_int_const] using h_int_strict
  exact this
```

**Explanation of the proof**

1. We introduce the constant function `c x = 1/√2`.  
2. The integral of a constant over `[1,2]` is just the constant itself, because the length of the interval is `1`. This is obtained with `intervalIntegral.integral_const`.  
3. Using the fact that `sqrt` is monotone, we show that `c x ≤ 1/√x` for every `x ∈ (1,2]`. Hence the inequality holds *almost everywhere* on the interval, expressed by `h_le_ae`.  
4. The inequality is strict on the open sub‑interval `(1,2)`, which has positive Lebesgue measure. This gives `h_lt_ae`.  
5. The lemma `intervalIntegral.integral_lt_integral_of_lt_ae` states that if `f ≤ g` a.e. and `f < g` on a set of positive measure, then the integral of `f` is strictly less than the integral of `g`. Applying it with `f = c` and `g = 1/√·` yields `h_int_strict`.  
6. Finally we replace the left‑hand integral by its value computed in step 2, obtaining the desired strict inequality.

Thus we have proved  

\[
\frac{1}{\sqrt{2}} \;<\;
\int_{1}^{2}\frac{dx}{\sqrt{x}} .
\]
