          have hx_sqrt_pos : 0 < Real.sqrt x := (Real.sqrt_pos.mpr hx_pos)
          have h2_sqrt_pos : 0 < Real.sqrt (2 : ℝ) := by norm_num [Real.sqrt_pos]
          have : Real.sqrt x = Real.sqrt (2 : ℝ) := by
            have := congrArg (fun y : ℝ => y * (Real.sqrt x * Real.sqrt (2 : ℝ))) hx_eq
            field_simp [hx_sqrt_pos.ne', h2_sqrt_pos.ne'] at this
            simpa using this
          exact Real.sqrt_eq_iff_mul_self_eq.1
            (by
              have : (Real.sqrt x) ^ 2 = (Real.sqrt (2 : ℝ)) ^ 2 := by simpa [this]
              simpa [Real.mul_self_sqrt (by linarith),
                     Real.mul_self_sqrt (by norm_num)] using this)
        simpa [hx_eq']
      · intro hx
        rcases hx with rfl
        have : (1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt 2 := lt_irrefl _
        exact this.elim
    -- Measure of `{2}` inside the restricted measure is `0`.
    have h_singleton :
        (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)) {2} = 0 := by
      simpa using
        (MeasureTheory.Measure.restrict_singleton' (μ := MeasureTheory.volume) (a := (2 : ℝ)))
    -- Rewrite the left–hand side using `restrict_apply` and the description of the set.
    simpa [Measure.restrict_apply, h_set] using h_singleton
  exact h_null
