```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_ge_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_le_ae :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≥
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) := by
  -- turn the pointwise inequality into a non‑negativity statement
  have h_nonneg :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
          (0 : ℝ) ≤ (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt (2 : ℝ)) :=
    h_le_ae.mono (by
      intro x hx
      exact sub_nonneg.mpr hx)
  -- apply the non‑negativity of the integral of a non‑negative a.e. function
  have h_int_nonneg :
      (0 : ℝ) ≤
        ∫ x in (1 : ℝ)..2,
          (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt (2 : ℝ) :=
    intervalIntegral.integral_nonneg_of_ae_restrict
      (by norm_num : (1 : ℝ) ≤ 2) h_nonneg
  -- continuity of the variable integrand, needed for integrability
  have hcont :
      ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
    have h_const : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Set.Icc (1 : ℝ) 2) :=
      continuousOn_const
    have h_sqrt : ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
      (Real.continuous_sqrt).continuousOn
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
