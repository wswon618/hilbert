by
  -- turn the a.e. hypothesis into one that lives on `Ioc`
  have h_le_ae' :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Ioc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x) :=
    (ae_restrict_of_ae_restrict_subset
        (by
          intro x hx
          exact Set.Ioc_subset_Icc_self hx)) h_le_ae
  -- integrability of the constant function
  have h_int_const :
      IntegrableOn (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2)
        (Set.Ioc (1 : ℝ) 2) :=
    (intervalIntegrable_const).integrableOn
  -- integrability of the variable function
  have h_int_var :
      IntegrableOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x)
        (Set.Ioc (1 : ℝ) 2) := by
    have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
      have hsqrt : (0 : ℝ) < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt hsqrt
    have h_int :
        IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x)
          (MeasureTheory.volume) 1 2 := by
      simpa using
        (intervalIntegrable_one_div (fun x : ℝ => Real.sqrt x) h_ne)
    exact h_int.integrableOn
  -- monotonicity of the integral
  have h_le :=
    integral_le_integral_of_le_ae h_int_const h_int_var h_le_ae'
  simpa [ge_iff_le] using h_le
