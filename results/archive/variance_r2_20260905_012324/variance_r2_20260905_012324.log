by
  -- First we turn the antitone hypothesis into a pointwise inequality on the interval.
  have hle :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    rcases hx with ⟨hx₁, hx₂⟩
    have h2mem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) 10000 := by
      constructor <;> norm_num
    have := h_antitone hx₁ h2mem hx₂
    simpa using this
  have hle_ae :
      ∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    refine (ae_restrict_iff.2 ?_)
    intro x hx
    exact hle x hx
  -- The equality can only happen at `x = 2`; a singleton has zero volume.
