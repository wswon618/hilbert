          (1 : ℝ) / Real.sqrt (1 + (i + 1))) = (1 : ℝ) / Real.sqrt 2 := by
    simp
  -- pointwise bound obtained from the antitone hypothesis
  have h_point :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hx_mem : x ∈ Set.Icc (1 : ℝ) (10000 : ℝ) := by
      rcases hx with ⟨h1, h2⟩
      exact ⟨h1, le_trans h2 (by norm_num : (2 : ℝ) ≤ 10000)⟩
    have h2_mem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) (10000 : ℝ) := by
      constructor <;> norm_num
    -- use antitone: from `x ≤ 2` we get `f 2 ≤ f x`
    exact h_antitone hx_mem h2_mem hx.2
  -- integrability of the constant function
  have h_int_const :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2) volume 1 2 := by
    simpa using
      (intervalIntegrable_const (a := (1 : ℝ)) (b := (2 : ℝ))
        (c := (1 : ℝ) / Real.sqrt 2))
  -- integrability of the decreasing function
  have h_int_f :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 := by
    have h_cont :
        ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
      have h_cont' :
          Continuous (fun x : ℝ => (1 : ℝ) / Real.sqrt x) := by
        simpa using (continuous_const.div (continuous_sqrt))
      exact h_cont'.continuousOn
    exact
      (ContinuousOn.intervalIntegrable_of_Icc (a := (1 : ℝ)) (b := (2 : ℝ))
        (h := by norm_num) h_cont)
  -- integral inequality coming from the pointwise bound
  have h_int_ineq :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) ≤
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    apply integral_le_integral_of_le (a := (1 : ℝ)) (b := (2 : ℝ))
      (hab := by norm_num)
    · intro x hx
      exact h_point x hx
    · exact h_int_const
    · exact h_int_f
  -- evaluate the left‑hand integral (constant function)
  have h_left :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) = (1 : ℝ) / Real.sqrt 2 := by
    simp
  -- finish the proof
  simpa [h_sum, h_left] using h_int_ineq
