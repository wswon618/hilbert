```lean4 
import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≠ (1 : ℝ) / Real.sqrt 2 := by
  -- 1.  Compute the integral using the antiderivative `x ↦ 2 * √x`.
  have h_int :
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x = 2 * Real.sqrt 2 - 2 := by
    -- derivative of `x ↦ 2 * √x`
    have hderiv :
        ∀ x ∈ Set.uIcc (1 : ℝ) 2,
          HasDerivAt (fun y => (2 : ℝ) * Real.sqrt y) (1 / Real.sqrt x) x := by
      intro x hx
      have hx0 : x ≠ 0 := by
        have : (0 : ℝ) < x := by
          have : (1 : ℝ) ≤ x := hx.1
          linarith
        exact ne_of_gt this
      simpa [two_mul, mul_comm, mul_left_comm, mul_assoc] using
        (Real.hasDerivAt_sqrt hx0).const_mul (2 : ℝ)
    -- continuity of the integrand, hence integrability
    have hint :
        IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 := by
      have hcont :
          ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
        have h_sqrt :
            ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
          (continuous_sqrt).continuousOn
        have h_ne :
            ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
          intro x hx
          have : (0 : ℝ) < x := by linarith [hx.1]
          have : (0 : ℝ) < Real.sqrt x := Real.sqrt_pos.mpr this
          exact ne_of_gt this
        exact h_sqrt.inv₀ h_ne
      exact (intervalIntegrable_iff_integrableOn_Icc).2 (hcont.integrableOn)
    simpa [two_mul] using
      (intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint)
  -- 2.  Show that `2 * √2 - 2` is different from `1 / √2`.
  have h_ne_expr :
      (2 * Real.sqrt 2 - 2) ≠ (1 : ℝ) / Real.sqrt 2 := by
    intro h_eq
    have h_sqrt : Real.sqrt 2 = (3 / 2 : ℝ) := by
      have h0 : Real.sqrt 2 ≠ 0 :=
        (Real.sqrt_ne_zero).mpr (by norm_num : (0 : ℝ) < (2 : ℝ))
      have : (2 * Real.sqrt 2 - 2) * Real.sqrt 2 = (1 : ℝ) := by
        simpa [h_eq] using congrArg (fun t => t * Real.sqrt 2) h_eq
      field_simp [h0] at this
      -- now we have `4 - 2 * Real.sqrt 2 = 1`
      have : (4 : ℝ) - 2 * Real.sqrt 2 = (1 : ℝ) := by
        simpa [pow_two, mul_comm, mul_left_comm, mul_assoc] using this
      linarith
    have h_sq :
        (Real.sqrt 2) ^ 2 = (3 / 2 : ℝ) ^ 2 := by
      simpa [pow_two] using congrArg (fun t : ℝ => t ^ 2) h_sqrt
    have h_false : (2 : ℝ) = (9 / 4 : ℝ) := by
      simpa [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ (2 : ℝ))] using h_sq
    have : (2 : ℝ) ≠ (9 / 4 : ℝ) := by norm_num
    exact this h_false
  -- 3.  Transfer the inequality to the original integral.
  intro h_eq
  apply h_ne_expr
  simpa [h_int] using h_eq
