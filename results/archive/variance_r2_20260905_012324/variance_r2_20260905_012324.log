import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≠ (1 : ℝ) / Real.sqrt 2 := by
  -- evaluate the integral explicitly
  have h_int :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) = 2 * Real.sqrt 2 - 2 := by
    simpa using intervalIntegral.integral_one_div_sqrt (by norm_num) (by norm_num)
  -- show the obtained value is different from `1 / √2`
  have h_ne : (2 * Real.sqrt 2 - 2) ≠ (1 : ℝ) / Real.sqrt 2 := by
    intro h_eq
    -- multiply the equality by `√2` (which is non‑zero)
    have h_mul :
        ((2 * Real.sqrt 2 - 2) * Real.sqrt 2) = (4 - 2 * Real.sqrt 2) := by
      ring
    have h_mul₂ :
        ((1 : ℝ) / Real.sqrt 2) * Real.sqrt 2 = (1 : ℝ) := by
      field_simp
    have h_eq' : 4 - 2 * Real.sqrt 2 = (1 : ℝ) := by
      have := congrArg (fun t : ℝ => t * Real.sqrt 2) h_eq
      simpa [h_mul, h_mul₂] using this
    have h_eq'' : (2 : ℝ) * Real.sqrt 2 = 3 := by
      linarith
    have h_eq''' : Real.sqrt 2 = (3 : ℝ) / 2 := by
      have := h_eq''
      field_simp at this
      simpa using this
    have h_sq : (Real.sqrt (2 : ℝ)) ^ 2 = ((3 : ℝ) / 2) ^ 2 := by
      simpa using congrArg (fun t : ℝ => t ^ 2) h_eq'''
    have h_contra : (2 : ℝ) = (9 : ℝ) / 4 := by
      simpa [Real.sq_sqrt (by positivity : (0 : ℝ) ≤ (2 : ℝ))] using h_sq
    have : (2 : ℝ) ≠ (9 : ℝ) / 4 := by norm_num
    exact this h_contra
  simpa [h_int] using h_ne
