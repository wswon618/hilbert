import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_eq_algebra_sum1onsqrt2to1onsqrt10000lt198 :
    (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) = 198 := by
  -- derivative of `λ y, 2 * sqrt y` is `1 / sqrt x`
  have h_deriv :
      ∀ x ∈ Ioo (1 : ℝ) 10000,
        HasDerivAt (fun y => (2 : ℝ) * Real.sqrt y) (1 / Real.sqrt x) x := by
    intro x hx
    have hx0 : x ≠ 0 := by
      have : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1.le
        have : (0 : ℝ) < (1 : ℝ) := by norm_num
        exact lt_of_lt_of_le this this
      exact ne_of_gt this
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      (Real.hasDerivAt_sqrt hx0).const_mul (2 : ℝ)
  -- continuity of the antiderivative on the closed interval
  have h_cont :
      ContinuousOn (fun y : ℝ => (2 : ℝ) * Real.sqrt y) (Icc (1 : ℝ) 10000) :=
    (continuous_const.mul continuous_sqrt).continuousOn
  -- integrability of the derivative on the interval
  have h_int :
      IntervalIntegrable (fun y : ℝ => (1 : ℝ) / Real.sqrt y) volume (1 : ℝ) 10000 := by
    have h_ne :
        ∀ x ∈ Icc (1 : ℝ) 10000, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (1 : ℝ) ≤ x := hx.1
        have : (0 : ℝ) < (1 : ℝ) := by norm_num
        exact lt_of_lt_of_le this this
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    have h_cont_sqrt :
        ContinuousOn (fun x : ℝ => Real.sqrt x) (Icc (1 : ℝ) 10000) :=
      (continuous_sqrt).continuousOn
    simpa using (intervalIntegrable_one_div h_ne h_cont_sqrt)
  -- apply the fundamental theorem of calculus
  have h_eq :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le
      (by norm_num : (1 : ℝ) ≤ 10000)
      h_cont
      h_deriv
      h_int
  -- simplify the right‑hand side
  have : (∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x) =
        (2 * Real.sqrt 10000 - 2 * Real.sqrt 1) := by
    simpa using h_eq
  simpa [Real.sqrt_mul_self (by norm_num : (0 : ℝ) ≤ (10000 : ℝ)),
        Real.sqrt_one, mul_comm, mul_left_comm, mul_assoc] using this
