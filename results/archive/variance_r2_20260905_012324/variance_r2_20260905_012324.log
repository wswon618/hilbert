    (1 : ℝ) / Real.sqrt 2 <
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
  -- restrict antitone property to the smaller interval [1,2]
  have h_antitone' :
      AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
    h_antitone.mono (by
      intro x hx
      exact ⟨hx.1, le_trans hx.2 (by norm_num)⟩)
  -- interval integrability of the two functions
  have h_int_f :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 :=
    h_antitone'.intervalIntegrable
  have h_int_const :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2) volume 1 2 :=
    intervalIntegrable_const
  have h_int_sub :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt 2)
        volume 1 2 :=
    h_int_f.sub h_int_const
  -- positivity of the integrand on the open interval (1,2)
  have h_pos :
      ∀ x : ℝ, x ∈ Ioo (1 : ℝ) 2 → 0 < (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt 2 := by
    intro x hx
    have hxpos : 0 < Real.sqrt x :=
      Real.sqrt_pos.mpr (lt_of_lt_of_le (by norm_num) hx.1)
    have hxsqrt_lt : Real.sqrt x < Real.sqrt 2 :=
      Real.sqrt_lt_sqrt (by
        have : (0 : ℝ) ≤ x := le_of_lt hx.1
        exact hx.2)
    have hlt :
        (1 / Real.sqrt 2) < (1 / Real.sqrt x) := by
      have := one_div_lt_one_div_of_lt hxpos hxsqrt_lt
      simpa [one_div] using this
    exact sub_pos.mpr hlt
  have hpos_int :
      0 < ∫ x in (1 : ℝ)..2,
        ( (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt 2) := by
    have hab : (1 : ℝ) < 2 := by norm_num
    exact intervalIntegral.intervalIntegral_pos_of_pos_on h_int_sub h_pos hab
  -- rewrite the integral of the difference
  have hrew :
      ∫ x in (1 : ℝ)..2,
        ( (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt 2) =
        ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x -
          ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2 := by
    simpa using intervalIntegral.integral_sub (fun x => (1 : ℝ) / Real.sqrt x)
                                            (fun _ => (1 : ℝ) / Real.sqrt 2)
  have hrew' :
      ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt 2 := by
    simpa [intervalIntegral.integral_const, sub_eq, one_mul, mul_comm] using
      (by rfl : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) =
                (2 - 1) * (1 / Real.sqrt 2))
  have hlt : (1 : ℝ) / Real.sqrt 2 < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    have : 0 < ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x -
