import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_ge_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_le_ae :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≥
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) := by
  -- turn the pointwise inequality into a non‑negativity statement
  have h_nonneg :
      (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
          (0 : ℝ) ≤ (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt (2 : ℝ)) :=
    h_le_ae.mono (by
      intro x hx
      exact sub_nonneg.mpr hx)
  -- apply the non‑negativity of the integral of a non‑negative a.e. function
  have h_int_nonneg :
      (0 : ℝ) ≤
        ∫ x in (1 : ℝ)..2,
          (1 : ℝ) / Real.sqrt x - (1 : ℝ) / Real.sqrt (2 : ℝ) :=
    intervalIntegral.integral_nonneg_of_ae_restrict
      (by norm_num : (1 : ℝ) ≤ 2) h_nonneg
  -- integrability of the two functions appearing in the difference
  have hf :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) MeasureTheory.volume 1 2 := by
    have hcont :
        ContinuousOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2) := by
      have h_const : ContinuousOn (fun _ : ℝ => (1 : ℝ)) (Set.Icc (1 : ℝ) 2) :=
        continuousOn_const
      have h_sqrt : ContinuousOn (fun x : ℝ => Real.sqrt x) (Set.Icc (1 : ℝ) 2) :=
        (Real.continuous_sqrt).continuousOn
      have h_ne : ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
        intro x hx
        have hxpos : (0 : ℝ) < x := by
          have : (1 : ℝ) ≤ x := hx.1
          exact lt_of_lt_of_le (by norm_num) this
        have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
        exact ne_of_gt this
      simpa [one_div] using h_const.div h_sqrt h_ne
    exact hcont.intervalIntegrable
  have hg :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt (2 : ℝ)) MeasureTheory.volume 1 2 :=
    intervalIntegral.intervalIntegrable_const _
  -- rewrite the integral of a difference and turn `0 ≤ A - B` into `B ≤ A`
  have : (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) ≤
          ∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x := by
    have h :
        (0 : ℝ) ≤
          (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) -
          (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt (2 : ℝ)) := by
      simpa [intervalIntegral.integral_sub hf hg,
             intervalIntegral.integral_const] using h_int_nonneg
    exact sub_nonneg.mp h
  exact this
