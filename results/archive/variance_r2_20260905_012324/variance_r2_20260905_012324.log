  have h_int :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt
      (a := (1 : ℝ)) (b := 10000)
      (F := fun y => (2 : ℝ) * Real.sqrt y)
      (f := fun x => (1 : ℝ) / Real.sqrt x) hderiv
  -- Compute the antiderivative at the endpoints.
  have h_val : (2 * Real.sqrt (10000 : ℝ) - 2 * Real.sqrt (1 : ℝ)) = (198 : ℝ) := by
    norm_num
  simpa [h_val] using h_int
