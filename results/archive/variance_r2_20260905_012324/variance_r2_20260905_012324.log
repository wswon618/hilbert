by
  -- rewrite the interval integral as an integral with respect to a restricted measure
  have h_int_eq :
      (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) =
        ∫ x, (1 : ℝ) / Real.sqrt x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)) := by
    simpa [intervalIntegral.integral_of_le (by norm_num : (1 : ℝ) ≤ 2)]
      using rfl
  -- compute the integral of the constant function `1 / √2`
  have h_const :
      (∫ x, (1 : ℝ) / Real.sqrt 2 ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))) =
        (1 : ℝ) / Real.sqrt 2 := by
    simpa [MeasureTheory.integral_const,
      (by
        have : (MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)) Set.univ = (1 : ℝ) := by
          simp
        exact this)] using rfl
  -- use the a.e. strict inequality to get a strict inequality of integrals
  have h_lt :
      (∫ x, (1 : ℝ) / Real.sqrt 2 ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))) <
        ∫ x, (1 : ℝ) / Real.sqrt x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2))) :=
    (MeasureTheory.integral_lt_of_ae_lt h_strict_ae)
  -- combine the previous equalities
  simpa [h_int_eq, h_const] using h_lt
