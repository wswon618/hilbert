    (intervalIntegral.integral_add_adjacent
        (a := (1 : ℝ)) (b := (2 : ℝ)) (c := (10000 : ℝ))
        (f := fun x => (1 : ℝ) / Real.sqrt x)
        (by norm_num) (by norm_num)).symm
```
