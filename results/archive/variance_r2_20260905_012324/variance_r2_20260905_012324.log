import Mathlib
import Aesop

set_option maxHeartbeats 0

open BigOperators Real Nat Topology Rat

theorem h_integral_ge_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
  (h_le_ae :
    (∀ᵐ x ∂(MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)),
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x)) :
    (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt x) ≥
        (∫ x in (1 : ℝ)..2, (1 : ℝ) / Real.sqrt 2) := by
  -- pointwise inequality on the closed interval
  have h_point :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hx0 : (0 : ℝ) ≤ x := le_trans (by norm_num) hx.1
    have h_sqrt_le : Real.sqrt x ≤ Real.sqrt (2 : ℝ) :=
      Real.sqrt_le_sqrt hx0 hx.2
    have hposx : 0 < Real.sqrt x :=
      Real.sqrt_pos.mpr (lt_of_lt_of_le (by norm_num) hx.1)
    have := one_div_le_one_div_of_le hposx h_sqrt_le
    simpa [one_div] using this
  -- integrability of the constant function
  have h_int_const :
      IntervalIntegrable (fun _ : ℝ => (1 : ℝ) / Real.sqrt 2)
        MeasureTheory.volume 1 2 := by
    simpa using intervalIntegrable_const
  -- integrability of the variable function
  have h_int_var :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x)
        MeasureTheory.volume 1 2 := by
    have h_ne :
        ∀ x ∈ Set.Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa using (intervalIntegrable_one_div (fun x : ℝ => Real.sqrt x) h_ne)
  -- monotonicity of the interval integral
  have h_le :=
    intervalIntegral.integral_mono_on h_point h_int_const h_int_var
  simpa [ge_iff_le] using h_le
