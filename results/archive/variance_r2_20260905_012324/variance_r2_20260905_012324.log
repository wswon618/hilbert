theorem hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 10000)) :
    (∑ k in Finset.Icc (2 : ℕ) 10000, (1 : ℝ) / Real.sqrt k) ≠
      ∫ x in (1 : ℝ)..10000, (1 : ℝ) / Real.sqrt x := by
  classical
  -- auxiliary notation
  set f : ℝ → ℝ := fun x => (1 : ℝ) / Real.sqrt x
  have hle_sum_int :
      (∑ k in Finset.Icc (2 : ℕ) 10000, f k) ≤
        ∫ x in (1 : ℝ)..10000, f x := by
    have hab : (1 : ℕ) ≤ 10000 := by decide
    simpa [Finset.Icc_eq_Ico_succ_left, f] using
      (AntitoneOn.sum_le_integral_Ico (a := (1 : ℕ)) (b := 10000) hab h_antitone)
  have hlt_int_sum :
      (∫ x in (1 : ℝ)..10000, f x) <
        (∑ k in Finset.Icc (1 : ℕ) 9999, f k) := by
    have hab : (1 : ℕ) ≤ 10000 := by decide
    simpa [Finset.Icc_eq_Ico_succ_left, f] using
      (AntitoneOn.integral_le_sum_Ico (a := (1 : ℕ)) (b := 10000) hab h_antitone)
  have hlt_sum : (∑ k in Finset.Icc (2 : ℕ) 10000, f k) <
        (∑ k in Finset.Icc (1 : ℕ) 9999, f k) := by
    have h_one : f (1 : ℝ) = (1 : ℝ) := by simp [f]
    have h_ten_thousand : f (10000 : ℝ) = (1 : ℝ) / (100 : ℝ) := by
      have : Real.sqrt (10000 : ℝ) = (100 : ℝ) := by norm_num
      simpa [f, this]
    have hpos : f (1 : ℝ) > f (10000 : ℝ) := by
      simpa [h_one, h_ten_thousand] using (by norm_num : (1 : ℝ) > (1 : ℝ) / (100 : ℝ))
    have hsum_eq :
        (∑ k in Finset.Icc (1 : ℕ) 9999, f k) =
          f (1 : ℝ) + ∑ k in Finset.Icc (2 : ℕ) 9999, f k := by
      simpa [Finset.sum_Icc_succ_top, f] using
        (Finset.sum_Icc_succ_top (a := (1 : ℕ)) (b := 9998) (f := fun k => f k))
    have hsum_eq' :
        (∑ k in Finset.Icc (2 : ℕ) 10000, f k) =
          ∑ k in Finset.Icc (2 : ℕ) 9999, f k + f (10000 : ℝ) := by
      simpa [Finset.sum_Icc_succ_top, f] using
        (Finset.sum_Icc_succ_top (a := (2 : ℕ)) (b := 9999) (f := fun k => f k))
    have : (∑ k in Finset.Icc (2 : ℕ) 10000, f k) <
          (∑ k in Finset.Icc (2 : ℕ) 9999, f k) + f (1 : ℝ) := by
      have : f (1 : ℝ) = f (1 : ℝ) := rfl
      linarith [hpos]
    have : (∑ k in Finset.Icc (2 : ℕ) 10000, f k) <
          (∑ k in Finset.Icc (2 : ℕ) 9999, f k) + f (10000 : ℝ) + (f (1 : ℝ) - f (10000 : ℝ)) :=
        by linarith [hpos]
    simpa [hsum_eq', add_comm, add_left_comm, add_assoc, sub_eq_add_neg] using this
  have hneq : (∑ k in Finset.Icc (2 : ℕ) 10000, f k) ≠
