open BigOperators Real Nat Topology Rat

theorem h_int_gt_h_ne_hlt_one_two_hne_h_strict_algebra_sum1onsqrt2to1onsqrt10000lt198
    (h_antitone_sub :
        AntitoneOn (fun x : ℝ => (1 : ℝ) / Real.sqrt x) (Set.Icc (1 : ℝ) 2))
    (h_not_const :
        ∃ x ∈ Set.Icc (1 : ℝ) 2,
