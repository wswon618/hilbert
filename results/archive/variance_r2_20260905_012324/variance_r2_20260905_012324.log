by
  -- Shortcut for the restricted Lebesgue measure on `[1,2]`.
  let μ := MeasureTheory.volume.restrict (Set.Icc (1 : ℝ) 2)

  -- Pointwise (non‑strict) inequality on the whole interval `[1,2]`.
  have h_le_all :
      ∀ x ∈ Set.Icc (1 : ℝ) 2,
        (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x := by
    intro x hx
    have hxI : x ∈ Set.Icc (1 : ℝ) 10000 :=
      ⟨hx.1, le_trans hx.2 (by norm_num)⟩
    have h2I : (2 : ℝ) ∈ Set.Icc (1 : ℝ) 10000 := by norm_num
    have := h_antitone hxI h2I hx.2
    simpa using this

  -- The set where equality holds is contained in the singleton `{2}`.
  have h_eq_null :
      μ {x | (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x} = 0 := by
    have hsubset :
        {x | (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x} ⊆ ({2} : Set ℝ) := by
      intro x hx
      have hx_eq : (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x := hx
      have hpos2 : (0 : ℝ) < Real.sqrt (2 : ℝ) := Real.sqrt_pos.2 (by norm_num)
      have hxpos : (0 : ℝ) < Real.sqrt x := by
        have : (0 : ℝ) < x := lt_of_lt_of_le (by norm_num) hx.1
        exact Real.sqrt_pos.2 this
      have h_eq_sqrt :
          Real.sqrt (2 : ℝ) = Real.sqrt x := by
        have hne2 : Real.sqrt (2 : ℝ) ≠ 0 := ne_of_gt hpos2
        have hne_x : Real.sqrt x ≠ 0 := ne_of_gt hxpos
        have : (Real.sqrt (2 : ℝ))⁻¹ = (Real.sqrt x)⁻¹ := by
          simpa [one_div] using hx_eq
        exact (inv_eq_iff_eq_inv hne2 hne_x).1 this
      have : x = (2 : ℝ) := by
        have := congrArg (fun y : ℝ => y ^ 2) h_eq_sqrt
        simpa [Real.sq_sqrt hx.1, Real.sq_sqrt (by norm_num)] using this
      simpa [Set.mem_singleton_iff] using this
    have hsingleton : μ ({2} : Set ℝ) = 0 := by
      have hmem : (2 : ℝ) ∈ Set.Icc (1 : ℝ) 2 := by norm_num
      simpa [μ, Measure.restrict_apply, Set.inter_singleton_eq_self, hmem,
            Real.volume_singleton] using (Real.volume_singleton (a := (2 : ℝ)))
    exact measure_mono_null hsubset hsingleton

  -- The set where the strict inequality fails is contained in the equality set,
  -- hence it has measure zero.
  have h_not_lt_null :
      μ {x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} = 0 := by
    -- rewrite the set under `μ` as an intersection with the interval
    have hsubset :
        ({x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} ∩
          Set.Icc (1 : ℝ) 2) ⊆
        {x | (1 : ℝ) / Real.sqrt 2 = (1 : ℝ) / Real.sqrt x} := by
      intro x hx
      rcases hx with ⟨hx_not, hxI⟩
      have hle : (1 : ℝ) / Real.sqrt 2 ≤ (1 : ℝ) / Real.sqrt x :=
        h_le_all x hxI
      have hge : (1 : ℝ) / Real.sqrt x ≤ (1 : ℝ) / Real.sqrt 2 := by
        have htotal := le_total ((1 : ℝ) / Real.sqrt x) ((1 : ℝ) / Real.sqrt 2)
        rcases htotal with hge | hlt
        · exact hge
        · exfalso; exact hx_not hlt
      exact le_antisymm hle hge
    have : μ ({x | ¬ ((1 : ℝ) / Real.sqrt 2 < (1 : ℝ) / Real.sqrt x)} ∩
                Set.Icc (1 : ℝ) 2) = 0 :=
      measure_mono_null hsubset h_eq_null
