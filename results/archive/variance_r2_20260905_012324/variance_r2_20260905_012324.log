    have hpos2 : 0 < Real.sqrt (2 : ℝ) := (Real.sqrt_pos.mpr (by norm_num))
    have hlt_sqrt : Real.sqrt x < Real.sqrt (2 : ℝ) := by
      have hxnonneg : (0 : ℝ) ≤ x := le_of_lt hxpos
