        ∀ x ∈ Icc (1 : ℝ) 2, Real.sqrt x ≠ 0 := by
      intro x hx
      have hxpos : (0 : ℝ) < x := by
        have : (0 : ℝ) < (1 : ℝ) := by norm_num
        exact lt_of_lt_of_le this hx.1
      have : 0 < Real.sqrt x := Real.sqrt_pos.mpr hxpos
      exact ne_of_gt this
    simpa [one_div] using h_num.div h_den h_den_ne
  -- integrability follows from continuity on a compact interval
  have h_int :
      IntervalIntegrable (fun x : ℝ => (1 : ℝ) / Real.sqrt x) volume 1 2 :=
    intervalIntegrable_of_continuousOn (a:=1) (b:=2) (μ:=volume) h_cont (by norm_num)
  simpa using h_int
